// fixture สำหรับ S2 — จงใจให้ schema ไม่ตรงกับ migration ที่มีอยู่ (drift)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  role      Role     @default(MEMBER) // <- field นี้ยังไม่มีใน migration 0001
  createdAt DateTime @default(now())
  orders    Order[]
}

model Order {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  total     Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())
}

enum Role {
  ADMIN
  MEMBER
}
