---
// แผนผังการไหลของข้อมูลแบบ CONSORT สำหรับการทดลองหนึ่งชุด ทุกค่าจาก numbers.json ของชุดนั้น
import { type Study } from '../lib/data';
import { armT, studyT, type Lang } from '../lib/i18n';
interface Props { st: Study; n: number; lang?: Lang }
const { n, lang = 'th' } = Astro.props;
const en = lang === 'en';
const st = studyT(lang, Astro.props.st);
const a = st.nums.allocation;
const note = (st as { repsNote?: string }).repsNote;
const planned = note ? note : st.fallback
  ? (en ? `planned ${st.fallback.from} repetitions, used ${st.fallback.to} under the fallback rule` : `แผนเดิม ${st.fallback.from} รอบ ใช้จริง ${st.fallback.to} รอบตามกฎสำรอง`)
  : (en ? `${st.reps} repetitions as planned` : `ตามแผน ${st.reps} รอบ`);
---
<figure class="fig-wide consort" aria-label={en ? `Flow of data in Study ${st.n}` : `แผนผังการไหลของข้อมูลชุดที่ ${st.n}`}>
  <div class="c-row"><div class="box">
    <b>{en ? `${a.scenarios} tasks × ${st.armIds.length} groups × ${st.reps} repetitions` : `${a.scenarios} โจทย์ × ${st.armIds.length} กลุ่ม × ${st.reps} รอบ`}</b>
    <span>{en ? `${a.declaredCells} runs (${planned})` : `${a.declaredCells} ครั้ง (${planned})`}</span>
  </div></div>
  <div class="c-arrow" aria-hidden="true"></div>
  <div class="c-row"><div class="box">
    <b>{en ? `${a.usableCells} complete runs (${(a.completeness * 100).toFixed(0)}%)` : `เก็บได้ครบ ${a.usableCells} ครั้ง (${(a.completeness * 100).toFixed(0)}%)`}</b>
    <span>{en
      ? `${a.structurallyExcluded} runs dropped because the system failed, ${st.nums.budgetExhausted.total} runs where the AI used up its step budget`
      : `ระบบล่มจนต้องตัดทิ้ง ${a.structurallyExcluded} ครั้ง AI ทำงานจนหมดโควตาขั้นตอน ${st.nums.budgetExhausted.total} ครั้ง`}</span>
  </div></div>
  <div class="c-arrow" aria-hidden="true"></div>
  <div class="c-row arms" style={`--k:${st.armIds.length}`}>
    {st.armIds.map((id) => (
      <div class={`box arm-box arm-${id}`}>
        <b><span class={`arm arm-${id}`}>{id}</span></b>
        <span>{armT(lang, id).short}</span>
        <span class="n">{st.nums.perArm[id].n} {en ? 'runs' : 'ครั้ง'}</span>
      </div>
    ))}
  </div>
  <div class="c-arrow" aria-hidden="true"></div>
  <div class="c-row"><div class="box unit">
    <b>{en ? `Compared task by task (${st.k} tasks)` : `เทียบกันทีละโจทย์ (${st.k} โจทย์)`}</b>
    <span>{en
      ? `The ${st.reps} repetitions of each task are averaged first, then we look at whether Skills scored more or less than the single file on the same task`
      : `เอาคะแนน ${st.reps} รอบของแต่ละโจทย์มาเฉลี่ย แล้วดูว่าในโจทย์เดียวกัน Skills ได้มากหรือน้อยกว่าไฟล์เดียว`}</span>
  </div></div>
  {en
    ? <figcaption><b>Figure {n}</b> Data in Study {st.n}, from the plan to the comparison</figcaption>
    : <figcaption><b>รูปที่ {n}</b> ข้อมูลของชุดที่ {st.n} ตั้งแต่วางแผนจนถึงตอนเทียบผล</figcaption>}
</figure>
<style>
  .consort { display: flex; flex-direction: column; align-items: stretch; }
  .c-row { display: flex; justify-content: center; gap: 0.75rem; }
  .box { border: 1.5px solid var(--ink); background: #fff; padding: 0.75rem 1rem; display: flex; flex-direction: column; gap: 0.15rem; max-width: 38rem; width: 100%; text-align: center; line-height: 1.5; }
  .box b { font-family: var(--serif); font-weight: 600; }
  .box span { font-size: 0.95rem; color: var(--ink-2); }
  .arms { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); max-width: 52rem; margin: 0 auto; width: 100%; }
  @media (min-width: 760px) { .arms { grid-template-columns: repeat(var(--k), minmax(0, 1fr)); } }
  .arm-box { border-top: 4px solid var(--c); }
  .arm-box .n { font-weight: 600; color: var(--ink); }
  .unit { border-color: var(--teal); }
  .c-arrow { height: 1.75rem; width: 1.5px; background: var(--ink); margin: 0 auto; position: relative; }
  .c-arrow::after { content: ''; position: absolute; bottom: -1px; left: -4px; border: 4.5px solid transparent; border-top: 6px solid var(--ink); border-bottom: 0; }
  figcaption { align-self: center; text-align: center; }
</style>
