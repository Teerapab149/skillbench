---
import '../styles/global.css';
import { studies } from '../lib/data';
interface Props { title: string; description?: string; current?: string }
const { title, description = 'เราทดลองสามรอบว่า ถ้าเขียนกฎให้ AI เขียนโค้ดแบบ Agent Skills กับแบบไฟล์เดียว AI จะทำตามกฎต่างกันไหม', current = '' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const nav: [string, string][] = [
  ['', 'หน้าแรก'],
  ['background/', 'เรื่องพื้นฐาน'],
  ['study-1/', 'ชุดที่ 1'],
  ['study-2/', 'ชุดที่ 2'],
  ['study-3/', 'ชุดที่ 3'],
  ['arms/', 'กลุ่มและกฎ'],
  ['scenarios/', 'โจทย์'],
  ['runs/', 'ทุกครั้งที่ทำงาน'],
  ['method/', 'วัดยังไง'],
  ['protocol/', 'แผนก่อนเริ่ม'],
];
const totalRuns = studies.reduce((s, st) => s + st.usable, 0);
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(`${base}og.png`, Astro.site).href;
---
<!doctype html>
<html lang="th">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="theme-color" content="#fdfdfb" />
<link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
<link rel="canonical" href={canonical} />
<meta property="og:type" content="website" />
<meta property="og:locale" content="th_TH" />
<meta property="og:site_name" content="SkillBench" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="เขียนกฎให้ AI แบบไหน AI ถึงจะทำตาม ผลการทดลองสามชุดของ SkillBench" />
<meta name="twitter:card" content="summary_large_image" />
</head>
<body>
<!-- THESIS: เว็บนี้คือรายงานงานวิจัยแบบวารสาร ไม่ใช่หน้า landing เล่าการทดลองทั้งสามชุดตามลำดับจริง ผลและระดับความแรงของผลมาก่อน ทุกตัวเลขตามไปถึง run ได้
OWN-WORLD: กระดาษขาว หมึกดำ ตารางเส้นบนหนาเส้นล่างบาง รูปมีเลขและคำบรรยาย forest plot และแผนผัง CONSORT หัวเรื่อง Noto Serif Thai เนื้อความ Sarabun เขียวหัวเป็ดคือผลหลัก ส้มอิฐคือเชิงสำรวจ
STORY: ผู้อ่านรู้ในจอแรกว่างานนี้ถามอะไรและได้คำตอบอะไร เห็นว่าทำไมต้องทดลองสามชุด แล้วเลือกเจาะชุดใดชุดหนึ่ง หรือดูกฎ โจทย์ และ run จริง
FIRST VIEWPORT: ชื่อเรื่อง คำถามหนึ่งประโยค คำตอบหนึ่งประโยค แล้วรูปผลหลักของสามชุดเรียงกัน
FORM: รายงานการทดลองทางคลินิก (IMPECCABLE'S PICK) seed a4d93d88
FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, DESIGN.md, and every shipping raster carrying its provenance -->
<a class="skip" href="#main">ข้ามไปเนื้อหา</a>
<header class="masthead">
  <div class="masthead-in">
    <a class="brand" href={base}>SkillBench</a>
    <nav class="nav" aria-label="หัวข้อหลัก">
      {nav.map(([href, label]) => <a href={base + href} aria-current={current === href ? 'page' : undefined}>{label}</a>)}
    </nav>
    <details class="mnav">
      <summary>{nav.find(([h]) => h === current)?.[1] ?? 'เมนู'}<span class="mnav-ico" aria-hidden="true"></span></summary>
      <nav aria-label="หัวข้อหลัก">
        {nav.map(([href, label]) => <a href={base + href} aria-current={current === href ? 'page' : undefined}>{label}</a>)}
      </nav>
    </details>
  </div>
</header>
<main id="main" class="page">
  <slot />
</main>
<footer class="footer">
  <div class="footer-in">
    <div>
      <p><strong>การควบคุมพฤติกรรม LLM Agent ในงานพัฒนาระบบด้วย Context Engineering และระบบทักษะเอเจนต์</strong></p>
      <p>ธีรภาพ บุญศรี และ ธีรภัทร์ ชินวุฒิวงศ์<br />
      อาจารย์ที่ปรึกษา ผศ. ดร.รุชดี บิลหมัด<br />
      รายวิชา 477-401 สัมมนาระบบสารสนเทศทางธุรกิจ คณะวิทยาการจัดการ มหาวิทยาลัยสงขลานครินทร์ ภาคเรียนที่ 1/2569</p>
    </div>
    <div>
      <p>ทดลองสามรอบ รวม {totalRuns} ครั้ง ด้วยโมเดล <span class="mono">{studies[2].model}</span></p>
      <p>ตัวเลขทุกตัวในเว็บดึงจากไฟล์ผลการทดลองโดยตรง เราไม่ได้พิมพ์เอง</p>
      <p><a href={`${base}skillbench-report.pdf`}>รายงานฉบับเต็ม (PDF)</a></p>
      <p><a href="https://github.com/Teerapab149/skillbench">โค้ดและข้อมูลทั้งหมดบน GitHub</a></p>
    </div>
  </div>
</footer>
</body>
</html>
