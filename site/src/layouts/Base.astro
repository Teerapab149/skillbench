---
import '../styles/global.css';
import { nums } from '../lib/data';
interface Props { title: string; description?: string; current?: string }
const { title, description = 'รายงานการทดลองว่าการเขียนกฎให้เอเจนต์เขียนโค้ดแบบ Agent Skills กับแบบไฟล์เดียว ทำให้เอเจนต์ทำตามกฎต่างกันหรือไม่', current = '' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const nav = [
  ['', 'บทความ'],
  ['method/', 'วิธีวิจัย'],
  ['arms/', 'กลุ่มทดลองและกฎ'],
  ['scenarios/', 'โจทย์ 22 ข้อ'],
  ['runs/', 'ทะเบียน 264 run'],
  ['protocol/', 'เอกสารแผน'],
];
---
<!doctype html>
<html lang="th">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="theme-color" content="#fdfdfb" />
<link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
</head>
<body>
<!-- THESIS: เว็บนี้คือรายงานการทดลองแบบวารสารการแพทย์ ไม่ใช่หน้า landing — ผลหลักและระดับความแรงของมันมาก่อน ทุกตัวเลขตามไปถึง run ได้
OWN-WORLD: กระดาษขาว หมึกดำ ตาราง booktabs เส้นบนหนาเส้นล่างบาง รูปมีเลขและคำบรรยาย forest plot และแผนผัง CONSORT · หัวเรื่อง Noto Serif Thai เนื้อความ Sarabun · เขียวหัวเป็ด = ผลหลัก ส้มอิฐ = เชิงสำรวจ
STORY: ผู้อ่านรู้ภายในจอแรกว่า Skills เทียบเท่าไฟล์เดียวตามเกณฑ์ที่ประกาศล่วงหน้า แล้วเลื่อนอ่านเหตุผล หรือกระโดดไปดูกฎ โจทย์ และ run จริง
FIRST VIEWPORT: ชื่อบทความแบบวารสาร ผู้เขียน การลงทะเบียนแผน แล้วบทคัดย่อแบบมีโครงสร้างที่มีคำตัดสินในกรอบ ตามด้วย forest plot
FORM: รายงานการทดลองทางคลินิก (IMPECCABLE'S PICK) · seed a4d93d88
FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, DESIGN.md, and every shipping raster carrying its provenance -->
<a class="skip" href="#main">ข้ามไปเนื้อหา</a>
<header class="masthead">
  <div class="masthead-in">
    <a class="brand" href={base}>SkillBench <span>· รายงานการทดลองชุดที่ 3</span></a>
    <nav class="nav" aria-label="หัวข้อหลัก">
      {nav.map(([href, label]) => <a href={base + href} aria-current={current === href ? 'page' : undefined}>{label}</a>)}
    </nav>
  </div>
</header>
<main id="main" class="page">
  <slot />
</main>
<footer class="footer">
  <div class="footer-in">
    <div>
      <p><strong>การควบคุมพฤติกรรม LLM Agent ในงานพัฒนาระบบด้วย Context Engineering และระบบทักษะเอเจนต์</strong><br />
      ธีรภาพ บุญศรี · ธีรภัทร์ ชินวุฒิวงศ์ · อาจารย์ที่ปรึกษา ผศ. ดร.รุชดี บิลหมัด<br />
      รายวิชา 477-401 สัมมนาระบบสารสนเทศทางธุรกิจ · คณะวิทยาการจัดการ มหาวิทยาลัยสงขลานครินทร์ · ภาคเรียนที่ 1/2569</p>
    </div>
    <div>
      <p>ตัวเลขทุกตัวในเว็บสร้างจากไฟล์ข้อมูลตอน build ไม่มีการพิมพ์ด้วยมือ<br />
      ชุดข้อมูล <span class="mono">{nums.stamp}</span> · โมเดล <span class="mono">{nums.model}</span><br />
      <a href="https://github.com/Teerapab149/skillbench">โค้ดและข้อมูลทั้งหมดบน GitHub</a></p>
    </div>
  </div>
</footer>
</body>
</html>
