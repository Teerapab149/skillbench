---
import Base from '../../layouts/Base.astro';
import Toc from '../../components/Toc.astro';
import Sheet from '../../components/Sheet.astro';
import { arms, studies, s3 } from '../../lib/data';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const usedIn = (id: string) => studies.filter((st) => st.armIds.includes(id as any)).map((st) => st.n);
const toc: [string, string][] = [['overview', 'ภาพรวม'], ...arms.map((a) => [a.id, `${a.id} ${a.short}`] as [string, string]), ['equal', 'ข้อผูกพันเท่ากันอย่างไร']];
const a2skills = arms.find((a) => a.id === 'A2')!.files.filter((f) => !f.always);
let inject: { file?: string; text?: string }[] = [];
try { const j = JSON.parse(arms.find((a) => a.id === 'A4')!.inject ?? '[]'); inject = Array.isArray(j) ? j : (j.injections ?? j.items ?? [j]); } catch {}
---
<Base title="กลุ่มทดลองและกฎ SkillBench" current="arms/">
  <header class="title-block col">
    <h1>กลุ่มทดลองทั้ง 6 และข้อความกฎจริงที่เอเจนต์ได้รับ</h1>
    <p class="lede" style="margin-top:1rem">ทุกกลุ่มใช้เอเจนต์ตัวเดียวกัน โจทย์เดียวกัน และระบบเดียวกัน ต่างกันเฉพาะกฎที่ได้รับและจังหวะที่กฎเข้าบริบท ข้อความด้านล่างคือไฟล์จริงที่ติดตั้งให้เอเจนต์ ไม่ได้ย่อหรือแก้ และไม่เปลี่ยนระหว่างการทดลองทั้งสามชุด</p>
  </header>
  <div class="article-grid">
    <Toc items={toc} />
    <article>
      <section id="overview" class="wide">
        <h2 class="h-first">ภาพรวม</h2>
        <div class="tbl-wrap">
          <table class="bt">
            <caption><b>ตารางที่ 1</b> กลุ่มทดลองและชุดที่ใช้</caption>
            <thead><tr><th>กลุ่ม</th><th>เอเจนต์ได้รับอะไร</th><th>จังหวะที่กฎเข้าบริบท</th><th class="r">ขนาด (ตัวอักษร)</th>{studies.map((st) => <th class="r">ชุดที่ {st.n}</th>)}</tr></thead>
            <tbody>
              {arms.map((a) => (
                <tr class={a.id === 'A1' || a.id === 'A2' ? 'hl' : ''}>
                  <td><a href={`#${a.id}`} class={`arm arm-${a.id}`}><b>{a.id}</b></a></td>
                  <td>{a.name}</td>
                  <td>{a.delivery}</td>
                  <td class="r">{a.chars ? a.chars.toLocaleString('en-US') : '0'}</td>
                  {studies.map((st) => <td class="r">{st.armIds.includes(a.id) ? <span class="used">ใช้</span> : <span class="muted">ไม่ใช้</span>}</td>)}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <figure class="timeline">
          <div class="tl-head"><span></span><span>ตอนเริ่มงาน</span><span>ระหว่างทำงาน</span></div>
          {arms.map((a) => (
            <div class="tl-row">
              <span class={`arm arm-${a.id}`}><b>{a.id}</b>&nbsp;{a.short}</span>
              <span class="lane">
                {a.files.filter((f) => f.always).map((f) => <i class={`chip arm-${a.id}`}>{f.name} {f.body.length.toLocaleString('en-US')}</i>)}
                {a.id === 'A0' && <i class="chip none">ไม่มีกฎ</i>}
                {(a.id === 'A2' || a.id === 'A4') && <i class="chip desc">คำอธิบาย {a2skills.length} skill</i>}
              </span>
              <span class="lane">
                {a.files.filter((f) => !f.always).map((f) => <i class="chip od">{f.name}</i>)}
                {a.id === 'A4' && <i class="chip bait">คอมเมนต์ล่อในโค้ด</i>}
              </span>
            </div>
          ))}
          <figcaption><b>รูปที่ 1</b> สิ่งที่เข้าบริบทของเอเจนต์ในแต่ละกลุ่ม ตัวเลขคือจำนวนตัวอักษร A2 และ A4 เห็นแค่บรรทัดคำอธิบายของ skill ตอนเริ่มงาน และเปิดเนื้อหาเต็มเมื่องานตรงกับคำอธิบาย ในชุดที่ 3 A2 เปิดเฉลี่ย {s3.nums.manipulation.A2.skillsLoadedPerRun.toFixed(2)} จาก {a2skills.length} skill ต่อ run</figcaption>
        </figure>
      </section>

      {arms.map((a) => (
        <section id={a.id} class="wide arm-sec">
          <div class="col">
            <h2><span class={`arm arm-${a.id}`}>{a.id}</span> {a.name}</h2>
            <p class="lede">{a.role}</p>
            <p class="meta small">ใช้ในการทดลอง{usedIn(a.id).map((n) => <a href={`${base}study-${n}/`}>ชุดที่ {n}</a>)} และตอบคำถาม: {a.question}</p>
          </div>
          {a.id === 'A0' && (
            <div class="col"><p>A0 ไม่มีไฟล์กฎใด ๆ เอเจนต์ยังเห็นเอกสารของโปรเจกต์ตามปกติ เช่น <code>REQUIREMENTS.md</code> และ <code>ARCHITECTURE.md</code> แต่ไม่มีใครบอกว่าต้องทำงานอย่างไร ตัวตรวจยังให้คะแนน A0 ด้วยกฎชุดเดียวกับกลุ่มอื่น รวมถึงกฎเฉพาะโปรเจกต์ที่ A0 ไม่เคยได้รับ ผลของ A0 จึงใช้เป็นเส้นฐานเชิงพรรณนา ไม่ใช่คู่ทดสอบ</p></div>
          )}
          {a.id === 'A2' && (
            <div class="col">
              <h3>สิ่งที่ A2 เห็นตอนเริ่มงาน คือชื่อและคำอธิบายของ skill</h3>
              <dl class="skills">{a2skills.map((s) => <><dt class="mono"><a href={`#skill-${s.name}`}>{s.name}</a></dt><dd>{s.description}</dd></>)}</dl>
              <p class="small muted">Claude Code ใส่บรรทัดเหล่านี้ไว้ในบริบท และเอเจนต์เรียก skill เองเมื่อเห็นว่างานตรงกับคำอธิบาย เนื้อหาเต็มของแต่ละ skill อยู่ด้านล่าง</p>
            </div>
          )}
          {a.id === 'A4' && (
            <div class="col">
              <p>A4 ใช้ไฟล์กฎและ skill ชุดเดียวกับ A2 ทุกไบต์ ข้อความเต็มดูได้ที่ <a href="#A2">A2</a> สิ่งที่ต่างคือคอมเมนต์ในโค้ดของระบบที่ล่อให้เอเจนต์ทำสิ่งที่ผู้ใช้ไม่ได้สั่ง ด้านล่างคือไฟล์ที่กำหนดคอมเมนต์ล่อเหล่านั้น</p>
              <div class="sheet"><div class="sheet-head"><span class="mono">arms/A4/adversarial/inject.json</span><span class="load ondemand">ฝังในโค้ดของระบบ</span></div><pre class="inject">{a.inject}</pre></div>
            </div>
          )}
          {a.id === 'A5' && (
            <div class="col"><p>ไฟล์ของ A5 คือไฟล์หลักของ A2 ต่อด้วยเนื้อหาของ skill ทั้ง {a2skills.length} ตัวเรียงกันเป็นหัวข้อ ปรับเฉพาะประโยคที่บอกว่ากฎอยู่ที่ไหน ข้อความบางวลีชวนให้เรียก skill เอเจนต์ A5 ในชุดที่ 3 จึงพยายามเรียก skill ใน {s3.nums.manipulation.A5.runsInvokingAny} run แต่ไม่สำเร็จ เพราะไม่ได้ติดตั้ง skill ไว้</p></div>
          )}
          {a.id !== 'A4' && a.files.map((f) => <Sheet path={f.path} always={f.always} body={f.body} id={f.always ? undefined : `skill-${f.name}`} />)}
        </section>
      ))}

      <section id="equal" class="col">
        <h2>ข้อผูกพันเท่ากันอย่างไร</h2>
        <p>กฎของงานนี้มี 20 ข้อ แยกเป็นข้อผูกพัน 47 ข้อ คือสิ่งที่ต้องทำหรือห้ามทำหนึ่งอย่าง ผู้วิจัยทำตารางไขว้ <code>COVERAGE-MAP.md</code> ว่าข้อผูกพันแต่ละข้ออยู่ในไฟล์ใดของแต่ละกลุ่ม และตรวจด้วยเครื่องว่า A1 และ A2 มีครบทั้ง 47 ข้อเท่ากัน ส่วนถ้อยคำและความยาวต่างกันโดยตั้งใจ เพราะเป็นการเขียนกฎสองแบบที่ทีมพัฒนาใช้จริง</p>
        <p>ดังนั้นผลหลัก A2 เทียบ A1 ตอบว่าชุดกฎสองรูปแบบให้ผลต่างกันหรือไม่ ส่วนคำถามว่ากลไกการโหลดมีผลหรือไม่ ต้องดู A2 เทียบ A5 ซึ่งใช้เนื้อหาเดียวกัน แต่คู่นั้นไม่ได้ถูกทดสอบตามแผนทั้งในชุดที่ 2 และชุดที่ 3</p>
      </section>
    </article>
  </div>
</Base>
<style>
  .h-first { margin-top: 0; }
  .used { color: var(--teal); font-weight: 600; }
  .timeline { margin: 2rem 0 1rem; }
  .tl-head, .tl-row { display: grid; grid-template-columns: 13rem 1fr 1fr; gap: 1rem; align-items: center; }
  .tl-head { font-size: 0.9rem; color: var(--ink-3); border-bottom: 1px solid var(--ink); padding-bottom: 0.4rem; }
  .tl-row { padding: 0.7rem 0; border-bottom: 1px solid var(--rule); }
  .lane { display: flex; flex-wrap: wrap; gap: 0.35rem; }
  .chip { font-style: normal; font-size: 0.85rem; font-family: var(--mono); padding: 0.1rem 0.5rem; border: 1px solid var(--c, var(--rule)); background: #fff; white-space: nowrap; }
  .chip.none { font-family: var(--sans); color: var(--ink-3); border-style: dashed; }
  .chip.desc { font-family: var(--sans); --c: var(--a2); border-style: dashed; }
  .chip.od { --c: var(--a2); background: var(--teal-wash); }
  .chip.bait { font-family: var(--sans); --c: var(--brick); background: var(--brick-wash); }
  @media (max-width: 700px) { .tl-head { display: none; } .tl-row { grid-template-columns: 1fr; gap: 0.4rem; } }
  .arm-sec { border-top: 3px solid var(--ink); margin-top: 4.5rem; }
  .arm-sec h2 { margin-top: 1.25rem; }
  .meta { color: var(--ink-2); display: flex; flex-wrap: wrap; gap: 0.25rem 0.75rem; }
  .skills dt { margin-top: 0.75rem; font-weight: 500; }
  .skills dd { margin: 0.15rem 0 0; color: var(--ink-2); }
  .inject { margin: 0; padding: 1rem 1.25rem; font-family: var(--mono); font-size: 0.82rem; line-height: 1.6; white-space: pre-wrap; overflow-wrap: anywhere; max-height: 28rem; overflow: auto; }
</style>
