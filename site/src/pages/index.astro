---
// หน้าแรกแบบเรื่องเล่า 6 ฉาก พื้นมืดทั้งหน้า ขยับตามการเลื่อนจอ ทุกตัวเลขและข้อความกฎมาจากไฟล์จริง
// ถ้าเครื่องตั้งค่าลดการเคลื่อนไหว หรือ JavaScript ไม่ทำงาน ทุกฉากแสดงสถานะสุดท้ายครบ
import Base from '../layouts/Base.astro';
import { studies, s3, scenarios, arms, pct, pts } from '../lib/data';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const p = s3.primary;
const d = p.decision;
const margin = d.margin as number;
const totalRuns = studies.reduce((s, st) => s + st.usable, 0);
const trapped = scenarios.filter((s) => s.family !== 'ordinary').length;
const s09 = scenarios.find((s) => s.code === 'S09')!;
const [, rateFrom, rateTo] = (s09.prompt.match(/(\d+)\s*บาทเป็น\s*(\d+)/) ?? ['', '20', '25']).map(Number);
const hours = 10;

// บันทึกจริงของกลุ่มไม่มีกฎในโจทย์ S09 เลือกครั้งแรกที่พลาดกฎเรื่องผลกระทบ
const s09runs = s3.runs.filter((r) => r.sc === s09.id && r.arm === 'A0').sort((a, b) => a.rep - b.rep);
const imMiss = (r: (typeof s09runs)[number]) => r.rules.some((x) => /^IM/.test(x.id) && x.app && x.ok === false);
const demo = s09runs.find(imMiss) ?? s09runs[0];
const demoMissed = imMiss(demo);

// ไฟล์กฎจริง
const a1 = arms.find((a) => a.id === 'A1')!;
const sections = a1.files[0].body.split(/\r?\n/).filter((l) => /^## /.test(l)).map((l) => l.replace(/^##\s*\d+\.\s*/, ''));
const a2 = arms.find((a) => a.id === 'A2')!;
const skills = a2.files.filter((f) => !f.always).map((f) => ({ name: f.name, needed: s09.expectedSkills.includes(f.name) }));
const neededN = skills.filter((s) => s.needed).length;

// จุดทุกครั้งที่ทำงาน ตำแหน่งเริ่มต้นแบบสุ่มแต่คงที่ทุก build
const hash = (i: number) => { const x = Math.sin(i * 12.9898) * 43758.5453; return x - Math.floor(x); };
let dotIndex = 0;
const fieldStudies = studies.map((st) => ({
  st,
  cells: st.perScenario.flatMap((ps) => st.armIds.flatMap((a, ai) => ps.byArm[a].runs.map((r, ri) => {
    const i = dotIndex++;
    return { r, gap: ri === 0 && ai > 0, dx: Math.round((hash(i) - 0.5) * 520), dy: Math.round((hash(i + 999) - 0.5) * 420), delay: Math.round(hash(i + 7) * 650) };
  }))),
}));
const shade = (v: number) => `color-mix(in oklab, #3fb3a6 ${Math.round(v * 100)}%, #d9733a)`;

// แกนผลหลัก
const lo = -0.15, hi = 0.15, AX = { x0: 20, x1: 580 };
const X = (v: number) => AX.x0 + ((v - lo) / (hi - lo)) * (AX.x1 - AX.x0);
const crit = (['A0', 'A1', 'A2', 'A5'] as const).map((a) => ({ a, v: s3.nums.perArm[a].CRIT as number }));
const critName: Record<string, string> = { A0: 'ไม่มีกฎ', A1: 'ไฟล์เดียว', A2: 'Agent Skills', A5: 'Skills แบบอ่านทุกครั้ง' };
---
<Base title="SkillBench เขียนกฎให้ AI แบบไหน AI ถึงจะทำตาม" current="" theme="story">
  <div class="story">
    <section class="scene s1 in" data-scene id="top">
      <div class="s1-in">
        <div class="s1-text">
          <h1 class="title"><span class="nw">เขียนกฎให้ AI</span> <span class="nw">แบบไหน</span> <span class="nw accent">AI ถึงจะทำตาม</span></h1>
          <p class="lead">เราให้ AI เขียนโค้ดทำงานจริง <b>{totalRuns} ครั้ง</b> เพื่อหาคำตอบว่า กฎชุดเดียวกัน ถ้าส่งเป็น <b>Agent Skills</b> กับ<b class="nw">ไฟล์เดียว</b> AI จะทำตามต่างกันไหม</p>
          <div class="cta">
            <a class="btn" href="#problem">เลื่อนดูเรื่องทั้งหมด</a>
            <a class="btn ghost" href={`${base}overview/`}>ข้ามไปสำรวจ</a>
          </div>
          <p class="byline">งานสัมมนา 477-401 สัมมนาระบบสารสนเทศทางธุรกิจ มหาวิทยาลัยสงขลานครินทร์<span>ธีรภาพ บุญศรี และ ธีรภัทร์ ชินวุฒิวงศ์ อาจารย์ที่ปรึกษา ผศ. ดร.รุชดี บิลหมัด</span></p>
        </div>
        <figure class="term" aria-label="บันทึกการทำงานจริงของ AI ในโจทย์ S09">
          <p class="term-bar"><i></i><i></i><i></i><span>Claude Code</span></p>
          <div class="term-body">
            <p class="t-line user"><span class="t-tag">ผู้ใช้</span><span class="type" data-text={s09.prompt}>{s09.prompt}</span></p>
            <p class="t-line step" style="--i:0"><span class="t-tag">AI</span>อ่านข้อกำหนดและโค้ดที่เกี่ยวข้อง</p>
            {demo.files.map((f, i) => <p class="t-line step" style={`--i:${i + 1}`}><span class="t-tag">แก้</span><span class="mono">{f}</span></p>)}
            {demo.done && <p class="t-line step ok" style={`--i:${demo.files.length + 1}`}><span class="t-tag">ผล</span>งานเสร็จ เทสผ่าน</p>}
            {demoMissed && <p class="t-line step warn" style={`--i:${demo.files.length + 2}`}><span class="t-tag">แต่</span>ไม่ได้เช็กและไม่ได้บอกว่าใบแจ้งหนี้เก่าเปลี่ยน</p>}
          </div>
          <figcaption>บันทึกจริงของ AI กลุ่มไม่มีกฎ โจทย์ S09 รอบที่ {demo.rep + 1} ย่อเหลือเฉพาะขั้นสำคัญ</figcaption>
        </figure>
      </div>
      <a class="cue" href="#problem" aria-label="เลื่อนลง"><span></span></a>
    </section>

    <section class="scene s2" data-scene id="problem">
      <div class="wrap two">
        <div class="copy">
          <h2>แก้ถูก แต่ใบแจ้งหนี้เดือนที่แล้วแพงขึ้นเอง</h2>
          <p>ระบบนี้คิดใบแจ้งหนี้ใหม่ทุกครั้งที่เปิดดู พอ AI แก้อัตราค่าบริการ ใบที่ส่งให้ลูกค้าไปแล้วก็เปลี่ยนตาม ไม่มี error ขึ้น เทสเดิมก็ยังผ่านหมด</p>
          <p>ปัญหาไม่ได้อยู่ที่ AI เขียนโค้ดไม่เป็น แต่อยู่ที่มัน<b>ทำเกินที่ขอโดยไม่บอกใคร</b> ทีมพัฒนาเลยต้องเขียนกฎให้ AI</p>
        </div>
        <figure class="inv-stage">
          <div class="inv">
            <p class="inv-h">ใบแจ้งหนี้เดือนที่แล้ว <span>ส่งให้ลูกค้าแล้ว</span></p>
            <dl><dt>เครื่อง V100</dt><dd>{hours} ชม.</dd><dt>อัตรา</dt><dd>{rateFrom} บาท/ชม.</dd></dl>
            <p class="inv-t">ยอดรวม <b>{hours * rateFrom} บาท</b></p>
          </div>
          <div class="inv after">
            <p class="inv-h">ใบเดิม หลัง AI แก้อัตรา <span class="stamp">ไม่มีใครรู้</span></p>
            <dl><dt>เครื่อง V100</dt><dd>{hours} ชม.</dd><dt>อัตรา</dt><dd><b>{rateTo} บาท/ชม.</b></dd></dl>
            <p class="inv-t">ยอดรวม <b><span class="count" data-from={hours * rateFrom} data-to={hours * rateTo}>{hours * rateTo}</span> บาท</b></p>
          </div>
          <figcaption>อัตรา {rateFrom} เป็น {rateTo} บาทมาจากโจทย์จริง ส่วนจำนวนชั่วโมงเป็นตัวอย่าง</figcaption>
        </figure>
      </div>
    </section>

    <section class="scene s3" data-scene id="two-ways">
      <div class="wrap">
        <h2>กฎชุดเดียวกัน ส่งให้ AI ได้สองแบบ</h2>
        <p class="sub">กล่องคือสิ่งที่ AI เห็นตอนเริ่มทำโจทย์ใบแจ้งหนี้ข้อเดิม กฎในสองแบบเหมือนกันทุกข้อ ต่างกันแค่วิธีส่ง</p>
        <div class="ways">
          <div class="way">
            <h3>ไฟล์เดียว</h3>
            <div class="ctx">
              <p class="ctx-h">สิ่งที่ AI เห็นตอนเริ่มงาน</p>
              <div class="chips">{sections.map((t, i) => <span class="chip all" style={`--i:${i}`}>{t}</span>)}</div>
            </div>
            <p class="note">ทั้ง {sections.length} หมวดเข้าไปตั้งแต่เริ่ม แม้หมวดที่ไม่เกี่ยวกับงานนี้</p>
          </div>
          <div class="way">
            <h3>Agent Skills</h3>
            <div class="ctx">
              <p class="ctx-h">สิ่งที่ AI เห็นตอนเริ่มงาน</p>
              <div class="chips">
                <span class="chip base">กฎพื้นฐานไม่กี่ข้อ</span>
                <span class="chip desc">ชื่อและคำอธิบายของ skill {skills.length} ชุด</span>
                {skills.filter((s) => s.needed).map((s, i) => <span class="chip open mono" style={`--i:${i}`}>{s.name}</span>)}
              </div>
            </div>
            <div class="shelf">{skills.map((s, i) => <span class={`card mono ${s.needed ? 'need' : 'skip'}`} style={`--i:${i}`}>{s.name}</span>)}</div>
            <p class="note">โจทย์นี้ควรเปิด {neededN} จาก {skills.length} ชุด ชุดที่ไม่เกี่ยวไม่ต้องเข้ามากวน</p>
          </div>
        </div>
        <p class="sub small">ไอเดียของ Skills คือกฎที่ไม่เกี่ยวไม่ควรมากวน AI ฟังดูดี แต่เท่าที่เราค้น ยังไม่มีใครวัดเทียบสองแบบนี้ตรง ๆ <a href={`${base}background/`}>อ่านว่าสองแบบนี้มาจากไหน</a></p>
      </div>
    </section>

    <section class="scene s4" data-scene id="experiment">
      <div class="wrap">
        <h2>เราเลยลองวัดดู {totalRuns} ครั้ง</h2>
        <p class="sub">โจทย์ {scenarios.length} ข้อ {trapped} ข้อซ่อนกับดัก ให้ AI ตัวเดียวกันทำทุกกลุ่มทุกรอบ ทดลองสามชุด แล้วให้โปรแกรมตรวจทีละกฎ ไม่มีคนหรือ AI ตัวอื่นให้คะแนน</p>
        <div class="field" aria-label={`การทำงานทั้ง ${totalRuns} ครั้งของการทดลองสามชุด`}>
          {fieldStudies.map(({ st, cells }) => (
            <figure class="blk">
              <figcaption><a href={`${base}study-${st.n}/`}><b>ชุดที่ {st.n}</b></a><span>{st.usable} ครั้ง</span></figcaption>
              <div class="grid" aria-hidden="true" style={`--cols:${st.armIds.length * st.reps}`}>
                {cells.map((c) => <i class={`d ${c.gap ? 'gap' : ''}`} style={`background:${shade(c.r.score)};--dx:${c.dx}px;--dy:${c.dy}px;--dl:${c.delay}ms`}></i>)}
              </div>
            </figure>
          ))}
        </div>
        <p class="legend"><i class="lg hi"></i>ทำตามกฎได้ครบ <i class="lg lo"></i>พลาด หนึ่งจุดคือการทำงานหนึ่งครั้ง <a href={`${base}runs/`}>กดดูทีละครั้ง</a></p>
      </div>
    </section>

    <section class="scene s5" data-scene id="answer">
      <div class="wrap">
        <h2 class="big">ใช้แบบไหนก็ได้ผล<span class="eq">เทียบเท่า</span>กัน</h2>
        <figure class="axis">
          <svg viewBox="0 0 600 150" role="img" aria-label={`Skills ได้ ${pct(p.rateA)}% ไฟล์เดียว ${pct(p.rateB)}% ต่างกัน ${pts(p.diff)} จุด อยู่ในเกณฑ์ ±${(margin * 100).toFixed(1)} จุด`}>
            <rect class="band" x={X(-margin)} y="34" width={X(margin) - X(-margin)} height="56" />
            <text class="band-t" x={X(0)} y="24" text-anchor="middle">เกณฑ์ ±{(margin * 100).toFixed(1)} จุดที่ตั้งไว้ก่อนเริ่ม</text>
            <line x1={X(0)} x2={X(0)} y1="34" y2="90" class="zero" />
            <line class="ci" x1={X(d.ci90[0])} x2={X(d.ci90[1])} y1="62" y2="62" pathLength="1" />
            <circle class="pt" cx={X(p.diff)} cy="62" r="9" />
            {[-15, -10, -5, 0, 5, 10, 15].map((t) => <text class="tick" x={X(t / 100)} y="116" text-anchor="middle">{t > 0 ? `+${t}` : t < 0 ? `−${-t}` : '0'}</text>)}
            <text class="dir" x={AX.x0} y="142">ไฟล์เดียวดีกว่า</text>
            <text class="dir" x={AX.x1} y="142" text-anchor="end">Skills ดีกว่า</text>
          </svg>
          <figcaption>Skills ได้ {pct(p.rateA)}% ไฟล์เดียวได้ {pct(p.rateB)}% ต่างกัน <b>{pts(p.diff)} จุด</b> เส้นคือช่วงที่ค่าจริงน่าจะอยู่ ซึ่งอยู่ในแถบเกณฑ์ทั้งเส้น เทียบเท่าไม่ได้แปลว่าเหมือนกัน แต่มั่นใจได้ว่า Skills <b>ไม่ด้อยกว่า</b>ไฟล์เดียว</figcaption>
        </figure>

        <div class="rules-block" data-scene>
        <h2 class="big but">แต่<span class="must">ต้องมีกฎ</span></h2>
        <div class="bars" role="img" aria-label="สัดส่วนครั้งที่ทำตามกฎสำคัญครบทุกข้อของแต่ละกลุ่ม">
          {crit.map(({ a, v }, i) => (
            <div class={`bar-row ${a === 'A0' ? 'none' : ''}`} style={`--i:${i}`}>
              <span class="bar-l">{critName[a]}</span>
              <span class="bar-t"><i style={`--w:${v * 100}%`}></i></span>
              <b class="bar-v">{pct(v)}%</b>
            </div>
          ))}
        </div>
        <p class="sub small">สัดส่วนครั้งที่ AI ทำตามกฎสำคัญครบทุกข้อ ในการทดลองชุดที่ 3 ข้อนี้เป็นข้อสังเกตเพิ่ม ยังไม่ได้ทดสอบยืนยัน</p>
        </div>
      </div>
    </section>

    <section class="scene s6" data-scene id="explore">
      <div class="wrap">
        <h2 class="big">อยากรู้มากกว่านี้</h2>
        <p class="sub">ทุกตัวเลขในเว็บนี้ดึงจากไฟล์ผลการทดลองโดยตรง กดเข้าไปดูได้ถึงการทำงานทีละครั้ง</p>
        <a class="btn xl" href={`${base}overview/`}>สำรวจทั้งหมด</a>
        <nav class="go" aria-label="ไปต่อ">
          <a href={`${base}study-3/`}><b>ผลรอบสุดท้าย</b><span>ตัวเลขเต็มของชุดที่ 3 และสิ่งที่เราเห็นเพิ่ม</span></a>
          <a href={`${base}background/`}><b>เรื่องพื้นฐาน</b><span>Context Engineering กับ Agent Skills คืออะไร มาจากไหน</span></a>
          <a href={`${base}arms/`}><b>กลุ่มและกฎ</b><span>ไฟล์กฎจริงที่ AI แต่ละกลุ่มได้</span></a>
          <a href={`${base}scenarios/`}><b>โจทย์ {scenarios.length} ข้อ</b><span>คำสั่ง กับดัก และผลของแต่ละกลุ่ม</span></a>
          <a href={`${base}runs/`}><b>ทุกครั้งที่ทำงาน</b><span>{totalRuns} ครั้ง ดูได้ว่า AI ทำอะไรไปบ้าง</span></a>
          <a href={`${base}skillbench-report.pdf`}><b>รายงานฉบับเต็ม</b><span>PDF ภาษาไทย</span></a>
        </nav>
      </div>
    </section>
  </div>

  <script>
    const root = document.documentElement;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!reduce) {
      root.classList.add('motion');
      // พิมพ์คำสั่งของผู้ใช้ทีละตัวอักษร ตัดตามกลุ่มตัวอักษรไทยไม่ให้สระลอย
      const type = document.querySelector<HTMLElement>('.type');
      if (type) {
        const text = type.dataset.text ?? '';
        const seg = 'Segmenter' in Intl ? [...new Intl.Segmenter('th', { granularity: 'grapheme' }).segment(text)].map((s) => s.segment) : [...text];
        type.textContent = '';
        let n = 0;
        const tick = () => { n++; type.textContent = seg.slice(0, n).join(''); if (n < seg.length) setTimeout(tick, 34); else type.closest('.term')?.classList.add('typed'); };
        setTimeout(tick, 500);
      }
      // นับยอดใบแจ้งหนี้เมื่อฉากเข้าจอ
      const runCount = (el: HTMLElement) => {
        const from = Number(el.dataset.from), to = Number(el.dataset.to), t0 = performance.now(), dur = 1400;
        el.textContent = String(from);
        const step = (t: number) => { const k = Math.min(1, (t - t0 - 500) / dur); const e = k <= 0 ? 0 : 1 - Math.pow(1 - k, 3); el.textContent = String(Math.round(from + (to - from) * e)); if (k < 1) requestAnimationFrame(step); };
        requestAnimationFrame(step);
      };
      const io = new IntersectionObserver((entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          e.target.classList.add('in');
          e.target.querySelectorAll<HTMLElement>('.count').forEach(runCount);
          io.unobserve(e.target);
        }
      }, { threshold: 0.28 });
      document.querySelectorAll('[data-scene]:not(.s1)').forEach((s) => io.observe(s));
      document.querySelectorAll<HTMLElement>('.count').forEach((el) => { el.textContent = el.dataset.from ?? ''; });
    } else {
      document.querySelectorAll('[data-scene]').forEach((s) => s.classList.add('in'));
    }
  </script>
</Base>
<style>
  /* โลกของหน้า: ห้องมืดของคนดูจอ ตัวอักษรขาวนวล เขียวหัวเป็ดคือผลหลัก ส้มอิฐคือสิ่งที่พลาด */
  .story { --bg: #0e131c; --bg2: #141b27; --fg: #ecedf0; --fg2: #b4bccb; --fg3: #8b95a7; --line: #2a3344; --teal-l: #3fb3a6; --brick-l: #e0874f; margin-inline: calc(50% - 50vw); background: var(--bg); color: var(--fg); overflow: hidden; }
  .story ::selection { background: var(--teal-l); color: #0e131c; }
  .scene { position: relative; min-height: 100svh; display: flex; align-items: center; padding: clamp(4rem, 9vw, 7rem) 1.25rem; border-top: 1px solid var(--line); }
  .s1 { border-top: 0; padding-top: clamp(2.5rem, 6vw, 4rem); }
  .wrap { width: 100%; max-width: var(--wide); margin: 0 auto; }
  .story h2 { color: var(--fg); font-size: clamp(1.8rem, 5vw, 3.1rem); line-height: 1.3; margin: 0 0 1.25rem; max-width: 22ch; }
