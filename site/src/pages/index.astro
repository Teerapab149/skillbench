---
import Base from '../layouts/Base.astro';
import ThreeStudies from '../components/ThreeStudies.astro';
import RunField from '../components/RunField.astro';
import { studies, s3, scenarios, arms, failsByCat, pct, pts } from '../lib/data';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const p = s3.primary;
const d = p.decision;
const s09 = scenarios.find((s) => s.code === 'S09')!;
const totalRuns = studies.reduce((s, st) => s + st.usable, 0);
const im = failsByCat.IM;
// อัตราในโจทย์ S09 มาจากคำสั่งจริง (20 → 25 บาท) ส่วนจำนวนชั่วโมงเป็นตัวอย่าง
const [, rateFrom, rateTo] = (s09.prompt.match(/(\d+)\s*บาทเป็น\s*(\d+)/) ?? ['', '20', '25']).map(Number);
const hours = 10;
// ข้อความจริงจากไฟล์กฎ
const a1 = arms.find((a) => a.id === 'A1')!.files[0];
const a1Lines = a1.body.split(/\r?\n/).filter((l) => l.trim()).slice(0, 6);
const skill = arms.find((a) => a.id === 'A2')!.files.find((f) => f.name === 'impact-analysis')!;
---
<Base title="SkillBench เขียนกฎให้ AI แบบไหน AI ถึงจะทำตาม" current="">
  <section class="hero">
    <div class="hero-in">
      <div class="hero-text">
        <h1><span class="nw">เขียนกฎให้ AI</span> <span class="nw">แบบไหน</span> <span class="nw">AI ถึงจะทำตาม</span></h1>
        <p class="hero-lede">เราให้ AI เขียนโค้ดทำงานจริง {totalRuns} ครั้ง เพื่อหาคำตอบว่า ถ้าเขียนกฎแบบ <b>Agent Skills</b> AI จะทำตามกฎต่างจากการ<b class="nw">เขียนรวมไว้ไฟล์เดียว</b>ไหม</p>
        <div class="hero-cta">
          <a class="btn" href="#answer">ดูคำตอบ</a>
          <a class="btn ghost" href={`${base}skillbench-report.pdf`}>อ่านรายงานฉบับเต็ม</a>
        </div>
        <p class="hero-by">ธีรภาพ บุญศรี และ ธีรภัทร์ ชินวุฒิวงศ์ <span>อาจารย์ที่ปรึกษา ผศ. ดร.รุชดี บิลหมัด</span><span>สัมมนาระบบสารสนเทศทางธุรกิจ <span class="nw">มหาวิทยาลัยสงขลานครินทร์</span></span></p>
      </div>
      <div class="hero-field">
        <RunField />
        <p class="field-note">หนึ่งช่องคือการทำงานหนึ่งครั้ง ยิ่งเขียวยิ่งทำตามกฎได้มาก กดช่องไหนก็ได้เพื่อดูว่า AI ทำอะไรไปบ้าง</p>
      </div>
    </div>
  </section>

  <section id="answer" class="band">
    <h2>คำตอบสั้น ๆ</h2>
    <p class="answer">ใช้แบบไหนก็ได้ผล<span class="verdict">เทียบเท่า</span>กัน แต่ AI ที่<b>ไม่มีกฎ</b>พลาดบ่อยกว่ามาก</p>
    <p class="answer-sub">ครึ่งแรกคือสิ่งที่เราทดสอบตามแผนที่ตั้งไว้ก่อนเริ่ม ครึ่งหลังเป็นสิ่งที่เราสังเกตเห็นเพิ่ม ยังไม่ได้ทดสอบยืนยัน กว่าจะได้คำตอบนี้เราทดลองสามรอบ สองรอบแรกยังสรุปไม่ได้</p>
  </section>

  <ThreeStudies n={1} />

  <section id="problem" class="split">
    <div class="split-text">
      <h2>ทำไมต้องมีกฎ</h2>
      <p>ลองดูโจทย์ {s09.code} ผู้ใช้สั่งว่า <q>{s09.prompt}</q> AI แก้ตัวเลขได้ถูกต้อง แต่ระบบนี้คิดใบแจ้งหนี้ใหม่ทุกครั้งที่เปิดดู ใบแจ้งหนี้ที่ส่งให้ลูกค้าไปแล้วเลยแพงขึ้นตามไปด้วย ไม่มี error ขึ้น และเทสเดิมก็ยังผ่านหมด</p>
      <p>ปัญหาแบบนี้ไม่ได้เกิดเพราะ AI เขียนโค้ดไม่เป็น แต่เพราะมันทำเกินกว่าที่ขอโดยไม่บอกใคร ทีมพัฒนาเลยต้องเขียนกฎให้ AI เช่น แก้เฉพาะที่สั่ง ห้ามแตะไฟล์ข้อมูล และต้องเช็กผลกระทบก่อนแก้ส่วนที่คิดเงิน</p>
      <p><a href={`${base}scenarios/${s09.id}/`}>ดูว่าแต่ละกลุ่มทำโจทย์นี้ได้แค่ไหน</a></p>
    </div>
    <figure class="invoices">
      <div class="inv">
        <p class="inv-h">ใบแจ้งหนี้เดือนที่แล้ว <span>ส่งให้ลูกค้าแล้ว</span></p>
        <dl><dt>เครื่อง V100</dt><dd>{hours} ชม.</dd><dt>อัตรา</dt><dd>{rateFrom} บาท/ชม.</dd></dl>
        <p class="inv-t">ยอดรวม <b>{hours * rateFrom} บาท</b></p>
      </div>
      <div class="inv changed">
        <p class="inv-h">ใบเดิม หลัง AI แก้อัตรา <span>ไม่มีใครรู้</span></p>
        <dl><dt>เครื่อง V100</dt><dd>{hours} ชม.</dd><dt>อัตรา</dt><dd><b>{rateTo} บาท/ชม.</b></dd></dl>
        <p class="inv-t">ยอดรวม <b>{hours * rateTo} บาท</b></p>
      </div>
      <figcaption><b>รูปที่ 2</b> อัตรา {rateFrom} เป็น {rateTo} บาทมาจากโจทย์จริง ส่วนจำนวนชั่วโมงเป็นตัวอย่าง</figcaption>
    </figure>
  </section>

  <section id="two-ways" class="wide">
    <h2>กฎชุดเดียวกัน เขียนได้สองแบบ</h2>
    <p class="col">กฎทั้งสองแบบเหมือนกันทุกข้อ ต่างกันแค่วิธีส่งให้ AI แบบแรก AI อ่านกฎทั้งหมดตั้งแต่เริ่มงาน แบบที่สอง AI เห็นแค่หัวข้อ แล้วค่อยเปิดอ่านเฉพาะเรื่องที่เกี่ยวกับงานตรงหน้า ด้านล่างคือไฟล์จริงที่เราใช้</p>
    <div class="files">
      <figure class="file">
        <p class="file-h"><span class="mono">{a1.path}</span><span class="load always">อ่านทุกครั้งที่เริ่มงาน</span></p>
        <div class="file-b">{a1Lines.map((l) => <p class={l.startsWith('#') ? 'fh' : ''}>{l.replace(/^#+\s*/, '').replace(/\*\*/g, '')}</p>)}<p class="more">ไฟล์นี้มีกฎครบทุกข้อ ยาว {a1.body.length.toLocaleString('en-US')} ตัวอักษร</p></div>
        <figcaption><b>ไฟล์เดียว</b> เขียนง่าย ดูแลง่าย แต่ AI ต้องอ่านกฎทุกข้อ แม้ข้อที่ไม่เกี่ยวกับงาน</figcaption>
      </figure>
      <figure class="file">
        <p class="file-h"><span class="mono">{skill.path}</span><span class="load ondemand">เปิดเมื่องานเกี่ยว</span></p>
        <div class="file-b"><p class="fh">คำอธิบายที่ AI เห็นตอนเริ่มงาน</p><p>{skill.description}</p><p class="more">ถ้างานตรงกับคำอธิบายนี้ AI จะเปิดอ่านเนื้อหาเต็มอีก {skill.body.length.toLocaleString('en-US')} ตัวอักษร</p></div>
        <figcaption><b>Agent Skills</b> แยกกฎเป็นชุดย่อย ๆ ไอเดียคือถ้ากฎที่ไม่เกี่ยวไม่มากวน AI น่าจะทำตามกฎที่เกี่ยวได้ดีขึ้น แต่เท่าที่เราค้น ยังไม่มีใครวัดเทียบสองแบบนี้ตรง ๆ</figcaption>
      </figure>
    </div>
    <p class="col"><a href={`${base}arms/`}>ดูไฟล์กฎฉบับเต็มของทุกกลุ่ม</a></p>
  </section>

  <section id="final" class="col">
    <h2>สิ่งที่เราพบ</h2>
    <ol class="finds">
      <li><b>ใช้แบบไหนก็ได้</b> ในการทดลองรอบสุดท้าย Skills ได้คะแนน {pct(p.rateA)}% ไฟล์เดียวได้ {pct(p.rateB)}% ต่างกัน {pts(p.diff)} จุด ซึ่งอยู่ในเกณฑ์ ±{(d.margin * 100).toFixed(1)} จุดที่เราตั้งไว้ก่อนเริ่ม และเพราะไฟล์เดียวได้คะแนนสูงอยู่แล้ว สิ่งที่มั่นใจได้จริง ๆ คือ Skills <b>ไม่ด้อยกว่า</b>ไฟล์เดียว</li>
      <li><b>แต่ต้องมีกฎ</b> AI ที่ไม่มีกฎทำตามกฎสำคัญได้ครบแค่ {pct(s3.nums.perArm.A0.CRIT)}% ของครั้ง ส่วนกลุ่มที่มีกฎทำได้ {pct(s3.nums.perArm.A1.CRIT)} ถึง {pct(s3.nums.perArm.A5.CRIT)}% และในโจทย์ที่ต้องเช็กผลกระทบต่อใบแจ้งหนี้เก่า AI ที่ไม่มีกฎไม่เช็กหรือไม่บอก {im.A0.fail} จาก {im.A0.app} ครั้ง (ข้อนี้เราสังเกตเพิ่ม ยังไม่ได้ทดสอบยืนยัน)</li>
      <li><b>ถ้าใช้ Skills ให้เขียนคำอธิบายดี ๆ</b> AI เปิด skill เฉลี่ย {s3.nums.manipulation.A2.skillsLoadedPerRun.toFixed(1)} จาก 4 ชุดต่องาน บางชุดถูกเปิดเกินจำเป็น บางชุดไม่ถูกเปิดตอนที่ควรเปิด และควรปล่อยให้ AI ถามได้เมื่อเจอข้อกำหนดที่ไม่ชัด</li>
    </ol>
  </section>

  <section id="studies" class="wide">
    <h2>ทำไมต้องทดลองสามรอบ</h2>
    <p class="col">ทุกรอบใช้ Claude Code กับโมเดล <span class="mono">{s3.model}</span> บนระบบจองเครื่อง GPU ที่เราสร้างขึ้นเอง แต่ละรอบทำให้เราเจอจุดที่เครื่องมือวัดยังไม่ดี แล้วแก้ในรอบถัดไป</p>
    <ol class="timeline">
      {studies.map((st) => (
        <li class={st.n === 3 ? 'last' : ''}>
          <div class="tl-n">ชุดที่ {st.n}<small>{st.verdict}</small></div>
          <div class="tl-body">
            <h3><a href={`${base}study-${st.n}/`}>{st.role}</a></h3>
            <p>{st.summary}</p>
            {st.changed && <p class="tl-next">{st.changed}</p>}
            <p class="small"><a href={`${base}study-${st.n}/`}>อ่านเรื่องของชุดที่ {st.n}</a></p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section id="explore" class="wide">
    <h2>อยากดูเพิ่ม</h2>
    <p class="report-dl"><a href={`${base}skillbench-report.pdf`}>อ่านรายงานฉบับเต็ม</a> <span>PDF ภาษาไทย ขนาด 1.9 MB มีวิธีวิจัย ผล และข้อจำกัดครบทั้งสามรอบ</span></p>
    <div class="explore">
      <a href={`${base}runs/`}><b>การทำงานทั้ง {totalRuns} ครั้ง</b><span>ดูทีละครั้งว่า AI แก้ไฟล์ไหน เปิด skill อะไร และผ่านกฎข้อไหน</span></a>
      <a href={`${base}scenarios/`}><b>โจทย์ {scenarios.length} ข้อ</b><span>คำสั่ง กับดัก และผลของแต่ละกลุ่ม</span></a>
      <a href={`${base}arms/`}><b>กลุ่มทดลองและไฟล์กฎ</b><span>แต่ละกลุ่มได้อะไร และข้อความกฎเต็ม ๆ</span></a>
      <a href={`${base}method/`}><b>เราวัดยังไง</b><span>หนึ่งครั้งที่ AI ทำงานมีขั้นตอนอะไร และให้คะแนนแบบไหน</span></a>
      <a href={`${base}protocol/`}><b>แผนที่ตั้งไว้ก่อนเริ่ม</b><span>แผนทั้งสามรอบ และสิ่งที่ไม่เป็นไปตามแผน</span></a>
      <a href="https://github.com/Teerapab149/skillbench"><b>โค้ดและข้อมูลดิบ</b><span>ทุกอย่างอยู่บน GitHub</span></a>
    </div>
  </section>
</Base>
<style>
  /* ---------- hero เต็มจอ พื้นหมึก ---------- */
  .hero { margin-inline: calc(50% - 50vw); background: #121722; color: #e8eaee; padding: clamp(3rem, 7vw, 6rem) 1.25rem clamp(3rem, 6vw, 5rem); }
  .hero-in { max-width: var(--wide); margin: 0 auto; display: grid; gap: 3rem; grid-template-columns: minmax(0, 1fr); align-items: center; }
  @media (min-width: 1100px) { .hero-in { grid-template-columns: minmax(34rem, 1fr) auto; } .hero h1 { font-size: clamp(2.4rem, 3.3vw, 3.6rem); } }
  .hero h1 { color: #fff; font-size: clamp(2rem, 7vw, 4.4rem); line-height: 1.25; }
  .nw { white-space: nowrap; }
  .hero-lede { font-size: clamp(1.1rem, 2vw, 1.35rem); line-height: 1.75; color: #b9c0cc; margin-top: 1.5rem; max-width: 34rem; }
  .hero-lede b { color: #fff; font-weight: 600; }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 0.75rem; margin: 2rem 0; }
  .btn { display: inline-block; padding: 0.65rem 1.4rem; background: #3fb3a6; color: #0d1118; font-weight: 600; text-decoration: none; border-radius: 3px; transition: background 0.2s; }
  .btn:hover { background: #5cc8bb; }
  .btn.ghost { background: transparent; color: #e8eaee; box-shadow: inset 0 0 0 1px #4a5366; }
  .btn.ghost:hover { box-shadow: inset 0 0 0 1px #e8eaee; }
  .hero-by { font-size: 0.95rem; color: #e8eaee; line-height: 1.7; }
  .hero-by span { display: block; color: #8a93a4; }
  .field-note { font-size: 0.88rem; color: #8a93a4; margin-top: 1.25rem; max-width: 30rem; }
  .hero :global(a:focus-visible) { outline-color: #3fb3a6; }

  .facts-line { border-bottom: 1px solid var(--rule); padding: 1.5rem 0; }
  .facts-line p { margin: 0; font-size: 1.1rem; color: var(--ink-2); line-height: 1.9; }
  .facts-line b { font-family: var(--serif); font-size: 1.9rem; color: var(--ink); margin: 0 0.15rem 0 0.6rem; }
  .facts-line b:first-child { margin-left: 0; }

  /* ---------- คำตอบ และตารางผลที่เป็นไปได้ ---------- */
  .band { padding: 4rem 0 1rem; }
  .band h2 { margin-top: 0; }
  .answer { font-family: var(--serif); font-size: clamp(1.5rem, 3.2vw, 2.25rem); line-height: 1.55; font-weight: 500; max-width: 46rem; }
  .answer-sub { color: var(--ink-2); max-width: 44rem; margin-top: 1rem; }
  .vm { margin-top: 2rem; border-top: 2px solid var(--ink); max-width: 56rem; }
  .vm-row { display: grid; grid-template-columns: 10rem repeat(3, minmax(0, 1fr)); border-bottom: 1px solid var(--rule); text-decoration: none; color: var(--ink); }
  a.vm-row:hover { background: var(--paper-2); }
  .vm-row.head span { font-size: 0.92rem; color: var(--ink-3); padding: 0.6rem 0.75rem; }
  .vm-st { padding: 0.9rem 0.75rem; display: flex; flex-direction: column; }
  .vm-st b { font-family: var(--serif); }
  .vm-st small { color: var(--ink-3); }
  .vm-c { display: flex; flex-direction: column; justify-content: center; padding: 0.9rem 0.75rem; border-left: 1px solid var(--rule); }
  .vm-c i { width: 1.1rem; height: 1.1rem; border: 1.5px dashed var(--rule); border-radius: 50%; }
  .vm-c.hit { background: var(--paper-2); }
  .vm-c.hit b { font-family: var(--serif); font-size: 1.15rem; }
  .vm-c.hit small { color: var(--ink-3); }
  .vm-c.ok { background: var(--teal-wash); box-shadow: inset 0 0 0 2px var(--teal); }
  .vm-c.ok b { color: var(--teal); }
  @media (max-width: 640px) { .vm-row { grid-template-columns: 4.6rem repeat(3, minmax(0, 1fr)); font-size: 0.9rem; } .vm-st small { display: none; } .vm-c { padding: 0.8rem 0.4rem; } .vm-c small { display: none; } .vm-c.hit b { font-size: 0.95rem; white-space: nowrap; } .vm-row.head span { padding: 0.5rem 0.4rem; font-size: 0.8rem; } }

  /* ---------- ปัญหา ---------- */
  .split { display: grid; gap: 2.5rem; grid-template-columns: minmax(0, 1fr); align-items: center; margin-top: 2rem; }
  @media (min-width: 980px) { .split { grid-template-columns: minmax(0, 1fr) 26rem; } }
  q { quotes: '“' '”'; color: var(--ink); }
  .invoices { margin: 0; display: grid; gap: 1rem; }
  .inv { background: #fff; border: 1px solid var(--rule); padding: 1.1rem 1.4rem; box-shadow: 0 1px 2px rgba(22, 27, 38, 0.05), 0 10px 30px -18px rgba(22, 27, 38, 0.25); }
  .inv.changed { border-color: var(--brick); transform: translateX(1.5rem); }
  .inv-h { font-family: var(--serif); font-weight: 600; margin: 0 0 0.5rem; display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
  .inv-h span { font-family: var(--sans); font-weight: 400; font-size: 0.85rem; color: var(--ink-3); }
  .changed .inv-h span { color: var(--brick); font-weight: 600; }
  .inv dl { display: grid; grid-template-columns: 1fr auto; gap: 0.1rem 1rem; margin: 0; border-bottom: 1px solid var(--rule); padding-bottom: 0.5rem; }
  .inv dd { margin: 0; text-align: right; }
  .changed dd b { color: var(--brick); }
  .inv-t { margin: 0.5rem 0 0; display: flex; justify-content: space-between; }
  .inv-t b { font-family: var(--serif); font-size: 1.5rem; }
  .changed .inv-t b { color: var(--brick); }
  @media (max-width: 640px) { .inv.changed { transform: none; } }

  /* ---------- สองวิธี ---------- */
  .files { display: grid; gap: 2rem; grid-template-columns: minmax(0, 1fr); margin: 1.5rem 0; }
  @media (min-width: 900px) { .files { grid-template-columns: 1fr 1fr; } }
  .file { margin: 0; }
  .file-h { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 0.25rem 1rem; font-size: 0.88rem; margin: 0; padding: 0.6rem 1rem; background: #fff; border: 1px solid var(--rule); border-bottom: 0; overflow-wrap: anywhere; }
  .file-b { background: #fff; border: 1px solid var(--rule); padding: 1rem 1.25rem; min-height: 15rem; }
  .file-b p { margin: 0 0 0.35rem; font-size: 0.98rem; line-height: 1.6; }
  .file-b .fh { font-family: var(--serif); font-weight: 600; margin-top: 0.4rem; }
  .file-b .more { color: var(--ink-3); font-size: 0.9rem; margin-top: 0.8rem; border-top: 1px dashed var(--rule); padding-top: 0.6rem; }

  /* ---------- เส้นเวลา ---------- */
