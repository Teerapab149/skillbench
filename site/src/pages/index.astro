---
import Base from '../layouts/Base.astro';
import Toc from '../components/Toc.astro';
import ThreeStudies from '../components/ThreeStudies.astro';
import { studies, s3, scenarios, pct, pts, fmtP } from '../lib/data';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const p = s3.primary;
const d = p.decision;
const s09 = scenarios.find((s) => s.code === 'S09')!;
const totalRuns = studies.reduce((s, st) => s + st.usable, 0);
const toc: [string, string][] = [
  ['answer', 'คำตอบโดยย่อ'],
  ['problem', 'ปัญหา'],
  ['two-ways', 'สองวิธีบอกกฎ'],
  ['studies', 'การทดลองสามชุด'],
  ['final', 'ผลสุดท้าย'],
  ['contrib', 'สิ่งที่งานนี้ให้ไว้'],
  ['explore', 'สำรวจข้อมูล'],
];
---
<Base title="SkillBench เขียนกฎให้ AI แบบไหน AI ถึงจะทำตาม" current="">
  <header class="hero col reveal">
    <h1>เขียนกฎให้ AI แบบไหน <br />AI ถึงจะทำตาม</h1>
    <p class="q">เราทดลองว่าการบอกกฎให้เอเจนต์เขียนโค้ดแบบ <b>Agent Skills</b> ทำให้เอเจนต์ทำตามกฎต่างจากการเขียนกฎไว้ใน<b>ไฟล์เดียว</b>หรือไม่ ทดลองสามชุด รวม {totalRuns} run</p>
    <p class="byline"><strong>ธีรภาพ บุญศรี และ ธีรภัทร์ ชินวุฒิวงศ์</strong><br />อาจารย์ที่ปรึกษา ผศ. ดร.รุชดี บิลหมัด<br />รายวิชา 477-401 สัมมนาระบบสารสนเทศทางธุรกิจ มหาวิทยาลัยสงขลานครินทร์</p>
  </header>

  <div class="article-grid">
    <Toc items={toc} />
    <article>
      <section id="answer" class="col">
        <h2 class="h-first">คำตอบโดยย่อ</h2>
        <p class="answer">สองแบบให้ผล<span class="verdict">เทียบเท่า</span>กันตามเกณฑ์ที่ประกาศไว้ล่วงหน้า และ Skills ไม่ด้อยกว่าไฟล์เดียว แต่การ<b>มีกฎ</b>สำคัญกว่ารูปแบบของกฎ</p>
        <p>ได้คำตอบนี้ในการทดลองชุดที่ 3 สองชุดแรกให้ผลไปทางเดียวกันแต่สรุปไม่ได้ และแต่ละครั้งเผยข้อบกพร่องของเครื่องมือวัดที่ต้องแก้ก่อน</p>
      </section>

      <ThreeStudies n={1} />

      <section id="problem" class="col">
        <h2>ปัญหา</h2>
        <p class="lede">AI เขียนโค้ดเก่งขึ้นมาก ปัญหาที่ทีมพัฒนาเจอจริงไม่ใช่ว่ามันเขียนไม่เป็น แต่คือมันทำสิ่งที่ไม่ได้สั่งโดยไม่บอก</p>
        <p>ตัวอย่างจากโจทย์ {s09.code} ในงานนี้ ผู้ใช้สั่งว่า <q>{s09.prompt}</q> การแก้ตัวเลขนี้ดูปลอดภัยที่สุด แต่ระบบคำนวณใบแจ้งหนี้ใหม่จากประวัติการใช้งานทุกครั้งที่เรียกดู ใบแจ้งหนี้ของเดือนที่ออกไปแล้วจึงแพงขึ้นตามทันที โดยไม่มี error และเทสเดิมยังผ่านหมด</p>
        <p>ทีมจึงต้องบอกกฎให้ AI เช่น แก้เฉพาะที่สั่ง ห้ามแก้ไฟล์ข้อมูล และต้องวัดผลกระทบก่อนแก้ส่วนที่คิดเงิน การเตรียมข้อมูลที่ AI จะเห็นแบบนี้เรียกว่า <em>Context Engineering</em></p>
      </section>

      <section id="two-ways" class="col">
        <h2>สองวิธีบอกกฎ</h2>
        <div class="two">
          <div>
            <h3>ไฟล์เดียว</h3>
            <p>เขียนกฎทุกข้อไว้ในไฟล์อย่าง <code>CLAUDE.md</code> ซึ่งถูกโหลดเข้าบริบททุกครั้งที่ AI เริ่มงาน ง่าย และเป็นวิธีที่ใช้กันมากที่สุด</p>
          </div>
          <div>
            <h3>Agent Skills</h3>
            <p>แยกกฎเป็นชุดย่อย แต่ละชุดมีคำอธิบายสั้นว่าใช้เมื่อใด AI เห็นแค่คำอธิบายตอนเริ่มงาน และเปิดเนื้อหาเต็มเมื่องานตรงกับคำอธิบาย</p>
          </div>
        </div>
        <p>แนวคิดของ Skills คือกฎที่ไม่เกี่ยวไม่ควรรกบริบท AI จึงน่าจะทำตามกฎที่เกี่ยวได้ดีขึ้น ฟังมีเหตุผล แต่เท่าที่ผู้วิจัยค้นถึงเดือนตุลาคม 2569 ยังไม่มีงานที่วัดเทียบสองแบบนี้ตรง ๆ เมื่อข้อผูกพันของกฎเท่ากัน งานนี้จึงสร้างระบบวัดผลชื่อ SkillBench ขึ้นมาวัด</p>
        <p><a href={`${base}arms/`}>ดูข้อความกฎจริงที่ส่งให้ AI ทุกกลุ่ม</a></p>
      </section>

      <section id="studies" class="wide">
        <div class="col">
          <h2>การทดลองสามชุด</h2>
          <p>ทั้งสามชุดใช้เอเจนต์ Claude Code กับโมเดล <span class="mono">{s3.model}</span> บนระบบจองเครื่อง GPU ที่ผู้วิจัยสร้างขึ้น ให้คะแนนด้วยโปรแกรมจากร่องรอยการทำงานจริง ไม่มีคนหรือ AI ตัวอื่นตัดสิน และประกาศแผนวิเคราะห์ไว้ก่อนเก็บข้อมูลทุกครั้ง</p>
        </div>
        <ol class="timeline">
          {studies.map((st) => (
            <li class={st.n === 3 ? 'last' : ''}>
              <div class="tl-n">ชุดที่ {st.n}</div>
              <div class="tl-body">
                <h3><a href={`${base}study-${st.n}/`}>{st.role}</a></h3>
                <p>{st.summary}</p>
                <dl>
                  <dt>กลุ่ม</dt><dd>{st.armIds.map((a, i) => <>{i ? ', ' : ''}<span class={`arm arm-${a}`}>{a}</span></>)}</dd>
                  <dt>ขนาด</dt><dd>{st.k} โจทย์ × {st.reps} รอบ = {st.usable} run</dd>
                  <dt>ตัวชี้วัด</dt><dd>{st.metricName}</dd>
                  <dt>ผล A2 − A1</dt><dd>{pts(st.primary.diff)} จุด, p = {fmtP(st.primary.p)}, <b>{st.verdict}</b></dd>
                </dl>
                {st.changed && <p class="tl-next"><b>นำไปสู่ชุดถัดไป</b> {st.changed}</p>}
                <p><a href={`${base}study-${st.n}/`}>อ่านรายละเอียดชุดที่ {st.n}</a></p>
              </div>
            </li>
          ))}
        </ol>
      </section>

      <section id="final" class="col">
        <h2>ผลสุดท้ายจากชุดที่ 3</h2>
        <p>Agent Skills ได้ RCRc {pct(p.rateA)}% ไฟล์เดียวได้ {pct(p.rateB)}% ต่างกัน {pts(p.diff)} จุด ช่วงความเชื่อมั่น 90% อยู่ระหว่าง {pts(d.ci90[0])} ถึง {pts(d.ci90[1])} จุด อยู่ในเกณฑ์เทียบเท่า ±{(d.margin * 100).toFixed(1)} จุดทั้งช่วง จึงสรุปว่าเทียบเท่า เพราะคะแนนใกล้เพดาน สิ่งที่ยืนยันได้ชัดคือ Skills <b>ไม่ด้อยกว่า</b>ไฟล์เดียว</p>
        <p><span class="qual">เชิงสำรวจ</span> ความต่างที่ใหญ่กว่าอยู่ระหว่างมีกฎกับไม่มีกฎ AI ที่ไม่มีกฎผ่านกฎสำคัญครบ {pct(s3.nums.perArm.A0.CRIT)}% ของ run เทียบกับ {pct(s3.nums.perArm.A1.CRIT)} ถึง {pct(s3.nums.perArm.A5.CRIT)}% เมื่อมีกฎ</p>
        <h3>ข้อเสนอแนะสำหรับทีมพัฒนา</h3>
        <ul>
          <li>เลือกรูปแบบกฎจากความสะดวกในการดูแลและต้นทุน ไม่ใช่เพราะเชื่อว่าแบบหนึ่งทำให้ AI เชื่อฟังกว่า</li>
          <li>ให้ AI มีกฎ โดยเฉพาะเรื่องขอบเขตงานและการตรวจผลกระทบต่อข้อมูลเดิม</li>
          <li>ถ้าใช้ Skills ให้ตรวจว่าคำอธิบายทำให้ skill ถูกเปิดในงานที่ควรเปิด และเปิดช่องให้ AI ถามได้</li>
        </ul>
        <p><a href={`${base}study-3/`}>อ่านผลชุดที่ 3 ฉบับเต็ม พร้อมข้อจำกัด</a></p>
      </section>

      <section id="contrib" class="col">
        <h2>สิ่งที่งานนี้ให้ไว้</h2>
        <p><b>ระบบวัดผลที่ตรวจตัวเองได้</b> SkillBench ตรวจการทำตามกฎจากร่องรอยจริงด้วยโปรแกรมทั้งหมด คุมเนื้อหากฎให้เท่ากันและตรวจได้ด้วยเครื่อง และมีด่านตรวจความถูกต้องของตัวเองหลายชั้น</p>
        <p><b>บทเรียนเรื่องการวัด AI</b> สองชุดแรกสรุปไม่ได้ส่วนหนึ่งเพราะเครื่องมือวัดบกพร่องโดยไม่แสดงอาการ การวัดเอเจนต์ต้องลงทุนกับการตรวจเครื่องมือวัดไม่น้อยกว่าการเก็บข้อมูล</p>
        <p><b>ความโปร่งใส</b> แผนทุกชุดประกาศก่อนเก็บข้อมูล ส่วนเบี่ยงเบนบันทึกครบ และโค้ด ข้อมูล กับประวัติการแก้ไขทั้งหมดเปิดอยู่บน GitHub</p>
      </section>

      <section id="explore" class="col">
        <h2>สำรวจข้อมูล</h2>
        <ul class="explore">
          <li><a href={`${base}arms/`}><b>กลุ่มทดลองและกฎ</b></a><span>กลุ่ม A0 ถึง A5 บทบาทของแต่ละกลุ่ม และข้อความกฎเต็มทุกไฟล์</span></li>
          <li><a href={`${base}scenarios/`}><b>โจทย์ทั้ง {scenarios.length} ข้อ</b></a><span>คำสั่ง กับดัก กฎที่ใช้ให้คะแนน และผลในแต่ละชุด</span></li>
          <li><a href={`${base}runs/`}><b>ทะเบียน run ทั้ง {totalRuns} ตัว</b></a><span>ผลตรวจกฎทีละข้อของทุก run ในทั้งสามชุด</span></li>
          <li><a href={`${base}method/`}><b>วิธีวัด</b></a><span>ขั้นตอนของหนึ่ง run ตัวชี้วัด สถิติ และการตรวจเครื่องมือวัด</span></li>
          <li><a href={`${base}protocol/`}><b>เอกสารแผน</b></a><span>แผนที่ประกาศล่วงหน้าทั้งสามชุด และบันทึกส่วนเบี่ยงเบน</span></li>
        </ul>
      </section>
    </article>
  </div>
</Base>
<style>
  .hero { padding: 4rem 0 2.5rem; border-bottom: 1px solid var(--rule); margin-bottom: 2.5rem; }
  .hero h1 { font-size: clamp(2.2rem, 5.5vw, 3.75rem); word-break: keep-all; }
  .q { font-size: 1.3rem; line-height: 1.7; color: var(--ink-2); margin-top: 1.25rem; }
  .q b { color: var(--ink); }
  .h-first { margin-top: 0; }
  .answer { font-family: var(--serif); font-size: clamp(1.35rem, 2.6vw, 1.7rem); line-height: 1.6; font-weight: 500; }
  q { quotes: '“' '”'; color: var(--ink); }
  .two { display: grid; gap: 0 2.5rem; grid-template-columns: 1fr; margin: 0.5rem 0 1rem; }
  @media (min-width: 700px) { .two { grid-template-columns: 1fr 1fr; } }
  .two h3 { margin-top: 0.5rem; }
  .timeline { list-style: none; padding: 0; margin: 2rem 0 0; }
  .timeline li { display: grid; grid-template-columns: 7rem minmax(0, 1fr); gap: 1.5rem; padding: 1.75rem 0; border-top: 1px solid var(--rule); }
  .timeline li:first-child { border-top: 2px solid var(--ink); }
  .timeline li.last { border-bottom: 2px solid var(--ink); }
  .tl-n { font-family: var(--serif); font-weight: 700; font-size: 1.5rem; color: var(--ink-3); }
  .last .tl-n { color: var(--teal); }
  .tl-body h3 { margin-top: 0; font-size: 1.35rem; }
  .tl-body h3 a { color: var(--ink); text-decoration: none; }
  .tl-body h3 a:hover { color: var(--teal); }
  .tl-body dl { display: grid; grid-template-columns: 7rem 1fr; gap: 0.25rem 1rem; margin: 0.5rem 0 1rem; font-size: 1rem; }
  .tl-body dt { color: var(--ink-3); }
  .tl-body dd { margin: 0; }
  .tl-next { color: var(--ink-2); }
  @media (max-width: 640px) { .timeline li { grid-template-columns: 1fr; gap: 0.25rem; } }
  .explore { list-style: none; padding: 0; border-top: 2px solid var(--ink); }
  .explore li { display: flex; flex-direction: column; padding: 0.9rem 0; border-bottom: 1px solid var(--rule); }
  .explore b { font-family: var(--serif); }
  .explore span { color: var(--ink-3); font-size: 0.98rem; }
</style>
