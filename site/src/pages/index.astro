---
// หน้าแรก: แบบจำลองหลักฐานบนกระดาษกราฟ
// การทำงานจริง 660 ครั้งคือเสา 660 ต้น สูงตามคะแนนจริง ตั้งเป็นเมืองสามย่านตามชุดการทดลองบนพื้นกระดาษกราฟ
// เลื่อนลงแล้วกล้องค่อย ๆ ก้มลงจนมองตรงจากด้านบน เมืองกลายเป็นตารางของแต่ละชุด แล้วชุดที่ 3 ยุบลงเป็นเส้นผลในแถบเกณฑ์
// ฉากอื่นแสดงหลักฐานในรูปที่มันเป็นจริง บันทึกของ AI diff ของใบแจ้งหนี้ และขนาดบริบทที่ AI เห็นนับเป็นตัวอักษร
// ถ้าไม่มี JavaScript จะเห็นรูปนิ่งแทน ถ้าเครื่องตั้งค่าลดการเคลื่อนไหว canvas จะเปลี่ยนเป็นทีละสถานะโดยไม่ขยับ
import Base from '../layouts/Base.astro';
import { studies, s3, scenarios, arms, pct, pts } from '../lib/data';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const p = s3.primary;
const d = p.decision;
const margin = d.margin as number;
const totalRuns = studies.reduce((s, st) => s + st.usable, 0);
const trapped = scenarios.filter((s) => s.family !== 'ordinary').length;
const s09 = scenarios.find((s) => s.code === 'S09')!;
const [, rateFrom, rateTo] = (s09.prompt.match(/(\d+)\s*บาทเป็น\s*(\d+)/) ?? ['', '20', '25']).map(Number);
const hours = 10;
const fmt = (n: number) => n.toLocaleString('en-US');

// บันทึกจริงของกลุ่มไม่มีกฎในโจทย์ S09 เลือกครั้งแรกที่พลาดกฎเรื่องผลกระทบ
const s09runs = s3.runs.filter((r) => r.sc === s09.id && r.arm === 'A0').sort((a, b) => a.rep - b.rep);
const imMiss = (r: (typeof s09runs)[number]) => r.rules.some((x) => /^IM/.test(x.id) && x.app && x.ok === false);
const demo = s09runs.find(imMiss) ?? s09runs[0];
const demoMissed = imMiss(demo);

// ขนาดบริบทจริง นับเป็นตัวอักษรจากไฟล์กฎ
const a1 = arms.find((a) => a.id === 'A1')!;
const a1Body = a1.files.map((f) => f.body).join('\n');
const a1Parts = a1Body.split(/\r?\n(?=## )/);
const a1Segs = a1Parts.map((t, i) => ({ name: /^## /.test(t) ? t.split(/\r?\n/)[0].replace(/^##\s*\d+\.\s*/, '') : 'หัวไฟล์', n: t.length + (i < a1Parts.length - 1 ? 1 : 0) }));
const a1Chars = a1.files.reduce((s, f) => s + f.body.length, 0);
const a2 = arms.find((a) => a.id === 'A2')!;
const a2Base = a2.files.filter((f) => f.always).reduce((s, f) => s + f.body.length, 0);
const a2Skills = a2.files.filter((f) => !f.always).map((f) => ({ name: f.name, n: f.body.length, desc: (f.description ?? '').length, needed: s09.expectedSkills.includes(f.name) }));
const descChars = a2Skills.reduce((s, x) => s + x.desc, 0);
const a2Start = a2Base + descChars;
const a2Opened = a2Skills.filter((s) => s.needed).reduce((s, x) => s + x.n, 0);
const scaleMax = Math.max(a1Chars, a2Start + a2Opened);
const w = (n: number) => `${(n / scaleMax) * 100}%`;
const neededN = a2Skills.filter((s) => s.needed).length;
let nj = 0;
const a2Open = a2Skills.filter((s) => s.needed).map((s) => ({ ...s, j: nj++ }));
const a2Idle = a2Skills.filter((s) => !s.needed);

// จุดทุกครั้งที่ทำงาน เรียงแบบเดียวกับตารางของแต่ละชุด แถวคือโจทย์ คอลัมน์คือกลุ่มและรอบ
const shade = (v: number) => `color-mix(in oklab, #3fb3a6 ${Math.round(v * 100)}%, #d9733a)`;
const fieldStudies = studies.map((st) => ({
  st,
  cells: st.perScenario.flatMap((ps) => st.armIds.flatMap((a, ai) => ps.byArm[a].runs.map((r, ri) => ({ r, a, gap: ri === 0 && ai > 0 })))),
}));
const payload = {
  studies: fieldStudies.map(({ st, cells }) => ({ n: st.n, usable: st.usable, verdict: st.verdict, cols: st.armIds.length * st.reps, reps: st.reps, rows: st.perScenario.length, n0: cells.length })),
  dots: fieldStudies.flatMap(({ st, cells }, si) => cells.map((c, i) => [si, i, Math.round(c.r.score * 100), si === 2 && (c.a === p.armA || c.a === p.armB) ? 1 : 0])),
  axis: { lo: -0.15, hi: 0.15, margin, ci: d.ci90, diff: p.diff },
};

// แกนผลหลัก ใช้ในรูปนิ่งเมื่อไม่มี JavaScript
const lo = -0.15, hi = 0.15, AX = { x0: 20, x1: 580 };
const X = (v: number) => AX.x0 + ((v - lo) / (hi - lo)) * (AX.x1 - AX.x0);
const crit = (['A0', 'A1', 'A2', 'A5'] as const).map((a) => ({ a, v: s3.nums.perArm[a].CRIT as number }));
const critName: Record<string, string> = { A0: 'ไม่มีกฎ', A1: 'ไฟล์เดียว', A2: 'Agent Skills', A5: 'Skills อ่านทุกครั้ง' };
const ci = (v: number) => `${v >= 0 ? '+' : '−'}${Math.abs(v * 100).toFixed(1)}`;
---
<Base title="SkillBench การควบคุมพฤติกรรม LLM Agent ด้วย Context Engineering และระบบทักษะเอเจนต์" current="" theme="story">
  <div class="story">
    <div class="stage" aria-hidden="true"><canvas id="heap"></canvas></div>
    <script is:inline type="application/json" id="story-data" set:html={JSON.stringify(payload)}></script>

    <section class="hero" id="top">
      <div class="hero-in">
        <h1 class="title">การควบคุมพฤติกรรม LLM Agent ในงานพัฒนาระบบด้วย <span class="accent">Context Engineering และระบบทักษะเอเจนต์</span></h1>
        <p class="ask">พูดง่าย ๆ คือ เขียนกฎให้ AI แบบไหน AI ถึงจะทำตาม</p>
        <p class="lead">กฎชุดเดียวกัน ถ้าส่งเป็น <b>Agent Skills</b> กับ<b class="nw">ไฟล์เดียว</b> AI จะทำตามต่างกันไหม เราให้ AI เขียนโค้ดทำงานจริง <b>{totalRuns} ครั้ง</b> เพื่อหาคำตอบ</p>
        <div class="hero-act">
          <a class="btn" href="#problem">เลื่อนดูเรื่องทั้งหมด</a>
          <p class="quick">คำตอบสั้น ๆ <b>ได้ผลเทียบเท่ากัน</b> <a href="#answer">ข้ามไปดูคำตอบ</a></p>
        </div>
        <p class="byline">งานสัมมนา 477-401 มหาวิทยาลัยสงขลานครินทร์<span>ธีรภาพ บุญศรี และ ธีรภัทร์ ชินวุฒิวงศ์ อาจารย์ที่ปรึกษา ผศ. ดร.รุชดี บิลหมัด</span></p>
      </div>
      <p class="key"><span>เสาหนึ่งต้นคือ AI ทำงานจริงหนึ่งครั้ง</span><span>สูงและเขียว ทำตามกฎได้ครบ</span><span>เตี้ยและส้ม พลาด</span></p>
    </section>

    <section class="room" id="problem">
      <div class="wrap two">
        <div class="copy">
          <h2>แก้ถูก แต่ใบแจ้งหนี้เดือนที่แล้วแพงขึ้นเอง</h2>
          <p>ระบบนี้คิดใบแจ้งหนี้ใหม่ทุกครั้งที่เปิดดู พอ AI แก้อัตราค่าบริการ ใบที่ส่งให้ลูกค้าไปแล้วก็เปลี่ยนตาม ไม่มี error ขึ้น เทสเดิมก็ยังผ่านหมด</p>
          <p>ปัญหาไม่ได้อยู่ที่ AI เขียนโค้ดไม่เป็น แต่อยู่ที่มัน<b>ทำเกินที่ขอโดยไม่บอกใคร</b> ทีมพัฒนาเลยต้องเขียนกฎให้ AI</p>
        </div>
        <div class="evidence">
          <figure class="term" aria-label="บันทึกการทำงานจริงของ AI ในโจทย์ S09">
            <p class="term-bar"><span>claude code</span><span>S09 กลุ่มไม่มีกฎ รอบที่ {demo.rep + 1}</span></p>
            <div class="term-body">
              <p class="t-line user"><span class="t-tag">ผู้ใช้</span><span class="type" data-text={s09.prompt}>{s09.prompt}</span></p>
              <p class="t-line step" style="--i:0"><span class="t-tag">AI</span>อ่านข้อกำหนดและโค้ดที่เกี่ยวข้อง</p>
              {demo.files.map((f, i) => <p class="t-line step" style={`--i:${i + 1}`}><span class="t-tag">แก้</span><span class="mono">{f}</span></p>)}
              {demo.done && <p class="t-line step ok" style={`--i:${demo.files.length + 1}`}><span class="t-tag">ผล</span>งานเสร็จ เทสผ่าน</p>}
              {demoMissed && <p class="t-line step warn" style={`--i:${demo.files.length + 2}`}><span class="t-tag">แต่</span>ไม่ได้เช็กและไม่ได้บอกว่าใบแจ้งหนี้เก่าเปลี่ยน</p>}
            </div>
          </figure>
          <figure class="diff" data-scrub="enter" aria-label={`ใบแจ้งหนี้เดือนที่แล้ว อัตราเปลี่ยนจาก ${rateFrom} เป็น ${rateTo} บาทต่อชั่วโมง ยอดรวมเปลี่ยนจาก ${hours * rateFrom} เป็น ${hours * rateTo} บาท`}>
            <p class="diff-h"><span>ใบแจ้งหนี้เดือนที่แล้ว</span><span>ส่งให้ลูกค้าแล้ว</span></p>
            <p class="dl"><span class="dm"> </span><span>เครื่อง V100</span><span>{hours} ชม.</span></p>
            <p class="dl del"><span class="dm">−</span><span>อัตรา</span><span>{rateFrom} บาท/ชม.</span></p>
            <p class="dl add" style="--o:0"><span class="dm">+</span><span>อัตรา</span><span>{rateTo} บาท/ชม.</span></p>
            <p class="dl del total"><span class="dm">−</span><span>ยอดรวม</span><span>{hours * rateFrom} บาท</span></p>
            <p class="dl add total" style="--o:1"><span class="dm">+</span><span>ยอดรวม</span><span>{hours * rateTo} บาท</span></p>
            <figcaption>ใบเดิมใบเดียวกัน ก่อนและหลัง AI แก้อัตรา อัตรามาจากโจทย์จริง จำนวนชั่วโมงเป็นตัวอย่าง</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class="room" id="two-ways" data-pin>
      <div class="pin-in">
        <div class="wrap">
          <h2>กฎชุดเดียวกัน ส่งให้ AI ได้สองแบบ</h2>
          <p class="sub">แถบคือสิ่งที่ AI อ่านเข้าไปตอนทำโจทย์ใบแจ้งหนี้ข้อเดิม ความยาวนับจากจำนวนตัวอักษรจริงในไฟล์กฎ กฎในสองแบบเหมือนกันทุกข้อ ต่างกันแค่วิธีส่ง</p>
          <div class="gauges" data-scrub="way">
            <div class="gauge">
              <p class="g-h"><b>ไฟล์เดียว</b><span class="read">{fmt(a1Chars)} ตัวอักษร ตั้งแต่เริ่ม</span></p>
              <div class="tape" role="img" aria-label={`ไฟล์เดียว ${a1Segs.length} ส่วน รวม ${fmt(a1Chars)} ตัวอักษร เข้าไปทั้งหมดตั้งแต่เริ่ม`}>
                {a1Segs.map((x, i) => <i class="seg one" style={`--w:${w(x.n)};--i:${i}`} title={`${x.name} ${fmt(x.n)}`}></i>)}
              </div>
              <ol class="seg-names">{a1Segs.filter((x) => x.name !== 'หัวไฟล์').map((x) => <li>{x.name}</li>)}</ol>
            </div>
            <div class="gauge">
              <p class="g-h"><b>Agent Skills</b><span class="read">{fmt(a2Start)} ตอนเริ่ม <span class="open-read">+ {fmt(a2Opened)} ถ้าเปิด {neededN} skill</span></span></p>
              <div class="tape" role="img" aria-label={`Agent Skills เริ่มที่ ${fmt(a2Start)} ตัวอักษร แล้วเปิด skill ที่เกี่ยว ${neededN} ชุด เพิ่ม ${fmt(a2Opened)} ตัวอักษร`}>
                <i class="seg base" style={`--w:${w(a2Base)}`} title={`กฎพื้นฐาน ${fmt(a2Base)}`}></i>
                <i class="seg desc" style={`--w:${w(descChars)}`} title={`คำอธิบาย skill ${fmt(descChars)}`}></i>
                {a2Open.map((s) => <i class="seg open" style={`--w:${w(s.n)};--j:${s.j}`} title={`${s.name} ${fmt(s.n)}`}></i>)}
              </div>
              <ul class="seg-key">
                <li><i class="k base"></i>กฎพื้นฐาน {fmt(a2Base)}</li>
                <li><i class="k desc"></i>ชื่อและคำอธิบาย skill {a2Skills.length} ชุด {fmt(descChars)}</li>
                {a2Open.map((s) => <li class="k-open" style={`--j:${s.j}`}><i class="k open"></i><span class="mono">{s.name}</span> {fmt(s.n)}</li>)}
                {a2Idle.map((s) => <li class="k-idle"><i class="k idle"></i><span class="mono">{s.name}</span> {fmt(s.n)} ไม่ได้เปิด เพราะไม่เกี่ยวกับโจทย์นี้</li>)}
              </ul>
            </div>
          </div>
          <p class="sub">Skills เริ่มด้วยของที่น้อยกว่า แต่ถ้าเปิด skill ที่โจทย์นี้ควรเปิดครบ {neededN} ชุด ความยาวรวมกลับมากกว่าไฟล์เดียว ที่ต่างคือ skill ที่ไม่เกี่ยวอย่าง <span class="mono">{a2Idle.map((x) => x.name).join(" ")}</span> ไม่ถูกอ่านเลย</p>
          <p class="sub small">ไอเดียของ Skills คือกฎที่ไม่เกี่ยวไม่ควรมากวน AI ฟังดูดี แต่เท่าที่เราค้น ยังไม่มีใครวัดเทียบสองแบบนี้ตรง ๆ <a href={`${base}background/`}>อ่านว่าสองแบบนี้มาจากไหน</a></p>
        </div>
      </div>
    </section>

    <section class="seq" id="experiment">
      <div class="beat">
        <div class="slab">
          <p class="readout"><b>{totalRuns}</b> ครั้ง</p>
          <h2>เราเลยให้ AI ทำงานจริงแล้ววัดผลทุกครั้ง</h2>
          <p>โจทย์ {scenarios.length} ข้อ {trapped} ข้อซ่อนกับดัก ให้ AI ตัวเดียวกันทำทุกกลุ่มทุกรอบ ทดลองสามชุด แล้วให้โปรแกรมตรวจทีละกฎ ไม่มีคนหรือ AI ตัวอื่นให้คะแนน</p>
          <p class="legend"><i class="lg hi"></i><span class="nw">ทำตามกฎได้ครบ</span> <i class="lg lo"></i><span class="nw">พลาด</span> <a href={`${base}runs/`} class="nw">กดดูทีละครั้ง</a></p>
          <div class="fb field" aria-label={`การทำงานทั้ง ${totalRuns} ครั้งของการทดลองสามชุด`}>
            {fieldStudies.map(({ st, cells }) => (
              <figure class="blk">
                <figcaption><b>ชุดที่ {st.n}</b><span>{st.usable} ครั้ง</span></figcaption>
                <div class="grid" aria-hidden="true" style={`--cols:${st.armIds.length * st.reps}`}>
                  {cells.map((c) => <i class={`d ${c.gap ? 'gap' : ''}`} style={`background:${shade(c.r.score)}`}></i>)}
                </div>
              </figure>
            ))}
          </div>
        </div>
      </div>
      <div class="beat">
        <div class="slab">
          <h2>สองชุดแรกยังสรุปไม่ได้</h2>
          <p>ชุดที่ 1 ให้คะแนนโหดเกินไป ชุดที่ 2 โจทย์ที่ใช้ตัดสินได้ยังน้อยและตัวตรวจบางข้อผิด เราจดไว้ทุกจุด แล้วแก้เครื่องมือวัดจนไว้ใจได้ก่อนเก็บ<b>ชุดที่ 3</b> ซึ่งเป็นชุดที่ใช้ตอบคำถาม</p>
          <p class="links"><a href={`${base}study-1/`}>ชุดที่ 1</a> <a href={`${base}study-2/`}>ชุดที่ 2</a> <a href={`${base}study-3/`}>ชุดที่ 3</a></p>
        </div>
      </div>
      <div class="beat answer" id="answer">
        <div class="slab">
          <h2>ใช้แบบไหนก็ได้ผล<span class="eq">เทียบเท่า</span>กัน</h2>
          <dl class="meter">
            <div><dt>ผลต่าง</dt><dd class="big">{pts(p.diff)}<small>จุด</small></dd></div>
            <div><dt>ช่วงที่ค่าจริงน่าจะอยู่</dt><dd>{ci(d.ci90[0])} ถึง {ci(d.ci90[1])}</dd></div>
            <div><dt>เกณฑ์ที่ตั้งไว้ก่อนเริ่ม</dt><dd>±{(margin * 100).toFixed(1)}</dd></div>
          </dl>
          <p>Skills ได้ {pct(p.rateA)}% ไฟล์เดียวได้ {pct(p.rateB)}% ช่วงของผลต่างอยู่ในแถบเกณฑ์ทั้งเส้น เทียบเท่าไม่ได้แปลว่าเหมือนกัน แต่มั่นใจได้ว่า Skills <b>ไม่ด้อยกว่า</b>ไฟล์เดียว</p>
          <figure class="fb axis">
            <svg viewBox="0 0 600 150" role="img" aria-label={`Skills ได้ ${pct(p.rateA)}% ไฟล์เดียว ${pct(p.rateB)}% ต่างกัน ${pts(p.diff)} จุด อยู่ในเกณฑ์ ±${(margin * 100).toFixed(1)} จุด`}>
              <rect class="band" x={X(-margin)} y="34" width={X(margin) - X(-margin)} height="56" />
              <text class="band-t" x={X(0)} y="24" text-anchor="middle">เกณฑ์ ±{(margin * 100).toFixed(1)} จุดที่ตั้งไว้ก่อนเริ่ม</text>
              <line x1={X(0)} x2={X(0)} y1="34" y2="90" class="zero" />
              <line class="ci" x1={X(d.ci90[0])} x2={X(d.ci90[1])} y1="62" y2="62" />
              <circle class="pt" cx={X(p.diff)} cy="62" r="9" />
              {[-15, -10, -5, 0, 5, 10, 15].map((t) => <text class="tick" x={X(t / 100)} y="116" text-anchor="middle">{t > 0 ? `+${t}` : t < 0 ? `−${-t}` : '0'}</text>)}
              <text class="dir" x={AX.x0} y="142">ไฟล์เดียวดีกว่า</text>
              <text class="dir" x={AX.x1} y="142" text-anchor="end">Skills ดีกว่า</text>
            </svg>
          </figure>
        </div>
      </div>
      <div class="beat tail" aria-hidden="true"></div>
    </section>

    <section class="room" id="rules">
      <div class="wrap two rules">
        <div class="copy">
          <h2>แต่ต้องมีกฎ</h2>
          <p>สัดส่วนครั้งที่ AI ทำตามกฎสำคัญครบทุกข้อ ในการทดลองชุดที่ 3 กลุ่มที่ไม่ได้กฎเลยทำได้แค่ครึ่งเดียว ส่วนกลุ่มที่ได้กฎ จะส่งแบบไหนก็ขึ้นมาใกล้กัน</p>
          <p class="note">ข้อนี้เป็นข้อสังเกตเพิ่ม ยังไม่ได้ทดสอบยืนยันทางสถิติ</p>
        </div>
        <div class="cols" role="img" aria-label={`สัดส่วนครั้งที่ทำตามกฎสำคัญครบทุกข้อ ${crit.map(({ a, v }) => `${critName[a]} ${pct(v)}%`).join(' ')}`} data-scrub="enter">
          {crit.map(({ a, v }, i) => (
            <div class={`col ${a === 'A0' ? 'none' : ''}`} style={`--h:${v};--i:${i}`}>
              <b class="col-v">{pct(v)}%</b>
              <span class="col-t"><i></i></span>
              <span class="col-l">{critName[a]}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="room end" id="explore">
      <div class="wrap">
        <h2>อยากรู้มากกว่านี้</h2>
        <p class="sub">ทุกตัวเลขในเว็บนี้ดึงจากไฟล์ผลการทดลองโดยตรง กดเข้าไปดูได้ถึงการทำงานทีละครั้ง</p>
        <nav class="index" aria-label="ไปต่อ">
          <a class="lead-row" href={`${base}overview/`}><b>สำรวจทั้งหมด</b><span>ภาพรวม ผลทั้งสามชุด กฎ โจทย์ และการทำงานทุกครั้ง</span><svg viewBox="0 0 32 16" aria-hidden="true"><path d="M1 8h28M23 2l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6" /></svg></a>
          <a href={`${base}study-3/`}><b>ผลรอบสุดท้าย</b><span>ตัวเลขเต็มของชุดที่ 3</span><svg viewBox="0 0 32 16" aria-hidden="true"><path d="M1 8h28M23 2l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6" /></svg></a>
          <a href={`${base}background/`}><b>เรื่องพื้นฐาน</b><span>Context Engineering กับ Agent Skills คืออะไร</span><svg viewBox="0 0 32 16" aria-hidden="true"><path d="M1 8h28M23 2l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6" /></svg></a>
          <a href={`${base}skillbench-report.pdf`}><b>รายงานฉบับเต็ม</b><span>PDF ภาษาไทย</span><svg viewBox="0 0 32 16" aria-hidden="true"><path d="M1 8h28M23 2l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6" /></svg></a>
        </nav>
      </div>
    </section>
  </div>

  <script>
    type Dot = [number, number, number, number];
    type Data = {
      studies: { n: number; usable: number; verdict: string; cols: number; reps: number; rows: number; n0: number }[];
      dots: Dot[];
      axis: { lo: number; hi: number; margin: number; ci: [number, number]; diff: number };
    };
    const root = document.documentElement;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const data: Data = JSON.parse(document.getElementById('story-data')!.textContent || '{}');
    const canvas = document.getElementById('heap') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d');
    const seq = document.querySelector<HTMLElement>('.seq')!;
    const hero = document.querySelector<HTMLElement>('.hero')!;
    if (!reduce) root.classList.add('motion');
    if (ctx) root.classList.add('cv');

    const clamp = (v: number, a = 0, b = 1) => Math.min(b, Math.max(a, v));
    const ease = (t: number) => 1 - Math.pow(1 - t, 3);
    const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
    const hash = (i: number) => { const x = Math.sin(i * 12.9898) * 43758.5453; return x - Math.floor(x); };
    const HI = [63, 179, 166], LO = [217, 115, 58];
    const mixc = (v: number) => HI.map((h, k) => LO[k] + (h - LO[k]) * v);
    const rgb = (c: number[], k = 1) => `rgb(${c.map((x) => Math.round(Math.min(255, x * k))).join(',')})`;

    // ---------- เตรียมจุด ----------
    // แต่ละครั้งที่ทำงานคือเสาหนึ่งต้น ความสูงตามคะแนนจริง มองจากบนลงล่างก็คือตารางของแต่ละชุด
    type P = { s: number; g: number; c: string; rgb: number[]; hz: number; dl: number; u: number; v: number; gx: number; gy: number; ax: number; jy: number; i: number };
    const pts: P[] = data.dots.map(([s, i, sc, g], k) => ({ s, g, c: rgb(mixc(sc / 100)), rgb: mixc(sc / 100), hz: 0.6 + (sc / 100) * 4.4, dl: hash(k + 7), u: 0, v: 0, gx: 0, gy: 0, ax: 0, jy: hash(k * 13 + 1) - 0.5, i }));
    const order = pts.map((_, k) => k);
    const ansIdx = pts.map((_, k) => k).filter((k) => pts[k].g).sort((a, b) => hash(a * 3 + 2) - hash(b * 3 + 2));

    let W = 0, H = 0, dpr = 1, mobile = false;
    let cell = 10, dotSz = 8;
    let gridC = { x: 0, y: 0 };
    let cam = { s: 8, x: 0, y: 0 };
    const YAW = -0.62, TILT = 1.0;
    let grids: { x: number; top: number; w: number; s: number }[] = [];
    let axis = { x0: 0, x1: 0, yc: 0, bh: 0 };
    const AX = (v: number) => axis.x0 + ((v - data.axis.lo) / (data.axis.hi - data.axis.lo)) * (axis.x1 - axis.x0);

    function layout() {
      W = canvas.clientWidth; H = canvas.clientHeight;
      dpr = Math.min(2, window.devicePixelRatio || 1);
      canvas.width = Math.round(W * dpr); canvas.height = Math.round(H * dpr);
      mobile = W < 900;
      const top = 72;
      // พื้นที่วาดตารางและแกน มือถือใช้ครึ่งบนของจอ จอใหญ่ใช้ฝั่งขวา
      const R = mobile ? { x: 16, y: top + 8, w: W - 32, h: H * 0.5 - top } : { x: W * 0.47, y: H * 0.16, w: W * 0.5 - 24, h: H * 0.68 };
      const Hp = mobile ? { x: 8, y: H * 0.6, w: W - 16, h: H * 0.38 } : { x: W * 0.5, y: H * 0.14, w: W * 0.48, h: H * 0.8 };
      // ตาราง
      const span = data.studies.map((st) => st.cols + (st.cols / st.reps - 1) * 0.35);
      const totalCols = span.reduce((a, b) => a + b, 0) + 2 * 2.5;
      const maxRows = Math.max(...data.studies.map((s) => s.rows));
      cell = Math.min(R.w / totalCols, (R.h - 70) / maxRows, 15);
      dotSz = cell * 0.8;
      const gw = cell * totalCols;
      let x = R.x + (R.w - gw) / 2;
      const baseY = R.y + 30 + maxRows * cell + (R.h - 70 - maxRows * cell) / 2;
      grids = data.studies.map((st, s) => { const g = { x, top: baseY - st.rows * cell, w: span[s] * cell, s }; x += (span[s] + 2.5) * cell; return g; });
      // แกนผล
      axis = { x0: R.x + 8, x1: R.x + R.w - 8, yc: R.y + R.h * (mobile ? 0.34 : 0.46), bh: Math.min(96, R.h * (mobile ? 0.22 : 0.26)) };
      let start = 0;
      const startOf = data.studies.map((st) => { const v = start; start += st.n0; return v; });
      pts.forEach((p, k) => {
        const st = data.studies[p.s];
        const idx = k - startOf[p.s];
        const c = idx % st.cols, r = Math.floor(idx / st.cols);
        const cx = c + Math.floor(c / st.reps) * 0.35;
        p.gx = grids[p.s].x + cx * cell + cell / 2;
        p.gy = grids[p.s].top + r * cell + cell / 2;
      });
      // เมือง: พิกัดโลกเป็นหน่วยช่อง วัดจากกลางตาราง
      gridC = { x: grids[0].x + (grids[2].x + grids[2].w - grids[0].x) / 2, y: baseY - maxRows * cell / 2 };
      pts.forEach((p) => { p.u = (p.gx - gridC.x) / cell; p.v = (p.gy - gridC.y) / cell; });
      // หาขนาดเมืองในมุมเอียง แล้วใส่ให้พอดีพื้นที่
      const cs = Math.cos(YAW), sn = Math.sin(YAW), ct = Math.cos(TILT), st = Math.sin(TILT);
      let x0 = Infinity, x1 = -Infinity, y0 = Infinity, y1 = -Infinity;
      for (const p of pts) for (const [du, dv] of [[-0.5, -0.5], [0.5, 0.5], [-0.5, 0.5], [0.5, -0.5]]) {
        const u = p.u + du, v = p.v + dv, xr = u * cs - v * sn, yr = u * sn + v * cs;
        x0 = Math.min(x0, xr); x1 = Math.max(x1, xr);
        y0 = Math.min(y0, yr * ct - p.hz * st); y1 = Math.max(y1, yr * ct);
      }
      const sc = Math.min(Hp.w / (x1 - x0), Hp.h / (y1 - y0));
      cam = { s: sc, x: Hp.x + Hp.w / 2 - sc * (x0 + x1) / 2, y: Hp.y + Hp.h / 2 - sc * (y0 + y1) / 2 };
      const [c0, c1] = data.axis.ci;
      ansIdx.forEach((k, n) => { pts[k].ax = AX(c0 + (c1 - c0) * (n / (ansIdx.length - 1))); });
    }

    // ---------- ความคืบหน้าของการเลื่อน ----------
    function seqProgress() {
      const r = seq.getBoundingClientRect();
      const vh = window.innerHeight;
      const q = clamp((vh * 0.85 - r.top) / (r.height - vh * 0.3));
      if (!reduce) return q;
      return q < 0.04 ? 0 : q < 0.36 ? 0.3 : q < 0.62 ? 0.5 : 1;
    }

    function label(text: string, x: number, y: number, font: string, color: string, align: CanvasTextAlign = 'left') {
      ctx!.font = font; ctx!.fillStyle = color; ctx!.textAlign = align; ctx!.fillText(text, x, y);
    }

    // วาดเสาแบบเห็นสามด้าน ไล่จากหลังมาหน้า
    const SIDES: [number, number, number, number, number, number][] = [[0.5, -0.5, 0.5, 0.5, 1, 0], [-0.5, 0.5, -0.5, -0.5, -1, 0], [0.5, 0.5, -0.5, 0.5, 0, 1], [-0.5, -0.5, 0.5, -0.5, 0, -1]];
    function city(c3: number, now: number) {
      const yaw = (YAW + (reduce ? 0 : Math.sin(now * 0.00022) * 0.07)) * c3, tilt = TILT * c3;
      const cs = Math.cos(yaw), sn = Math.sin(yaw), ct = Math.cos(tilt), st = Math.sin(tilt);
      const S = lerp(cell, cam.s, c3), CX = lerp(gridC.x, cam.x, c3), CY = lerp(gridC.y, cam.y, c3);
      const half = 0.4;
      const P = (u: number, v: number, z: number): [number, number] => [CX + S * (u * cs - v * sn), CY + S * ((u * sn + v * cs) * ct - z * st)];
      // พื้นกระดาษกราฟ เส้นทุก 2 ช่อง
      ctx!.strokeStyle = `rgba(120,160,190,${0.05 + 0.07 * c3})`; ctx!.lineWidth = 1;
      ctx!.beginPath();
      for (let u = -40; u <= 40; u += 2) { const [a, b] = P(u, -22, 0), [c, e] = P(u, 22, 0); ctx!.moveTo(a, b); ctx!.lineTo(c, e); }
      for (let v = -22; v <= 22; v += 2) { const [a, b] = P(-40, v, 0), [c, e] = P(40, v, 0); ctx!.moveTo(a, b); ctx!.lineTo(c, e); }
      ctx!.stroke();
      // แสงนวลใต้เมือง
      const [gx, gy] = P(0, 0, 0);
      const gr = ctx!.createRadialGradient(gx, gy, 0, gx, gy, S * 34);
      gr.addColorStop(0, `rgba(63,179,166,${0.16 * c3})`); gr.addColorStop(1, 'rgba(63,179,166,0)');
      ctx!.fillStyle = gr; ctx!.fillRect(0, 0, W, H);
      const ord = pts.map((p, k) => [p.u * sn + p.v * cs, k]).sort((a, b) => a[0] - b[0]);
      for (const [, k] of ord) {
        const p = pts[k];
        const z = p.hz * c3;
        for (const [a1, b1, a2, b2, nx, ny] of SIDES) {
          const ny1 = nx * sn + ny * cs;
          if (ny1 <= 0.01 || z < 0.01) continue;
          const nx1 = nx * cs - ny * sn;
          const [x1, y1] = P(p.u + a1 * half * 2, p.v + b1 * half * 2, 0), [x2, y2] = P(p.u + a2 * half * 2, p.v + b2 * half * 2, 0);
          const [x3, y3] = P(p.u + a2 * half * 2, p.v + b2 * half * 2, z), [x4, y4] = P(p.u + a1 * half * 2, p.v + b1 * half * 2, z);
          ctx!.fillStyle = rgb(p.rgb, nx1 < 0 ? 0.72 : 0.48);
          ctx!.beginPath(); ctx!.moveTo(x1, y1); ctx!.lineTo(x2, y2); ctx!.lineTo(x3, y3); ctx!.lineTo(x4, y4); ctx!.closePath(); ctx!.fill();
        }
        const t = [[-1, -1], [1, -1], [1, 1], [-1, 1]].map(([a, b]) => P(p.u + a * half, p.v + b * half, z));
        ctx!.fillStyle = rgb(p.rgb, 1.08);
        ctx!.beginPath(); ctx!.moveTo(t[0][0], t[0][1]); for (let j = 1; j < 4; j++) ctx!.lineTo(t[j][0], t[j][1]); ctx!.closePath(); ctx!.fill();
      }
    }

    function draw(now: number) {
      if (!ctx) return;
      const q = seqProgress();
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, W, H);
      const fade12 = clamp((q - 0.38) / 0.1);
      const ans = clamp((q - 0.64) / 0.08);
      const lineP = ease(clamp((q - 0.8) / 0.08));
      const ptP = ease(clamp((q - 0.88) / 0.05));
      // c3 = 1 คือเมืองเอียงในฉากเปิด, 0 คือมองตรงจากด้านบนเป็นตาราง
      const c3 = 1 - ease(clamp((q - 0.02) / 0.26));
      if (c3 > 0.002) city(c3, now);

      // แถบเกณฑ์ บนพื้นของตัวเอง
      if (ans > 0) {
        const x0 = AX(-data.axis.margin), x1 = AX(data.axis.margin);
        ctx.globalAlpha = ans;
        ctx.fillStyle = 'rgba(11,15,22,0.9)'; ctx.fillRect(axis.x0 - 10, axis.yc - axis.bh / 2 - 34, axis.x1 - axis.x0 + 20, axis.bh + 84);
        ctx.fillStyle = 'rgba(63,179,166,0.14)'; ctx.strokeStyle = '#3fb3a6'; ctx.lineWidth = 1.5;
        const w = (x1 - x0) * (reduce ? 1 : ease(ans));
        ctx.fillRect((x0 + x1) / 2 - w / 2, axis.yc - axis.bh / 2, w, axis.bh);
        ctx.strokeRect((x0 + x1) / 2 - w / 2, axis.yc - axis.bh / 2, w, axis.bh);
        ctx.setLineDash([3, 4]); ctx.strokeStyle = '#5a6578'; ctx.beginPath(); ctx.moveTo(AX(0), axis.yc - axis.bh / 2); ctx.lineTo(AX(0), axis.yc + axis.bh / 2); ctx.stroke(); ctx.setLineDash([]);
        const fs = mobile ? 12 : 13;
        label(`เกณฑ์ ±${(data.axis.margin * 100).toFixed(1)} จุดที่ตั้งไว้ก่อนเริ่ม`, AX(0), axis.yc - axis.bh / 2 - 10, `${fs}px Sarabun`, '#9fe0d6', 'center');
        [-15, -10, -5, 0, 5, 10, 15].forEach((t) => label(t > 0 ? `+${t}` : t < 0 ? `−${-t}` : '0', AX(t / 100), axis.yc + axis.bh / 2 + 20, `${fs}px Sarabun`, '#8792a4', 'center'));
        label('ไฟล์เดียวดีกว่า', axis.x0, axis.yc + axis.bh / 2 + 40, `${fs}px Sarabun`, '#8792a4', 'left');
        label('Skills ดีกว่า', axis.x1, axis.yc + axis.bh / 2 + 40, `${fs}px Sarabun`, '#8792a4', 'right');
        ctx.globalAlpha = 1;
      }

      // จุด
      if (c3 <= 0.002) for (const k of order) {
        const p = pts[k];
        let x = p.gx, y = p.gy;
        let sz = dotSz;
        let a = 1;
        if (p.s < 2) a *= (1 - 0.72 * fade12) * (1 - ans);
        else if (!p.g) a *= 1 - ans;
        else {
          const e3 = ease(clamp((q - 0.66 - p.dl * 0.05) / 0.13));
          x = lerp(x, p.ax, e3);
          y = lerp(y, axis.yc + p.jy * axis.bh * (0.55 - 0.36 * lineP), e3);
          sz = lerp(sz, dotSz * 0.85, e3);
          a *= 1 - 0.15 * lineP;
          sz = lerp(sz, dotSz * 0.7, lineP);
        }
        if (a < 0.01) continue;
        ctx.globalAlpha = a;
        ctx.fillStyle = p.c;
        ctx.fillRect(x - sz / 2, y - sz / 2, sz, sz);
      }
      ctx.globalAlpha = 1;

      // ป้ายชื่อตาราง
      const la = clamp((q - 0.25) / 0.06);
      if (la > 0) {
        const fs = mobile ? 12 : 14;
        grids.forEach((g) => {
          const st = data.studies[g.s];
          let a = la;
          if (g.s < 2) a *= (1 - 0.5 * fade12) * (1 - ans); else a *= 1 - ans;
          if (a <= 0) return;
          ctx.globalAlpha = a;
          label(`ชุดที่ ${st.n}`, g.x, g.top - 10, `600 ${fs}px "Noto Serif Thai"`, '#ecedf0');
          if (!mobile || g.s === 2) label(`${st.usable} ครั้ง`, g.x + g.w, g.top - 10, `${fs - 1}px Sarabun`, '#8b95a7', 'right');
          if (fade12 > 0) { ctx.globalAlpha = a * fade12; label(st.verdict, g.x, g.top + data.studies[g.s].rows * cell + fs + 8, `600 ${fs}px Sarabun`, g.s === 2 ? '#3fb3a6' : '#8b95a7'); }
        });
        ctx.globalAlpha = 1;
      }

      // เส้นช่วงและจุดผล
      if (lineP > 0) {
        const [c0, c1] = data.axis.ci;
        const xl = AX(c0), xr = AX(c1), mid = (xl + xr) / 2;
        ctx.strokeStyle = '#ffffff'; ctx.lineWidth = mobile ? 2.5 : 3; ctx.lineCap = 'round';
        ctx.beginPath(); ctx.moveTo(lerp(mid, xl, lineP), axis.yc); ctx.lineTo(lerp(mid, xr, lineP), axis.yc); ctx.stroke();
      }
      if (ptP > 0) {
        ctx.beginPath(); ctx.arc(AX(data.axis.diff), axis.yc, (mobile ? 8 : 10) * ptP, 0, Math.PI * 2);
        ctx.fillStyle = '#3fb3a6'; ctx.fill(); ctx.lineWidth = 3; ctx.strokeStyle = '#0e131c'; ctx.stroke();
      }
    }

    // ---------- แผงที่ขยับตามการเลื่อน ----------
    const scrubs = [...document.querySelectorAll<HTMLElement>('[data-scrub]')];
    const pin = document.querySelector<HTMLElement>('[data-pin]');
    const wide = window.matchMedia('(min-width: 900px) and (min-height: 640px)');
    function scrub() {
      if (reduce) return;
      const vh = window.innerHeight;
      const pinned = wide.matches && pin;
      if (pinned) {
        const r = pin.getBoundingClientRect();
        pin.style.setProperty('--p', String(clamp(-r.top / Math.max(1, r.height - vh)) * 1.15));
      }
      for (const el of scrubs) {
        if (pinned && el.dataset.scrub === 'way') { el.style.removeProperty('--p'); continue; }
        const r = el.getBoundingClientRect();
        el.style.setProperty('--p', String(clamp((vh * 0.92 - r.top) / (vh * 0.55))));
      }
    }

    // ---------- วนวาด ----------
    let raf = 0;
    const heroVisible = () => window.scrollY < hero.offsetTop + hero.offsetHeight + window.innerHeight;
    function frame(now: number) {
      raf = 0;
      scrub();
      draw(now);
      if (!reduce && heroVisible()) raf = requestAnimationFrame(frame);
    }
    const kick = () => { if (!raf) raf = requestAnimationFrame(frame); };
    if (ctx) {
      layout();
      new ResizeObserver(() => { layout(); kick(); }).observe(canvas);
      document.fonts?.ready.then(kick);
    }
    window.addEventListener('scroll', kick, { passive: true });
    window.addEventListener('resize', kick);
    kick();

    // พิมพ์คำสั่งของผู้ใช้ทีละตัวอักษรเมื่อหน้าจอ terminal เข้าจอ ตัดตามกลุ่มตัวอักษรไทยไม่ให้สระลอย
    const term = document.querySelector<HTMLElement>('.term');
    const type = document.querySelector<HTMLElement>('.type');
    if (!reduce && term && type) {
      const text = type.dataset.text ?? '';
      const seg = 'Segmenter' in Intl ? [...new Intl.Segmenter('th', { granularity: 'grapheme' }).segment(text)].map((s) => s.segment) : [...text];
      type.textContent = '';
      const io = new IntersectionObserver((es) => {
        if (!es.some((e) => e.isIntersecting)) return;
        io.disconnect();
        let n = 0;
        const tick = () => { n++; type.textContent = seg.slice(0, n).join(''); if (n < seg.length) setTimeout(tick, 30); else term.classList.add('typed'); };
        setTimeout(tick, 300);
      }, { threshold: 0.5 });
      io.observe(term);
    }
  </script>
