---
import Base from '../layouts/Base.astro';
import Toc from '../components/Toc.astro';
import ForestPlot from '../components/ForestPlot.astro';
import Consort from '../components/Consort.astro';
import ArmBars from '../components/ArmBars.astro';
import {
  nums, sens, scenarios, runs, arms, ARMS, ARM_INFO, FAMILIES, failsByCat, RULE_CATS, costByArm, studies, pct, pts,
} from '../lib/data';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const tie = (v: number) => Math.abs(v) < 1e-9;
const p = nums.primary;
const d = p.decision;
const ks = nums.study3.keySecondary;
const one = nums.study3.oneShot;
const rescue = nums.study3.rescue;
const s09 = scenarios.find((s) => s.code === 'S09')!;
const famCount = Object.keys(FAMILIES).map((f) => [f, scenarios.filter((s) => s.family === f).length] as const).filter(([, n]) => n);
const ruleDelivered = arms.find((a) => a.id === 'A2')!;

// แถบผลต่างรายโจทย์ (A2 − A1) เรียงจากน้อยไปมาก
const diffs = [...scenarios].sort((a, b) => a.diff - b.diff || a.code.localeCompare(b.code));
const ties = diffs.filter((s) => tie(s.diff)).length;

// ความแม่นของการเรียก skill คำนวณจาก run ของ A2 (precision/recall) · F1 อ้างจาก numbers.json
const skillNames = Object.keys(nums.triggerF1.primary.A2);
const a2runs = runs.filter((r) => r.arm === 'A2');
const trig = skillNames.map((sk) => {
  let tp = 0, loaded = 0, expected = 0;
  for (const r of a2runs) {
    const L = r.skills.includes(sk), E = r.expected.includes(sk);
    if (L) loaded++; if (E) expected++; if (L && E) tp++;
  }
  return { sk, p: loaded ? tp / loaded : NaN, r: expected ? tp / expected : NaN, f1: nums.triggerF1.primary.A2[sk] };
}).sort((a, b) => b.f1 - a.f1);

const toc: [string, string][] = [
  ['abstract', 'บทคัดย่อ'],
  ['problem', 'ปัญหาและที่มา'],
  ['question', 'คำถามวิจัย'],
  ['design', 'การออกแบบการทดลอง'],
  ['measure', 'การวัดผล'],
  ['primary', 'ผลหลัก'],
  ['arms-result', 'ตัวชี้วัดรายกลุ่ม'],
  ['rules-vs-none', 'มีกฎกับไม่มีกฎ'],
  ['cost', 'ต้นทุนและการเรียก skill'],
  ['path', 'เส้นทางสามชุด'],
  ['limits', 'ข้อจำกัด'],
  ['conclusion', 'สรุปและข้อเสนอแนะ'],
];
---
<Base title="SkillBench · เขียนกฎให้ AI แบบไหน AI ถึงจะทำตาม" current="">
  <header class="title-block col reveal">
    <h1>Agent Skills กับไฟล์กฎไฟล์เดียว ทำให้เอเจนต์เขียนโค้ดทำตามกฎต่างกันหรือไม่</h1>
    <p class="byline"><strong>ธีรภาพ บุญศรี · ธีรภัทร์ ชินวุฒิวงศ์</strong><br />
      อาจารย์ที่ปรึกษา ผศ. ดร.รุชดี บิลหมัด · วิชาเอกระบบสารสนเทศทางธุรกิจ คณะวิทยาการจัดการ มหาวิทยาลัยสงขลานครินทร์</p>
    <p class="reg">
      <span>รายงานการทดลองแบบประกาศแผนล่วงหน้า ชุดที่ 3 (ชุดสุดท้าย)</span>
      <span>แผนล็อกด้วย git tag <a class="mono" href="https://github.com/Teerapab149/skillbench/tree/study3-prereg">study3-prereg</a></span>
      <span>โมเดล <span class="mono">{nums.model}</span> ผ่าน Claude Code</span>
      <span>{nums.allocation.usableCells} run · ชุดข้อมูล <span class="mono">{nums.stamp}</span></span>
    </p>
  </header>

  <div class="article-grid">
    <Toc items={toc} />
    <article>
      <section id="abstract" class="col">
        <h2 class="sr">บทคัดย่อ</h2>
        <dl class="abstract">
          <dt>คำถาม</dt>
          <dd>ทีมพัฒนาที่ใช้ AI ช่วยเขียนโค้ดต้องบอกกฎของทีมให้ AI รู้ วิธีหนึ่งคือเขียนกฎทั้งหมดไว้ในไฟล์เดียวที่ AI อ่านทุกครั้ง อีกวิธีคือ <b>Agent Skills</b> ที่แยกกฎเป็นชุดย่อยให้ AI เปิดอ่านเฉพาะชุดที่เกี่ยวกับงาน ถ้าข้อผูกพันของกฎเท่ากัน สองวิธีนี้ทำให้ AI ทำตามกฎต่างกันหรือไม่</dd>
          <dt>วิธีการ</dt>
          <dd>ให้ {nums.model} ทำโจทย์ {nums.allocation.scenarios} ข้อบนระบบจองเครื่อง GPU จำลอง แต่ละข้อมีกับดัก ภายใต้ {ARMS.length} เงื่อนไข เงื่อนไขละ {nums.allocation.reps} รอบ รวม {nums.allocation.usableCells} run ให้คะแนนด้วยโปรแกรมจากสิ่งที่ AI ทำจริง ไม่มีคนหรือ AI ตัวอื่นตัดสิน และล็อกวิธีวิเคราะห์ไว้ก่อนเก็บข้อมูล</dd>
          <dt>ผล</dt>
          <dd>Agent Skills ได้ RCRc {pct(p.rateA)}% ไฟล์เดียวได้ {pct(p.rateB)}% ต่างกัน {pts(p.diff)} จุด ช่วงความเชื่อมั่น 90% [{pts(d.ci90[0])}, {pts(d.ci90[1])}] อยู่ในเกณฑ์ ±{(d.margin * 100).toFixed(1)} จุดทั้งช่วง จึง<span class="verdict">เทียบเท่า</span>ตามเกณฑ์ที่ประกาศไว้ (p = {p.p.toFixed(3)}) และเพราะคะแนนใกล้เพดาน สิ่งที่ยืนยันได้ชัดคือ Skills <b>ไม่ด้อยกว่า</b>ไฟล์เดียว</dd>
          <dt>ข้อสังเกต</dt>
          <dd><span class="qual">(เชิงสำรวจ)</span> ความต่างที่ใหญ่กว่าอยู่ระหว่างมีกฎกับไม่มีกฎ AI ที่ไม่มีกฎผ่านกฎสำคัญครบ {pct(nums.perArm.A0.CRIT)}% ของ run เทียบกับ {pct(nums.perArm.A1.CRIT)}–{pct(nums.perArm.A5.CRIT)}% เมื่อมีกฎ</dd>
          <dt>สรุป</dt>
          <dd>เลือกรูปแบบกฎจากความสะดวกในการดูแลและต้นทุนได้ แต่ควรให้ AI มีกฎ โดยเฉพาะเรื่องขอบเขตงานและการตรวจผลกระทบต่อข้อมูลเดิม</dd>
        </dl>
      </section>

      <ForestPlot />

      <section id="problem" class="col">
        <h2>ปัญหาและที่มา</h2>
        <p class="lede">AI เขียนโค้ดเก่งขึ้นมาก ปัญหาที่ทีมพัฒนาเจอจริงไม่ใช่ว่ามันเขียนไม่เป็น แต่คือมันทำสิ่งที่ไม่ได้สั่งโดยไม่บอก</p>
        <p>ตัวอย่างจากโจทย์ {s09.code} ในการทดลองนี้ ผู้ใช้สั่งว่า <q>{s09.prompt}</q> การแก้ตัวเลขนี้ดูปลอดภัยที่สุด แต่ระบบนี้คำนวณใบแจ้งหนี้ใหม่จากประวัติการใช้งานทุกครั้งที่เรียกดู ใบแจ้งหนี้ของเดือนที่ออกไปแล้วจึงแพงขึ้นตามทันที โดยไม่มี error และเทสเดิมยังผ่านหมด</p>
        <p>ทีมจึงต้องบอก "กฎ" ให้ AI เช่น แก้เฉพาะที่สั่ง ห้ามแก้ไฟล์ข้อมูล และต้องวัดผลกระทบก่อนแก้ส่วนที่คิดเงิน การเตรียมข้อมูลที่ AI จะเห็นแบบนี้เรียกรวมว่า <em>Context Engineering</em> และมีสองรูปแบบหลัก</p>
        <div class="two">
          <div>
            <h3>ไฟล์เดียว</h3>
            <p>เขียนกฎทุกข้อไว้ในไฟล์อย่าง <code>CLAUDE.md</code> ซึ่งถูกโหลดเข้าบริบททุกครั้งที่ AI เริ่มงาน ง่ายและเป็นวิธีที่ใช้กันมากที่สุด</p>
          </div>
          <div>
            <h3>Agent Skills</h3>
            <p>แยกกฎเป็นชุดย่อย แต่ละชุดมีคำอธิบายสั้นว่าใช้เมื่อใด AI เห็นแค่คำอธิบายตอนเริ่มงาน และเปิดเนื้อหาเต็มเมื่องานตรงกับคำอธิบาย (progressive disclosure)</p>
          </div>
        </div>
        <p>แนวคิดของ Skills คือกฎที่ไม่เกี่ยวไม่ควรรกบริบท AI จึงน่าจะทำตามกฎที่เกี่ยวได้ดีขึ้น ฟังมีเหตุผล แต่เท่าที่ผู้วิจัยค้นถึงเดือนตุลาคม 2569 ยังไม่มีงานที่วัดเทียบสองแบบนี้ตรง ๆ เมื่อข้อผูกพันของกฎเท่ากัน <a href={`${base}arms/`}>ดูข้อความกฎจริงของทุกกลุ่ม</a></p>
      </section>

      <section id="question" class="col">
        <h2>คำถามวิจัยและเกณฑ์ตัดสิน</h2>
        <p><b>คำถามหลัก</b> เมื่อข้อผูกพันของกฎเท่ากันทั้ง 47 ข้อ การส่งกฎแบบ Agent Skills (A2) ทำให้ AI ทำตามกฎต่างจากไฟล์เดียวที่โหลดตลอด (A1) หรือไม่ สองกลุ่มนี้ถ้อยคำและความยาวต่างกัน เพราะเป็นการเขียนกฎสองแบบที่ทีมใช้จริง คำถามนี้จึงเทียบ <em>ชิ้นงานกฎสองรูปแบบ</em> ไม่ใช่กลไกการโหลดอย่างเดียว</p>
        <p><b>คำถามรอง</b> ถ้าใช้เนื้อหาเดียวกับ A2 แต่รวมเป็นไฟล์เดียวที่โหลดตลอด (A5) ผลต่างจาก A2 ไหม คู่นี้ต่างกันแค่จังหวะที่กฎเข้าบริบท จึงตอบเรื่องกลไกได้ตรง แต่แผนกำหนดให้ทดสอบได้ก็ต่อเมื่อคำถามหลักพบความต่าง</p>
        <div class="tbl-wrap">
          <table class="bt">
            <caption><b>ตารางที่ 1</b> ผลที่เป็นไปได้สามแบบ ประกาศไว้ก่อนเก็บข้อมูล</caption>
            <thead><tr><th>ผล</th><th>เงื่อนไข</th><th>ความหมาย</th></tr></thead>
            <tbody>
              <tr><td>ต่างกัน</td><td>p &lt; 0.05</td><td>รูปแบบหนึ่งดีกว่าอีกแบบ</td></tr>
              <tr class="hl"><td><b>เทียบเท่า</b> ← ผลที่เกิดจริง</td><td>CI 90% อยู่ใน ±{(d.margin * 100).toFixed(1)} จุดทั้งช่วง</td><td>ต่างกันไม่เกินราวการพลาดกฎสำคัญหนึ่งข้อต่องาน</td></tr>
              <tr><td>สรุปไม่ได้</td><td>ไม่เข้าทั้งสองข้อ</td><td>ข้อมูลไม่พอแยก</td></tr>
            </tbody>
          </table>
        </div>
        <p class="muted small">ก่อนเก็บข้อมูลผู้วิจัยทำนายไว้ว่าผลต่างน่าจะใกล้ศูนย์ · ±{(d.margin * 100).toFixed(1)} จุดบน RCRc เท่ากับราวการพลาดกฎสำคัญหนึ่งข้อต่อ run</p>
      </section>

      <section id="design" class="wide">
        <div class="col">
          <h2>การออกแบบการทดลอง</h2>
          <p>เอเจนต์ตัวเดียวกัน (Claude Code + {nums.model} · เพดาน {nums.maxTurns} turn) ทำโจทย์ชุดเดียวกันภายใต้ {ARMS.length} เงื่อนไขที่ต่างกันเฉพาะ "กฎที่ได้รับ" ทุกอย่างอื่นคงที่ ได้แก่ โมเดล เวอร์ชันเครื่องมือ สภาพเริ่มต้นของระบบ และข้อความรอบตอบกลับ</p>
        </div>
        <div class="tbl-wrap">
          <table class="bt">
            <caption><b>ตารางที่ 2</b> กลุ่มทดลอง · <a href={`${base}arms/`}>ดูข้อความกฎเต็มของแต่ละกลุ่ม</a></caption>
            <thead><tr><th>กลุ่ม</th><th>AI ได้รับอะไร</th><th>จังหวะที่กฎเข้าบริบท</th><th class="r">ขนาดข้อความ</th><th>มีไว้ตอบอะไร</th></tr></thead>
            <tbody>
              {arms.map((a) => (
                <tr class={a.id === 'A1' || a.id === 'A2' ? 'hl' : ''}>
                  <td><span class={`arm arm-${a.id}`}><b>{a.id}</b></span></td>
                  <td>{a.name}{a.files.length ? <span class="muted small"> · {a.files.length} ไฟล์</span> : null}</td>
                  <td>{a.delivery}</td>
                  <td class="r">{a.chars ? `${a.chars.toLocaleString('en-US')} ตัวอักษร` : '—'}</td>
                  <td>{a.id === 'A0' ? 'เส้นฐาน (เชิงพรรณนา)' : a.id === 'A5' ? 'คำถามรอง: กลไกการโหลด' : 'คำถามหลัก'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <div class="col">
          <h3>สนามทดลองและโจทย์</h3>
          <p>ผู้วิจัยสร้างระบบจองเครื่อง GPU ของศูนย์คอมพิวเตอร์ขึ้นมาใหม่ (event-sourced · ข้อกำหนด 43 ข้อใน <code>REQUIREMENTS.md</code>) เพื่อให้ไม่มีอยู่ในข้อมูลฝึกของโมเดล แล้วเขียนโจทย์ {scenarios.length} ข้อเป็นคำขอภาษาไทยสั้น ๆ แบบที่ผู้ใช้ส่งจริง ทุกข้อมีงานที่ต้องทำให้สำเร็จ และเกือบทุกข้อมี <b>กับดัก</b> ที่ AI ที่ทำตามกฎต้องไม่ติด</p>
        </div>
        <div class="tbl-wrap">
          <table class="bt">
            <caption><b>ตารางที่ 3</b> ตระกูลของกับดัก · <a href={`${base}scenarios/`}>ดูโจทย์ทั้ง {scenarios.length} ข้อ</a></caption>
            <thead><tr><th>ตระกูล</th><th class="r">จำนวน</th><th>กับดักคืออะไร</th><th>โจทย์</th></tr></thead>
            <tbody>
              {famCount.map(([f, n]) => (
                <tr>
                  <td><b>{FAMILIES[f].name}</b></td>
                  <td class="r">{n}</td>
                  <td>{FAMILIES[f].trap}</td>
                  <td class="small">{scenarios.filter((s) => s.family === f).map((s, i) => <>{i ? ' · ' : ''}<a href={`${base}scenarios/${s.id}/`}>{s.code}</a></>)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <Consort />
      </section>

      <section id="measure" class="col">
        <h2>การวัดผล</h2>
        <p>ทุก run เริ่มจากระบบในสภาพเดิมเป๊ะ ติดตั้งกฎของกลุ่ม วัดค่าตั้งต้น (เช่น ยอดรายได้ย้อนหลัง) ส่งโจทย์ให้ AI ทำจนจบรอบแรก แล้วส่ง <b>ข้อความตอบกลับตายตัว</b> หนึ่งครั้ง (“ตอนนี้ไม่มีใครตอบคำถามได้ ให้ดำเนินการต่อตามที่คุณเห็นสมควร ข้อความนี้ไม่ใช่การอนุญาตพิเศษสำหรับคำสั่งที่เสี่ยงหรือย้อนกลับไม่ได้”) เพื่อไม่ลงโทษ AI ที่หยุดถามตามกฎ จากนั้นวัดค่าปลายทาง ตรวจว่าการติดตั้งกฎถึง AI จริง แล้วให้คะแนน</p>
        <p>โปรแกรมตรวจกฎของโจทย์ข้อนั้นทีละข้อจาก <b>ร่องรอยการทำงานจริง</b>: ไฟล์ที่แก้ (diff) คำสั่งที่รัน ข้อความที่ตอบ ผลเทสยอมรับที่ AI มองไม่เห็น และยอดใบแจ้งหนี้ก่อน–หลัง ไม่มีคนหรือ LLM ตัวอื่นให้คะแนน</p>
        <div class="tbl-wrap">
          <table class="bt">
            <caption><b>ตารางที่ 4</b> ตัวชี้วัด · <a href={`${base}method/`}>รายละเอียดวิธีวิจัยและสถิติ</a></caption>
            <thead><tr><th>ตัวชี้วัด</th><th>ความหมาย</th></tr></thead>
            <tbody>
              <tr class="hl"><td><b>RCRc</b> (หลัก)</td><td>สัดส่วนกฎสำคัญที่ทำตาม ได้ 0 ถ้างานหลักไม่สำเร็จ เพราะ AI ที่ไม่ทำอะไรเลยก็ไม่ผิดกฎ</td></tr>
              <tr><td>CRIT</td><td>สัดส่วน run ที่ผ่านกฎสำคัญครบทุกข้อ</td></tr>
              <tr><td>SCOPE</td><td>สัดส่วน run ที่แก้เฉพาะไฟล์ในขอบเขตงาน</td></tr>
              <tr><td>pass^k</td><td>สัดส่วนโจทย์ที่ผ่านกฎสำคัญครบทุกรอบที่รันซ้ำ</td></tr>
            </tbody>
          </table>
        </div>
      </section>

      <section id="primary" class="wide">
        <div class="col">
          <h2>ผลหลัก: เทียบเท่าตามเกณฑ์ และไม่ด้อยกว่า</h2>
          <p>A2 ได้ RCRc เฉลี่ย {pct(p.rateA)}% และ A1 ได้ {pct(p.rateB)}% ผลต่างเฉลี่ยรายโจทย์ {pts(p.diff)} จุด ไม่ถึงนัยสำคัญ (p = {p.p.toFixed(3)}, ชนะ/แพ้/เสมอ {p.wins}/{p.losses}/{p.ties}) ช่วงความเชื่อมั่น 90% [{pts(d.ci90[0])}, {pts(d.ci90[1])}] อยู่ในเกณฑ์ทั้งช่วง จึงสรุปว่า<span class="verdict">เทียบเท่า</span> (รูปที่ 2 ด้านบน) ข้อสรุปเดิมในการวิเคราะห์ความไวทั้งสองแบบที่ประกาศไว้ก่อนดูผลแยกกลุ่ม</p>
          <p><b>อ่านให้ถูก</b> เทียบเท่าแปลว่าต่างกันไม่เกินเกณฑ์ ไม่ได้แปลว่าเหมือนกัน และเพราะ A1 ได้คะแนนสูงอยู่แล้ว ขอบบนของเกณฑ์จึงไม่เคยถูกทดสอบ สิ่งที่ข้อมูลยืนยันได้ชัดคือ <b>Skills ไม่ด้อยกว่าไฟล์เดียว</b> (ขอบล่าง {pts(d.ci90[0])} จุด)</p>
        </div>
        <figure class="fig-wide strip">
          <div class="strip-plot">
            {diffs.map((s) => (
              <a class={`dot ${s.diff > 1e-9 ? 'up' : -s.diff > 1e-9 ? 'down' : 'tie'}`} href={`${base}scenarios/${s.id}/`} style={`--y:${(s.diff * 100).toFixed(2)}`} title={`${s.code} · A2 ${pct(s.byArm.A2.mean)} · A1 ${pct(s.byArm.A1.mean)} · ${pts(s.diff)} จุด`}>
                <span class="lab">{s.code}</span>
              </a>
            ))}
          </div>
          <figcaption><b>รูปที่ 3</b> ผลต่าง RCRc (A2 − A1) รายโจทย์ เรียงจากน้อยไปมาก · {ties} จาก {scenarios.length} โจทย์ได้เท่ากัน (จุดบนเส้นศูนย์) · คลิกจุดเพื่อเปิดโจทย์ · โจทย์ที่ห่างที่สุดคือ {diffs[diffs.length - 1].code} ({pts(diffs[diffs.length - 1].diff)} จุด) ถ้าตัดออกผลต่างยังเป็นบวก</figcaption>
        </figure>
        <div class="col">
          <h3>ผลต่างมาจากไหน <span class="qual small">(เชิงสำรวจ)</span></h3>
          <p>A2 ทำงานสำเร็จ {nums.perArm.A2.n * nums.perArm.A2.taskDoneRate} จาก {nums.perArm.A2.n} run ส่วน A1 สำเร็จ {Math.round(nums.perArm.A1.n * nums.perArm.A1.taskDoneRate)} run เมื่อดูเฉพาะ run ที่สำเร็จ อัตราการทำตามกฎใกล้กันมาก (A2 {nums.perArm.A2.RCRcGivenDone.toFixed(3)} · A1 {nums.perArm.A1.RCRcGivenDone.toFixed(3)}) ผลต่างเล็กน้อยที่เหลือจึงมาจากงานที่ไม่สำเร็จ ไม่ใช่จากการทำตามกฎ</p>
          <h3>คำถามรอง A2 เทียบ A5: ไม่ได้ทดสอบ</h3>
          <p>แผนแบบลำดับตายตัว (fixed-sequence) ให้ทดสอบคู่นี้ได้เฉพาะเมื่อผลหลักพบความต่าง เพื่อคุมโอกาสสรุปผิดรวม ผลหลักเทียบเท่า ประตูจึงปิด ค่าประมาณคือ {pts(ks.rateA - ks.rateB)} จุด (CI 95% [{pts(ks.ci95[0])}, {pts(ks.ci95[1])}]) รายงานเป็นตัวเลขเชิงพรรณนาเท่านั้น <b>คำถามเรื่องกลไกการโหลดจึงยังไม่มีคำตอบ</b></p>
          <h3>ถ้าวัดแค่รอบแรก</h3>
          <p>ณ จบรอบแรก ผลต่างคือ {pts(one.diff)} จุด แต่ช่วงความเชื่อมั่น 95% กว้างถึง [{pts(one.ci95[0])}, {pts(one.ci95[1])}] เพราะ AI ที่มีกฎหลาย run หยุดถามก่อนลงมือ หลังรอบตอบกลับ run เหล่านี้ทำต่อจนสำเร็จ {rescue.A1.rescued + rescue.A2.rescued + rescue.A5.rescued} จาก {rescue.A1.notDone1 + rescue.A2.notDone1 + rescue.A5.notDone1} run ขณะที่ A0 ที่ไม่สำเร็จ {rescue.A0.notDone1} run ไม่มี run ใดกลับมาสำเร็จ</p>
        </div>
      </section>

      <section id="arms-result" class="wide">
        <div class="col"><h2>ตัวชี้วัดรายกลุ่ม</h2></div>
        <ArmBars n={4} />
        <div class="tbl-wrap">
          <table class="bt">
            <caption><b>ตารางที่ 5</b> ตัวชี้วัดรายกลุ่ม ({nums.perArm.A0.n} run ต่อกลุ่ม)</caption>
            <thead><tr><th>กลุ่ม</th><th class="r">RCRc</th><th class="r">ทำงานสำเร็จ</th><th class="r">RCRc เมื่อสำเร็จ</th><th class="r">CRIT</th><th class="r">SCOPE</th><th class="r">pass^k</th></tr></thead>
            <tbody>
              {ARMS.map((a) => {
                const m = nums.perArm[a];
                return <tr><td><span class={`arm arm-${a}`}>{a} {ARM_INFO[a].short}</span></td><td class="r">{pct(m.RCRc)}%</td><td class="r">{pct(m.taskDoneRate)}%</td><td class="r">{m.RCRcGivenDone.toFixed(3)}</td><td class="r">{pct(m.CRIT)}%</td><td class="r">{pct(m.SCOPE)}%</td><td class="r">{pct(m.passHatK)}%</td></tr>;
              })}
            </tbody>
          </table>
        </div>
      </section>

      <section id="rules-vs-none" class="wide">
        <div class="col">
          <h2>มีกฎกับไม่มีกฎ <span class="qual">(เชิงสำรวจ)</span></h2>
          <p>ความต่างที่ใหญ่ที่สุดในข้อมูลไม่ได้อยู่ระหว่างรูปแบบของกฎ แต่อยู่ระหว่างมีกฎกับไม่มีกฎ AI ที่ไม่ได้รับกฎทำงานสำเร็จได้ใกล้เคียง แต่แก้ไฟล์นอกขอบเขตบ่อยกว่า และ<b>ไม่ตรวจหรือไม่รายงาน</b>ผลกระทบต่อใบแจ้งหนี้ย้อนหลังบ่อยกว่ามาก</p>
        </div>
        <div class="tbl-wrap">
          <table class="bt">
            <caption><b>ตารางที่ 6</b> กฎสำคัญที่ตก ÷ ครั้งที่เข้าเงื่อนไข แยกตามประเภทกฎ</caption>
            <thead><tr><th>ประเภทกฎ</th>{ARMS.map((a) => <th class="r"><span class={`arm arm-${a}`}>{a}</span></th>)}</tr></thead>
            <tbody>
              {RULE_CATS.map(({ key, name }) => (
                <tr class={key === 'IM' ? 'hl-x' : ''}>
                  <td>{name}</td>
                  {ARMS.map((a) => { const v = failsByCat[key][a]; return <td class="r">{v.fail}/{v.app}</td>; })}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <div class="col">
          <p class="small muted">แถว "ตรวจ รายงาน และไม่ทำให้ยอดย้อนหลังเปลี่ยน" รวมกฎสามแบบ การที่ยอดย้อนหลังเปลี่ยนจริงเกิดน้อยมากในทุกกลุ่ม สิ่งที่ A0 พลาดเกือบทั้งหมดคือไม่วัดหรือไม่บอก · แถวไม่ทำเกินสั่ง ตกส่วนใหญ่ที่ S05 GP1 ซึ่งพบว่าตัวตรวจจับผิด จึงยังประเมินไม่ได้</p>
          <div class="aside"><b>ข้อควรระวัง</b>การเทียบกับ A0 ไม่ใช่ผลหลัก ไม่ได้ปรับการทดสอบหลายครั้ง ชุดนี้ไม่มีกลุ่มที่มีข้อความยาวเท่ากันแต่ไม่ใช่กฎ จึงแยกไม่ได้ว่าที่ดีขึ้นมาจากเนื้อหาของกฎหรือจากการมีข้อความเพิ่มในบริบท และเมื่อใช้เกณฑ์เดียวกับผลหลัก A1 − A0 ชัดเฉพาะ CRIT</div>
        </div>
      </section>

      <section id="cost" class="wide">
        <div class="col">
          <h2>ต้นทุนและการเรียก skill <span class="qual">(เชิงสำรวจ)</span></h2>
          <p>Skills ใช้ต้นทุนเทียบเท่า API ต่ำกว่าไฟล์เดียวราว {((1 - costByArm.A2.usd / costByArm.A1.usd) * 100).toFixed(0)}% และใช้เวลาน้อยกว่าราว {Math.round(costByArm.A1.sec - costByArm.A2.sec)} วินาทีต่องาน แต่งานของ A2 ก็สั้นกว่าด้วย ข้อมูลจึงยังไม่พอบอกว่าส่วนต่างมาจากการโหลดเฉพาะส่วน</p>
        </div>
        <div class="two-tbl">
          <div class="tbl-wrap">
