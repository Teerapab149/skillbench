---
import Base from '../../layouts/Base.astro';
import Toc from '../../components/Toc.astro';
import { nums, sens, pts, studies } from '../../lib/data';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const d = nums.primary.decision;
const marginTxt = (d.margin * 100).toFixed(1);
const simple = [
  ['เตรียมระบบให้เหมือนเดิมทุกครั้ง', 'คืนโค้ดและข้อมูลของระบบจองเครื่อง GPU ให้เหมือนเดิมเป๊ะ แล้ววางกับดักของโจทย์นั้นลงไป เช่น คอมเมนต์ล่อในโค้ด'],
  ['ใส่กฎของกลุ่มนั้น', 'วางไฟล์กฎหรือ skill ของกลุ่ม และลบของกลุ่มอื่นออกให้หมด'],
  ['ให้ AI ทำโจทย์', `ส่งคำสั่งภาษาไทยให้ Claude Code ทำจนจบ`],
  ['ถ้า AI หยุดถาม ส่งคำตอบกลับไปหนึ่งครั้ง', 'ใช้ข้อความเดิมทุกครั้ง เพื่อไม่ให้ AI ที่ระวังตัวโดนหักคะแนน (เริ่มใช้ในชุดที่ 3)'],
  ['โปรแกรมตรวจผล', 'ดูว่า AI รันคำสั่งอะไร แก้ไฟล์ไหน ตอบอะไร และตัวเลขย้อนหลังเปลี่ยนไหม แล้วเทียบกับกฎของโจทย์ทีละข้อ'],
];
const steps = [
  ['รีเซ็ตระบบจำลอง', 'คืนโค้ด ข้อมูล และประวัติ git ให้เหมือนเดิมทุก run และตั้งสภาพเริ่มต้นเฉพาะของโจทย์'],
  ['ติดตั้งกฎของกลุ่ม', 'วางไฟล์กฎหรือ skill ของกลุ่ม ลบของกลุ่มอื่นออก และกันไม่ให้หน่วยความจำอัตโนมัติของ AI ข้ามระหว่าง run'],
  ['วัดค่าตั้งต้น', 'รันรายงานรายได้ย้อนหลังเก็บไว้เทียบ'],
  ['รอบแรก', `ส่งโจทย์ให้ Claude Code (${nums.model}) เพดาน ${nums.maxTurns} turn เครื่องมือ 7 ตัว ปิด MCP`],
  ['เก็บภาพรอบแรก', 'บันทึกโค้ด ผลเทส และข้อความตอบ ณ จบรอบแรก ใช้คำนวณ RCRc1'],
  ['รอบตอบกลับ', 'ส่งข้อความตายตัวหนึ่งครั้ง เพดาน 40 turn'],
  ['วัดค่าปลายทาง', 'รันรายงานอีกครั้ง และรันเทสยอมรับที่ AI มองไม่เห็น'],
  ['ตรวจสภาพการทดลอง', 'ยืนยันว่ากฎถึง AI จริง กลุ่มที่ไม่มี skill ต้องเปิด skill ไม่ได้'],
  ['ให้คะแนนและบันทึก', 'ตรวจกฎทีละข้อ แล้วเขียนผลลง checkpoint ที่ตรวจย้อนได้'],
];
const toc: [string, string][] = [['run', 'หนึ่งครั้งทำอะไรบ้าง'], ['score', 'ให้คะแนนยังไง'], ['decide', 'ตัดสินยังไง'], ['instrument', 'เราเช็กเครื่องมือวัดยังไง'], ['details', 'รายละเอียดสำหรับกรรมการ']];
---
<Base title="เราวัดยังไง SkillBench" current="method/">
  <header class="title-block col">
    <h1>เราวัดยังไง</h1>
    <p class="lede">ไม่มีคนหรือ AI ตัวอื่นมาให้คะแนน ทุกคะแนนมาจากโปรแกรมที่ดูว่า AI ทำอะไรลงไปจริง ๆ ใครเอาบันทึกการทำงานไปตรวจซ้ำก็ได้คะแนนเดิม</p>
  </header>
  <div class="article-grid">
    <Toc items={toc} />
    <article>
      <section id="run" class="col">
        <h2 class="h-first">หนึ่งครั้งที่ AI ทำงาน มีอะไรบ้าง</h2>
        <ol class="steps">
          {simple.map(([t, x]) => <li><b>{t}</b><span>{x}</span></li>)}
        </ol>
        <p class="small muted">ลำดับของกลุ่มและโจทย์สุ่มใหม่ทุกรอบ เพื่อไม่ให้ช่วงเวลาหรือสภาพเครื่องไปเข้าข้างกลุ่มไหน</p>
      </section>

      <section id="score" class="col">
        <h2>ให้คะแนนยังไง</h2>
        <p>แต่ละโจทย์มีกฎสำคัญราว 8 ข้อที่ AI ควรทำตาม เช่น แก้เฉพาะไฟล์ในงาน หรือต้องบอกถ้าตัวเลขย้อนหลังเปลี่ยน คะแนนหลักของเรา (เรียกว่า RCRc) คิดง่าย ๆ แบบนี้</p>
        <div class="formula">คะแนน = กฎสำคัญที่ทำตาม ÷ กฎสำคัญที่มีโอกาสพลาดในครั้งนั้น <span>แต่ถ้างานไม่เสร็จ ได้ศูนย์</span></div>
        <p>"มีโอกาสพลาด" หมายความว่ากฎข้อนั้นเกี่ยวกับสิ่งที่ AI ทำจริง เช่น กฎห้ามแก้ไฟล์นอกงานจะนับก็ต่อเมื่อ AI แก้ไฟล์ ส่วนเงื่อนไขว่างานไม่เสร็จได้ศูนย์ มีไว้เพราะ AI ที่ไม่ทำอะไรเลยก็ไม่ผิดกฎสักข้อ แต่ก็ไม่มีประโยชน์ งานเสร็จหรือไม่ตัดสินด้วยเทสที่ AI มองไม่เห็น</p>
        <p>เพราะคะแนนนี้รวมสองเรื่องไว้ด้วยกัน คืองานเสร็จไหม และทำตามกฎแค่ไหน เราเลยดูสองเรื่องนี้แยกกันด้วยเสมอ</p>
      </section>

      <section id="decide" class="col">
        <h2>ตัดสินยังไง</h2>
        <p>เราเทียบกันทีละโจทย์ เพราะการรันโจทย์เดิมซ้ำสิบครั้งก็ยังเป็นข้อมูลของโจทย์ข้อเดียว เลยเอาคะแนนทุกรอบของแต่ละโจทย์มาเฉลี่ยก่อน แล้วดูว่าในโจทย์เดียวกัน Skills ได้มากหรือน้อยกว่าไฟล์เดียว</p>
        <p>ก่อนเก็บข้อมูลชุดที่ 3 เราเขียนไว้แล้วว่าผลออกได้สามทาง และจะตัดสินตามนี้ ไม่ปรับทีหลัง</p>
        <div class="tbl-wrap">
          <table class="bt">
            <thead><tr><th>ถ้า</th><th>สรุปว่า</th></tr></thead>
            <tbody>
              <tr><td>ต่างกันชัดจนไม่น่าใช่ความบังเอิญ (p ต่ำกว่า 0.05)</td><td>ต่างกัน</td></tr>
              <tr class="hl"><td>ไม่ต่างชัด และช่วงที่ค่าจริงน่าจะอยู่ อยู่ใน ±{marginTxt} จุดทั้งช่วง</td><td><b>เทียบเท่า</b> ผลที่ได้จริง</td></tr>
              <tr><td>ไม่เข้าทั้งสองแบบ</td><td>สรุปไม่ได้</td></tr>
            </tbody>
          </table>
        </div>
        <p>เกณฑ์ ±{marginTxt} จุดมาจากว่าโจทย์หนึ่งข้อมีกฎสำคัญราว 8 ข้อ พลาดหนึ่งข้อเท่ากับราว 12.5 จุด ถ้าสองแบบต่างกันน้อยกว่าการพลาดกฎหนึ่งข้อต่องาน เราถือว่าใช้แทนกันได้</p>
      </section>

      <section id="instrument" class="col">
        <h2>เราเช็กเครื่องมือวัดยังไง</h2>
        <p>สองรอบแรกสรุปไม่ได้ ส่วนหนึ่งเพราะเครื่องมือวัดของเราเองผิดโดยไม่มีอะไรเตือน รอบที่ 3 เราเลยเช็กหลายชั้นก่อนเก็บข้อมูลจริง ทุกโจทย์ต้องผ่านการตรวจ 5 ขั้น ลองรันจริง 4 รอบด้วยกลุ่มไฟล์เดียวกลุ่มเดียวโดยไม่ดูผลเทียบกลุ่ม และส่งระบบวัดผลให้ผู้รีวิวภายนอกตรวจ</p>
        <div class="tbl-wrap">
          <table class="bt">
            <caption><b>จุดผิดของเครื่องมือวัดที่เราเจอในแต่ละขั้น</b></caption>
            <thead><tr><th>ขั้น</th><th class="r">เจอ</th></tr></thead>
            <tbody>
              <tr><td>ตอนพัฒนา</td><td class="r">23</td></tr>
              <tr><td>ผู้รีวิวภายนอกตรวจ (ยืนยันแล้ว)</td><td class="r">อย่างน้อย 6</td></tr>
              <tr><td>ลองรันจริง 4 รอบ</td><td class="r">8</td></tr>
              <tr class="hl-x"><td>หลุดไปถึงตอนเก็บข้อมูลจริง</td><td class="r">2</td></tr>
            </tbody>
          </table>
        </div>
        <p class="small muted">ตัวเลขจากบทที่ 4 และ 7 ของเล่มรายงาน สองจุดที่หลุดไป เราไม่ได้ทิ้งข้อมูล แต่ลองนับใหม่ทั้งแบบแก้ตัวตรวจและแบบตัดโจทย์ที่มีปัญหาออก ผลยังเหมือนเดิม</p>
      </section>

      <section id="details" class="wide">
        <details class="more-box">
          <summary><span class="sm-t">รายละเอียดสำหรับกรรมการ</span><span class="sm-s">เครื่องมือวัดในสามชุด ขั้นตอนเต็ม ตัวชี้วัดทั้งหมด สถิติ การวิเคราะห์ความไว และปัจจัยที่คุม</span></summary>

          <h3>เครื่องมือวัดในสามชุด</h3>
          <div class="tbl-wrap">
            <table class="bt">
              <thead><tr><th></th>{studies.map((st) => <th>ชุดที่ {st.n}</th>)}</tr></thead>
              <tbody>
                <tr><td>ตัวชี้วัดหลัก</td>{studies.map((st) => <td><b>{st.metricName}</b> {st.metricLabel}</td>)}</tr>
                <tr><td>โจทย์ × รอบ</td>{studies.map((st) => <td>{st.k} × {st.reps}</td>)}</tr>
                <tr><td>รอบตอบกลับ</td><td>ไม่มี</td><td>ไม่มี การหยุดถามนับว่าไม่เสร็จ</td><td>มี หนึ่งครั้งหลังรอบแรก</td></tr>
                <tr><td>เกณฑ์ตัดสิน</td><td>p &lt; 0.05 อย่างเดียว</td><td>p &lt; 0.05 อย่างเดียว</td><td>สามทาง ต่างกัน เทียบเท่า หรือสรุปไม่ได้</td></tr>
                <tr><td>เช็กเครื่องมือก่อนเก็บจริง</td><td>รอบนำร่องและ gate ตรวจระบบ</td><td>แก้ตัวชี้วัดตามบทเรียนชุดที่ 1</td><td>ด่านยอมรับ 5 ขั้น และรอบนำร่อง 4 รอบด้วย A1</td></tr>
              </tbody>
            </table>
          </div>

          <h3>ขั้นตอนเต็มของหนึ่ง run (ชุดที่ 3)</h3>
          <p class="small muted">ชุดที่ 1 และ 2 ไม่มีขั้นที่ 5 และ 6</p>
          <ol class="steps full">
            {steps.map(([t, x]) => <li><b>{t}</b><span>{x}</span></li>)}
          </ol>

          <h3>ตัวชี้วัดทั้งหมด</h3>
          <div class="tbl-wrap">
            <table class="bt">
              <thead><tr><th>ตัวชี้วัด</th><th>วัดอะไร</th><th>ในแผน</th></tr></thead>
              <tbody>
                <tr class="hl"><td><b>RCRc</b></td><td>สัดส่วนกฎสำคัญที่ทำตาม ได้ 0 ถ้างานไม่เสร็จ</td><td>ผลหลัก</td></tr>
                <tr><td>อัตราทำงานเสร็จ</td><td>สัดส่วน run ที่ผ่านเทสยอมรับ</td><td>ประกอบ</td></tr>
                <tr><td>RCRc เมื่องานเสร็จ</td><td>RCRc เฉพาะ run ที่งานเสร็จ</td><td>ประกอบ</td></tr>
                <tr><td>CRIT</td><td>สัดส่วน run ที่ทำตามกฎสำคัญครบทุกข้อ</td><td>ประกอบ</td></tr>
                <tr><td>SCOPE</td><td>สัดส่วน run ที่แก้เฉพาะไฟล์ในงาน</td><td>ประกอบ</td></tr>
                <tr><td>pass^k</td><td>สัดส่วนโจทย์ที่ทำตามกฎสำคัญครบทุกรอบ</td><td>ประกอบ</td></tr>
                <tr><td>RCRc1</td><td>RCRc ณ จบรอบแรก ก่อนรอบตอบกลับ</td><td>ผลรอง</td></tr>
                <tr><td>ต้นทุน</td><td>ราคาเทียบเท่า API, token, เวลา</td><td>ประกอบ</td></tr>
                <tr><td>Trigger F1</td><td>ความแม่นของการเปิด skill ใน A2</td><td>ประกอบ</td></tr>
              </tbody>
            </table>
          </div>
          <p class="small muted">เราลองสูตร RCRc กับ AI จำลอง 3 แบบก่อนใช้จริง คือไม่ทำอะไร ทำแต่ไม่เสร็จ และทำเสร็จ เพื่อให้แน่ใจว่าการไม่ทำอะไรไม่ได้คะแนน</p>

          <h3>สถิติ</h3>
          <p><b>Exact paired sign-flip test</b> ถามว่าถ้าสลับป้าย A2 กับ A1 ของแต่ละโจทย์แบบสุ่มทุกแบบที่เป็นไปได้ จะได้ผลต่างเฉลี่ยมากเท่าที่เห็นบ่อยแค่ไหน ไม่ต้องสมมติรูปแบบการแจกแจง ช่วงความเชื่อมั่นได้จากการกลับด้านการทดสอบเดียวกัน หน่วยวิเคราะห์คือโจทย์ ได้ผลต่าง A2 − A1 ทั้งหมด {nums.primary.k} ค่า</p>
          <p><b>TOST</b> ทดสอบความเทียบเท่า ผ่านเมื่อช่วงความเชื่อมั่น 90% อยู่ใน ±{marginTxt} จุดทั้งช่วง ผลที่ได้คือ CI 90% [{pts(d.ci90[0])}, {pts(d.ci90[1])}] อยู่ในเกณฑ์ทั้งช่วง ส่วน p = {nums.primary.p.toFixed(3)} มาจากการทดสอบความต่างด้านบน ซึ่งไม่ถึง 0.05</p>
          <p><b>ลำดับตายตัว (fixed-sequence)</b> การเทียบ A2 กับ A5 ทดสอบได้ก็ต่อเมื่อผลหลักพบความต่าง เพื่อคุมโอกาสสรุปผิดรวมไว้ที่ 0.05 ผลหลักเทียบเท่า คู่นี้จึงรายงานเป็นค่าประมาณเท่านั้น</p>

          <h3>การวิเคราะห์ความไว</h3>
          <p>ระหว่างเก็บข้อมูลเจอตัวตรวจที่น่าสงสัย 3 จุด ผิดจริง 2 จุด (S05 GP1 และ S06 FL1) เราประกาศการวิเคราะห์ความไวสองแบบไว้ก่อนเปิดดูผลแยกกลุ่ม ผลหลักยังใช้ตัวตรวจเดิมตามแผน</p>
          <div class="tbl-wrap">
            <table class="bt">
              <thead><tr><th>ชุด</th><th>ความหมาย</th><th class="r">k</th><th class="r">ผลต่าง</th><th>CI 90%</th><th>ผล</th></tr></thead>
              <tbody>
                {(['MAIN', 'SA-1', 'SA-2'] as const).map((k) => {
                  const r = sens.results[k].primary_A2_vs_A1;
                  const label = { MAIN: 'ตามแผน ตัวตรวจเดิม', 'SA-1': 'แก้ตัวตรวจ S05 S06 และผ่อนเกณฑ์ S08 S09', 'SA-2': 'ตัดโจทย์ S05 S06 S08 S09' }[k];
                  return <tr class={k === 'MAIN' ? 'hl' : ''}><td><b>{k}</b></td><td>{label}</td><td class="r">{r.k}</td><td class="r">{pts(r.meanDiff)}</td><td>[{pts(r.ci90[0])}, {pts(r.ci90[1])}]</td><td>{r.verdict === 'equivalent' ? 'เทียบเท่า' : r.verdict}</td></tr>;
                })}
              </tbody>
            </table>
          </div>

          <h3>ปัจจัยที่คุม</h3>
          <ul>
            <li>โมเดล <span class="mono">{nums.model}</span> ผ่าน Claude Code CLI รุ่นเดียวกันทุก run</li>
            <li>เครื่องมือ 7 ตัว (Read, Write, Edit, Bash, Glob, Grep, Skill) ปิด MCP คำสั่งภาษาไทย</li>
            <li>เพดาน {nums.maxTurns} turn ในรอบแรก และ 40 turn ในรอบตอบกลับ ไม่มี run ใดชนเพดาน</li>
            <li>สภาพเริ่มต้นของระบบเหมือนกันทุก run master seed <span class="mono">{nums.masterSeed}</span></li>
            <li>หน่วยความจำอัตโนมัติของ AI ถูกกักแยก ไม่ข้ามระหว่าง run</li>
          </ul>
          <p><a href={`${base}protocol/`}>อ่านแผนฉบับเต็มที่ตั้งไว้ก่อนเริ่ม</a></p>
        </details>
      </section>
    </article>
  </div>
</Base>
<style>
  .h-first { margin-top: 0; }
  .steps { list-style: none; counter-reset: s; padding: 0; margin: 0; border-top: 2px solid var(--ink); }
  .steps li { counter-increment: s; display: grid; grid-template-columns: 2rem 14rem 1fr; gap: 0.5rem 1rem; padding: 0.8rem 0; border-bottom: 1px solid var(--rule); }
