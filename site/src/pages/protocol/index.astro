---
import Base from '../../layouts/Base.astro';
import { marked } from 'marked';
import { docs } from '../../lib/data';
const sections = [
  { id: 'prereg-1', title: 'แผนล่วงหน้าของชุดที่ 1', file: 'PRE-REGISTRATION.md', note: 'แผนของการทดลองชุดที่ 1 รวมการแก้ไข (Amendment) ที่บันทึกไว้ก่อนเก็บข้อมูล', md: docs.prereg1 },
  { id: 'prereg-2', title: 'แผนล่วงหน้าของชุดที่ 2', file: 'PRE-REGISTRATION-2.md', note: 'เขียนหลังเห็นผลชุดที่ 1 และก่อนเก็บข้อมูลชุดที่ 2', md: docs.prereg2 },
  { id: 'prereg-3', title: 'แผนล่วงหน้าของชุดที่ 3', file: 'PRE-REGISTRATION-3.md', note: 'ล็อกด้วย git tag study3-prereg เมื่อ 5 ต.ค. 2569 ก่อนเก็บข้อมูลหลัก', md: docs.prereg3 },
  { id: 'deviations', title: 'บันทึกส่วนเบี่ยงเบนจากแผนของชุดที่ 3', file: 'DEVIATIONS-3.md', note: 'บันทึกและ commit ก่อนเปิดดูผลแยกกลุ่ม', md: docs.deviations },
  { id: 'requirements', title: 'ข้อกำหนดของระบบจำลอง', file: 'fixtures/gpu-booking/REQUIREMENTS.md', note: 'เอกสารที่เอเจนต์ทุกกลุ่มใช้อ้างอิงระหว่างทำโจทย์', md: docs.requirements },
].map((s) => ({ ...s, html: marked.parse(s.md, { async: false }) as string }));
---
<Base title="เอกสารแผน SkillBench" current="protocol/">
  <header class="title-block col">
    <h1>แผนที่ประกาศไว้ก่อนเก็บข้อมูลทั้งสามชุด ส่วนเบี่ยงเบน และข้อกำหนดของระบบ</h1>
    <p class="lede" style="margin-top:1rem">เอกสารเหล่านี้แสดงเนื้อหาตามต้นฉบับใน repository ปรับเฉพาะเครื่องหมายคั่นวลีให้อ่านง่ายขึ้น เอกสารทำงานบางส่วนเขียนระหว่างใช้ Claude เป็นเครื่องมือ จึงมีถ้อยคำที่เรียก Claude ว่า "ผู้ช่วย" หรือ "ผู้ออกแบบ"</p>
    <nav class="tabs" aria-label="เอกสาร">{sections.map((s) => <a href={`#${s.id}`}>{s.title}</a>)}</nav>
  </header>
  {sections.map((s) => (
    <section id={s.id} class="docsec">
      <div class="doc-head">
        <h2>{s.title}</h2>
        <p class="small muted">{s.note} <a href={`https://github.com/Teerapab149/skillbench/blob/main/${s.file}`}>ดูบน GitHub</a></p>
      </div>
      <div class="doc" set:html={s.html} />
    </section>
  ))}
</Base>
<style>
  .tabs { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1.5rem; }
  .tabs a { font-family: var(--mono); font-size: 0.9rem; border: 1px solid var(--rule); padding: 0.25rem 0.75rem; text-decoration: none; color: var(--ink-2); }
  .tabs a:hover { border-color: var(--ink); color: var(--ink); }
  .docsec { border-top: 3px solid var(--ink); margin-top: 4rem; padding-top: 0.5rem; }
  .doc-head h2 { margin-top: 1rem; }
</style>
