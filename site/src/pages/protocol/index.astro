---
import Base from '../../layouts/Base.astro';
import { renderDoc } from '../../lib/md';
import { docs } from '../../lib/data';
const sections = [
  { id: 'prereg-1', title: 'แผนของชุดที่ 1', file: 'PRE-REGISTRATION.md', note: 'แผนของการทดลองชุดที่ 1 รวมการแก้ไข (Amendment) ที่บันทึกไว้ก่อนเก็บข้อมูล', md: docs.prereg1 },
  { id: 'prereg-2', title: 'แผนของชุดที่ 2', file: 'PRE-REGISTRATION-2.md', note: 'เขียนหลังเห็นผลชุดที่ 1 และก่อนเก็บข้อมูลชุดที่ 2', md: docs.prereg2 },
  { id: 'prereg-3', title: 'แผนของชุดที่ 3', file: 'PRE-REGISTRATION-3.md', note: 'ล็อกด้วย git tag study3-prereg เมื่อ 5 ต.ค. 2569 ก่อนเก็บข้อมูลหลัก', md: docs.prereg3 },
  { id: 'deviations', title: 'สิ่งที่ไม่เป็นไปตามแผนในชุดที่ 3', file: 'DEVIATIONS-3.md', note: 'บันทึกและ commit ก่อนเปิดดูผลแยกกลุ่ม', md: docs.deviations },
  { id: 'requirements', title: 'ข้อกำหนดของระบบที่ AI ใช้', file: 'fixtures/gpu-booking/REQUIREMENTS.md', note: 'เอกสารที่ AI ทุกกลุ่มใช้อ้างอิงระหว่างทำโจทย์', md: docs.requirements },
].map((s) => ({ ...s, html: renderDoc(s.md) }));
---
<Base title="แผนก่อนเริ่ม SkillBench" current="protocol/">
  <header class="title-block col">
    <h1>แผนที่เราเขียนไว้ก่อนเริ่ม</h1>
    <p class="lede">ก่อนเก็บข้อมูลทุกรอบ เราเขียนแผนไว้ก่อนว่าจะวัดอะไร และจะตัดสินผลยังไง แล้วล็อกไว้บน GitHub เพื่อไม่ให้ปรับทีหลังตามผลที่ออกมา หน้านี้คือแผนทั้งสามฉบับ สิ่งที่ไม่เป็นไปตามแผน และข้อกำหนดของระบบที่ AI ใช้ทำงาน เอกสารเป็นภาษาทำงานของเราตามต้นฉบับ (ตัดแค่เครื่องหมายคั่นวลี) บางส่วนเขียนตอนใช้ Claude ช่วย เลยมีคำที่เรียก Claude ว่า "ผู้ช่วย" หรือ "ผู้ออกแบบ"</p>
    <nav class="tabs" aria-label="เอกสาร">{sections.map((s) => <a href={`#${s.id}`}>{s.title}</a>)}</nav>
  </header>
  {sections.map((s) => (
    <section id={s.id} class="docsec">
      <div class="doc-head">
        <h2>{s.title}</h2>
        <p class="small muted">{s.note} <a href={`https://github.com/Teerapab149/skillbench/blob/main/${s.file}`}>ดูบน GitHub</a></p>
      </div>
      <div class="doc" set:html={s.html} />
    </section>
  ))}
</Base>
<style>
  .tabs { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1.5rem; }
  .tabs a { font-family: var(--mono); font-size: 0.9rem; border: 1px solid var(--rule); padding: 0.25rem 0.75rem; text-decoration: none; color: var(--ink-2); }
  .tabs a:hover { border-color: var(--ink); color: var(--ink); }
  .docsec { border-top: 3px solid var(--ink); margin-top: 4rem; padding-top: 0.5rem; }
  .doc-head h2 { margin-top: 1rem; }
</style>
