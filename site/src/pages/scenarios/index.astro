---
import Base from '../../layouts/Base.astro';
import { scenarios, studies, FAMILIES, DIFFICULTY, pts, tie } from '../../lib/data';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const fams = Object.keys(FAMILIES).filter((f) => scenarios.some((s) => s.family === f));
const old = scenarios.filter((s) => s.usedIn.length === 3).length;
---
<Base title="โจทย์ทั้งหมด SkillBench" current="scenarios/">
  <header class="title-block col">
    <h1>โจทย์ {scenarios.length} ข้อ: งานที่สั่ง กับดักที่ซ่อนอยู่ และผลในแต่ละชุด</h1>
    <p class="lede" style="margin-top:1rem">ทุกโจทย์เป็นคำขอภาษาไทยสั้น ๆ บนระบบจองเครื่อง GPU จำลอง มีงานที่ต้องทำให้สำเร็จ และเกือบทุกข้อมีกับดักที่ AI ที่ทำตามกฎต้องไม่ติด โจทย์ {old} ข้อแรกใช้ในทั้งสามชุด (ชุดที่ 3 แก้ตัวตรวจบางข้อ) ส่วนอีก {scenarios.length - old} ข้อเพิ่มในชุดที่ 3</p>
  </header>

  <div class="filters" role="group" aria-label="กรองตามตระกูลกับดัก">
    <div class="seg">
      <button type="button" aria-pressed="true" data-fam="">ทั้งหมด {scenarios.length}</button>
      {fams.map((f) => <button type="button" aria-pressed="false" data-fam={f}>{FAMILIES[f].name} {scenarios.filter((s) => s.family === f).length}</button>)}
    </div>
  </div>

  <div class="tbl-wrap">
    <table class="bt sc-table">
      <caption>ตัวเลขทางขวาคือผลต่าง A2 ลบ A1 ของโจทย์นั้นในแต่ละชุด ชุดที่ 1 วัดด้วย CRIT ชุดที่ 2 และ 3 วัดด้วย RCRc ช่องว่างคือชุดที่ไม่ได้ใช้โจทย์นั้น</caption>
      <thead><tr><th>โจทย์</th><th>คำสั่งของผู้ใช้</th>{studies.map((st) => <th class="r st">ชุดที่ {st.n}</th>)}</tr></thead>
      <tbody>
        {scenarios.map((s) => (
          <tr data-fam={s.family}>
            <td class="code"><a href={`${base}scenarios/${s.id}/`} class="mono">{s.code}</a></td>
            <td>
              <a class="prompt" href={`${base}scenarios/${s.id}/`}>{s.prompt}</a>
              <span class="meta small">{s.familyName}, ความยาก{DIFFICULTY[s.difficulty] ?? s.difficulty}, อ้าง {s.reqs.join(' ')}</span>
            </td>
            {studies.map((st) => {
              const ps = s.perStudy.find((x) => x.study.n === st.n)?.ps;
              if (!ps) return <td class="r st"></td>;
              const d = ps.diff;
              return <td class={`r st ${tie(d) ? 'eq' : d > 0 ? 'up' : 'down'}`}>{tie(d) ? 'เท่ากัน' : pts(d)}</td>;
            })}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</Base>
<style>
  .filters { margin-bottom: 0.5rem; position: sticky; top: 3.3rem; background: var(--paper); z-index: 5; padding: 0.75rem 0; border-bottom: 1px solid var(--rule); }
  .sc-table caption { color: var(--ink-3); font-size: 0.95rem; caption-side: top; text-align: left; padding: 0.5rem 0 0.75rem; }
  .sc-table tr[hidden] { display: none; }
  .sc-table td { padding-top: 0.9rem; padding-bottom: 0.9rem; }
  .code a { color: var(--ink-3); text-decoration: none; font-weight: 500; }
  .prompt { display: block; color: var(--ink); text-decoration: none; font-size: 1.05rem; line-height: 1.6; }
  .prompt:hover { color: var(--teal); }
  .meta { color: var(--ink-3); }
  .st { white-space: nowrap; width: 5.5rem; font-size: 0.95rem; }
  .st.up { color: var(--a2); font-weight: 600; } .st.down { color: var(--a1); font-weight: 600; } .st.eq { color: var(--ink-3); }
  @media (max-width: 700px) { .st { width: auto; font-size: 0.82rem; padding-left: 0.3rem !important; padding-right: 0.3rem !important; } }
</style>
<script>
  const btns = [...document.querySelectorAll<HTMLButtonElement>('button[data-fam]')];
  const rows = [...document.querySelectorAll<HTMLTableRowElement>('.sc-table tbody tr')];
  btns.forEach((b) => b.addEventListener('click', () => {
    btns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    const f = b.dataset.fam;
    rows.forEach((r) => { r.hidden = !!f && r.dataset.fam !== f; });
  }));
</script>
