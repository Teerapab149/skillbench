---
import Base from '../../layouts/Base.astro';
import { scenarios, FAMILIES, DIFFICULTY, ARMS, ARM_INFO, pct, pts } from '../../lib/data';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const fams = Object.keys(FAMILIES).filter((f) => scenarios.some((s) => s.family === f));
const tie = (v: number) => Math.abs(v) < 1e-9;
---
<Base title="โจทย์ 22 ข้อ · SkillBench" current="scenarios/">
  <header class="title-block col">
    <h1>โจทย์ทั้ง {scenarios.length} ข้อ: งานที่สั่ง กับดักที่ซ่อนอยู่ และผลของแต่ละกลุ่ม</h1>
    <p class="lede" style="margin-top:1rem">ทุกโจทย์เป็นคำขอภาษาไทยสั้น ๆ บนระบบจองเครื่อง GPU จำลอง มีงานที่ต้องทำให้สำเร็จ และเกือบทุกข้อมีกับดักที่ AI ที่ทำตามกฎต้องไม่ติด คลิกโจทย์เพื่อดูกฎที่ใช้ให้คะแนนและผลทีละ run</p>
  </header>

  <div class="filters" role="group" aria-label="กรองตามตระกูล">
    <div class="seg">
      <button type="button" aria-pressed="true" data-fam="">ทั้งหมด {scenarios.length}</button>
      {fams.map((f) => <button type="button" aria-pressed="false" data-fam={f}>{FAMILIES[f].name} {scenarios.filter((s) => s.family === f).length}</button>)}
    </div>
    <p class="legend small">RCRc เฉลี่ย 3 รอบ: {ARMS.map((a) => <span class={`arm arm-${a}`}>{a} {ARM_INFO[a].short}</span>)}</p>
  </div>

  <ol class="sc-list">
    {scenarios.map((s) => (
      <li data-fam={s.family}>
        <a href={`${base}scenarios/${s.id}/`}>
          <span class="code mono">{s.code}</span>
          <span class="main">
            <span class="prompt">{s.prompt}</span>
            <span class="meta small"><b>{s.familyName}</b> · {DIFFICULTY[s.difficulty] ?? s.difficulty} · {s.reqs.join(', ')} · กฎสำคัญ {s.rules.filter((r) => r.sev === 'critical').length} ข้อ</span>
          </span>
          <span class="scores" aria-label={ARMS.map((a) => `${a} ${pct(s.byArm[a].mean, 0)}%`).join(' ')}>
            {ARMS.map((a) => (
              <span class="sc-bar"><i class={`arm-${a}`} style={`height:${(s.byArm[a].mean * 100).toFixed(1)}%`}></i><em>{pct(s.byArm[a].mean, 0)}</em></span>
            ))}
          </span>
          <span class={`diff ${s.diff > 1e-9 ? 'up' : -s.diff > 1e-9 ? 'down' : ''}`}>{tie(s.diff) ? 'เท่ากัน' : pts(s.diff)}<small>A2−A1</small></span>
        </a>
      </li>
    ))}
  </ol>
</Base>
<style>
  .filters { display: flex; flex-direction: column; gap: 0.75rem; margin-bottom: 1rem; position: sticky; top: 3.3rem; background: var(--paper); z-index: 5; padding: 0.75rem 0; border-bottom: 1px solid var(--rule); }
  .legend { display: flex; flex-wrap: wrap; gap: 0.25rem 1rem; color: var(--ink-3); margin: 0; }
  .sc-list { list-style: none; padding: 0; margin: 0; border-top: 2px solid var(--ink); }
  .sc-list li[hidden] { display: none; }
  .sc-list a { display: grid; grid-template-columns: 3.2rem minmax(0, 1fr) auto 5.5rem; gap: 1.25rem; align-items: center; padding: 1rem 0.25rem; border-bottom: 1px solid var(--rule); text-decoration: none; color: var(--ink); }
  .sc-list a:hover { background: var(--paper-2); }
  .sc-list a:hover .prompt { color: var(--teal); }
  .code { font-weight: 500; color: var(--ink-3); }
  .main { display: flex; flex-direction: column; gap: 0.2rem; min-width: 0; }
  .prompt { font-size: 1.05rem; line-height: 1.6; }
  .meta { color: var(--ink-3); }
  .meta b { color: var(--ink-2); font-weight: 600; }
  .scores { display: grid; grid-template-columns: repeat(4, 1.6rem); gap: 0.3rem; height: 3.4rem; align-items: end; }
  .sc-bar { position: relative; height: 100%; display: flex; flex-direction: column; justify-content: flex-end; border-bottom: 1px solid var(--ink-3); }
  .sc-bar i { display: block; background: var(--c); }
  .sc-bar em { position: absolute; top: -1.2rem; left: -0.3rem; right: -0.3rem; text-align: center; font-style: normal; font-size: 0.7rem; color: var(--ink-3); }
  .diff { text-align: right; font-weight: 600; line-height: 1.2; display: flex; flex-direction: column; }
  .diff small { font-weight: 400; color: var(--ink-3); font-size: 0.75rem; }
  .diff.up { color: var(--a2); } .diff.down { color: var(--a1); }
  @media (max-width: 760px) {
    .sc-list a { grid-template-columns: 2.6rem minmax(0, 1fr); }
    .scores, .diff { grid-column: 2; }
    .scores { grid-template-columns: repeat(4, 1.4rem); margin-top: 1rem; }
    .diff { flex-direction: row; gap: 0.5rem; text-align: left; }
  }
</style>
<script>
  const btns = [...document.querySelectorAll<HTMLButtonElement>('[data-fam]')].filter((b) => b.tagName === 'BUTTON');
  const items = [...document.querySelectorAll<HTMLLIElement>('.sc-list li')];
  btns.forEach((b) => b.addEventListener('click', () => {
    btns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    const f = b.dataset.fam;
    items.forEach((li) => { li.hidden = !!f && li.dataset.fam !== f; });
  }));
</script>
