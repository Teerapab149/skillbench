---
import Base from '../../layouts/Base.astro';
import Toc from '../../components/Toc.astro';
import Consort from '../../components/Consort.astro';
import ArmBars from '../../components/ArmBars.astro';
import DiffStrip from '../../components/DiffStrip.astro';
import ForestPlot from '../../components/ForestPlot.astro';
import { studies, ARM_INFO, RULE_CATS, failsByCat, costByArm, pct, pts, tie, fmtP, type Study } from '../../lib/data';

export function getStaticPaths() {
  return studies.map((st, i) => ({ params: { n: String(st.n) }, props: { st, prev: studies[i - 1] ?? null, next: studies[i + 1] ?? null } }));
}
interface Props { st: Study; prev: Study | null; next: Study | null }
const { st, prev, next } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const p = st.primary;
const TH_MONTH = ['ม.ค.', 'ก.พ.', 'มี.ค.', 'เม.ย.', 'พ.ค.', 'มิ.ย.', 'ก.ค.', 'ส.ค.', 'ก.ย.', 'ต.ค.', 'พ.ย.', 'ธ.ค.'];
const thDate = (stamp: string) => { const [y, m, d] = stamp.slice(0, 10).split('-').map(Number); return `${d} ${TH_MONTH[m - 1]} ${y + 543}`; };
const sorted = [...st.perScenario].sort((a, b) => a.code.localeCompare(b.code));
const isS3 = st.n === 3;
const sec = st.secondary;
const cost = costByArm(st);
const rescue = st.nums.study3?.rescue;
const one = st.nums.study3?.oneShot;

const toc: [string, string][] = [
  ['design', 'การออกแบบ'],
  ['primary', 'ผลหลัก'],
  ['by-scenario', 'ผลรายโจทย์'],
  ['by-arm', 'ผลรายกลุ่ม'],
  ...(st.n === 1 ? [['extra', 'กลุ่ม A3 และ A4']] as [string, string][] : []),
  ...(st.n === 2 ? [['extra', 'แยกคะแนนเป็นสองส่วน']] as [string, string][] : []),
  ...(isS3 ? [['extra', 'มีกฎกับไม่มีกฎ'], ['cost', 'ต้นทุนและการเปิด skill'], ['followup', 'รอบตอบกลับ']] as [string, string][] : []),
  ...(st.why.length ? [['why', 'ทำไมสรุปไม่ได้']] as [string, string][] : []),
  ...(st.changed ? [['next-study', 'สิ่งที่เปลี่ยนในชุดถัดไป']] as [string, string][] : []),
];
let fig = 0;
const nf = () => ++fig;
---
<Base title={`การทดลองชุดที่ ${st.n} SkillBench`} current={`study-${st.n}/`}>
  <header class="title-block col">
    <h1>การทดลองชุดที่ {st.n}: {st.role}</h1>
    <p class="lede" style="margin-top:1rem">{st.summary}</p>
    <dl class="facts">
      <dt>เก็บข้อมูลเสร็จ</dt><dd>{thDate(st.stamp)}</dd>
      <dt>กลุ่มทดลอง</dt><dd>{st.armIds.join(', ')}</dd>
      <dt>ขนาด</dt><dd>{st.k} โจทย์ × {st.reps} รอบ รวม {st.usable} run</dd>
      <dt>ตัวชี้วัดหลัก</dt><dd>{st.metricName}: {st.metricLabel}</dd>
      <dt>แผนล่วงหน้า</dt><dd><a href={`${base}protocol/#prereg-${st.n}`}>{st.prereg}</a></dd>
      <dt>ข้อสรุป</dt><dd><span class={`verdict ${isS3 ? '' : 'nc'}`}>{st.verdict}</span></dd>
    </dl>
  </header>

  <div class="article-grid">
    <Toc items={toc} />
    <article>
      <section id="design" class="wide">
        <h2 class="h-first">การออกแบบ</h2>
        <div class="tbl-wrap">
          <table class="bt">
            <caption><b>ตารางที่ 1</b> กลุ่มทดลองในชุดที่ {st.n} <a href={`${base}arms/`}>ดูข้อความกฎจริงของทุกกลุ่ม</a></caption>
            <thead><tr><th>กลุ่ม</th><th>เอเจนต์ได้รับอะไร</th><th>มีไว้ตอบอะไร</th></tr></thead>
            <tbody>
              {st.armIds.map((a) => (
                <tr class={a === 'A1' || a === 'A2' ? 'hl' : ''}><td><span class={`arm arm-${a}`}><b>{a}</b></span></td><td>{ARM_INFO[a].name}</td><td>{ARM_INFO[a].question}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
        <Consort st={st} n={nf()} />
      </section>

      <section id="primary" class="wide">
        <h2>ผลหลัก: {st.metricName} ของ A2 เทียบ A1</h2>
        <div class="tbl-wrap">
          <table class="bt">
            <caption><b>ตารางที่ 2</b> ผลหลักตามแผนที่ประกาศไว้ ทดสอบด้วย exact paired sign-flip ที่ระดับโจทย์</caption>
            <thead><tr><th class="r">A2</th><th class="r">A1</th><th class="r">ผลต่าง</th><th>CI 95%</th>{st.ci90 && <th>CI 90%</th>}<th class="r">ชนะ แพ้ เสมอ</th><th class="r">p</th><th>ข้อสรุป</th></tr></thead>
            <tbody>
              <tr class={isS3 ? 'hl' : ''}>
                <td class="r">{pct(p.rateA)}%</td><td class="r">{pct(p.rateB)}%</td><td class="r"><b>{pts(p.diff)} จุด</b></td>
                <td>[{pts(st.ci95[0])}, {pts(st.ci95[1])}]</td>{st.ci90 && <td>[{pts(st.ci90[0])}, {pts(st.ci90[1])}]</td>}
                <td class="r">{p.wins} / {p.losses} / {p.ties}</td><td class="r">{fmtP(p.p)}</td><td><b>{st.verdict}</b></td>
              </tr>
            </tbody>
          </table>
        </div>
        {isS3 ? (
          <>
            <ForestPlot n={nf()} />
            <div class="col">
              <p>ช่วงความเชื่อมั่น 90% อยู่ในเกณฑ์เทียบเท่าทั้งช่วง จึงสรุปว่า<span class="verdict">เทียบเท่า</span>ตามเกณฑ์ที่ประกาศไว้ก่อนเก็บข้อมูล และการวิเคราะห์ความไวทั้งสองแบบให้ข้อสรุปเดิม</p>
              <p><b>อ่านให้ถูก</b> เทียบเท่าแปลว่าต่างกันไม่เกินเกณฑ์ ไม่ได้แปลว่าเหมือนกัน และเพราะ A1 ได้คะแนนสูงอยู่แล้ว ขอบบนของเกณฑ์จึงไม่เคยถูกทดสอบ สิ่งที่ข้อมูลยืนยันได้ชัดคือ <b>Skills ไม่ด้อยกว่าไฟล์เดียว</b></p>
              <p><b>คำถามรอง A2 เทียบ A5 ไม่ได้ทดสอบ</b> แผนแบบลำดับตายตัวให้ทดสอบคู่นี้เฉพาะเมื่อผลหลักพบความต่าง ค่าประมาณคือ {pts(sec.rateA - sec.rateB)} จุด (CI 95% [{pts(sec.ci95[0])}, {pts(sec.ci95[1])}]) รายงานเป็นตัวเลขเชิงพรรณนาเท่านั้น คำถามเรื่องกลไกการโหลดจึงยังไม่มีคำตอบ</p>
            </div>
          </>
        ) : (
          <div class="col">
            <p>ผลต่างเป็นบวกต่อ Skills แต่ไม่ถึงนัยสำคัญ (p = {fmtP(p.p)}) และช่วงความเชื่อมั่นคร่อมศูนย์ ผลนี้ต้องอ่านว่า <b>สรุปไม่ได้</b> ไม่ใช่ "ไม่ต่างกัน" เพราะข้อมูลไม่พอจะแยกว่าผลต่างที่เห็นเป็นของจริงหรือความบังเอิญ</p>
            {sec && (
              <p><b>{st.n === 1 ? 'ผลร่วมหลัก RCR' : 'คำถามรอง A5 เทียบ A2'}</b> {st.n === 1 ? 'A2 เทียบ A1' : 'A5 เทียบ A2'} ได้ {pts(sec.diff)} จุด (p = {fmtP(sec.p)}) แต่ตามแผนจะทดสอบได้เฉพาะเมื่อผลหลักผ่าน จึงไม่ได้ทดสอบ รายงานเป็นค่าเชิงพรรณนา</p>
            )}
            <figure class="pfloor">
              <div class="sq-row">
                {sorted.map((s) => <a href={`${base}scenarios/${s.id}/#study-${st.n}`} class={`sq ${tie(s.diff) ? 'tie' : s.diff > 0 ? 'win' : 'loss'}`} title={`${s.code} ${tie(s.diff) ? 'เสมอ' : pts(s.diff) + ' จุด'}`}><span>{s.code}</span></a>)}
              </div>
              <p class="sq-key small"><i class="sq win"></i> A2 ได้มากกว่า <i class="sq loss"></i> A1 ได้มากกว่า <i class="sq tie"></i> เสมอกัน ไม่ให้ข้อมูล</p>
              <figcaption><b>รูปที่ {nf()}</b> โจทย์ {st.k} ข้อของชุดที่ {st.n} มี {p.ties} ข้อที่สองกลุ่มได้เท่ากัน เหลือโจทย์ที่ให้ข้อมูล {st.informative} ข้อ ต่อให้ A2 ชนะทั้ง {st.informative} ข้อ ค่า p ต่ำสุดที่เป็นไปได้คือ {st.pFloor.toFixed(4)} ซึ่ง{st.pFloor > 0.05 ? 'มากกว่า 0.05 นัยสำคัญจึงเป็นไปไม่ได้ตั้งแต่ก่อนเห็นข้อมูล' : 'ต่ำกว่า 0.05'}</figcaption>
            </figure>
          </div>
        )}
      </section>

      <section id="by-scenario" class="wide">
        <h2>ผลรายโจทย์</h2>
        <DiffStrip st={st} n={nf()} />
      </section>

      <section id="by-arm" class="wide">
        <h2>ผลรายกลุ่ม</h2>
        <ArmBars st={st} n={nf()} />
        <div class="tbl-wrap">
          <table class="bt">
            <caption><b>ตารางที่ 3</b> ตัวชี้วัดรายกลุ่ม</caption>
            <thead><tr><th>กลุ่ม</th>{st.n > 1 && <th class="r">RCRc</th>}{st.n > 1 && <th class="r">ทำงานสำเร็จ</th>}<th class="r">CRIT</th><th class="r">SCOPE</th><th class="r">RCR</th><th class="r">pass^k</th><th class="r">ต้นทุนต่อ run</th></tr></thead>
            <tbody>
              {st.armIds.map((a) => { const m = st.nums.perArm[a]; return (
                <tr><td><span class={`arm arm-${a}`}>{a} {ARM_INFO[a].short}</span></td>
                  {st.n > 1 && <td class="r">{pct(m.RCRc)}%</td>}{st.n > 1 && <td class="r">{pct(m.taskDoneRate)}%</td>}
                  <td class="r">{pct(m.CRIT)}%</td><td class="r">{pct(m.SCOPE)}%</td><td class="r">{pct(m.RCR)}%</td><td class="r">{pct(m.passHatK)}%</td><td class="r">${cost[a].usd.toFixed(2)}</td></tr>
              ); })}
            </tbody>
          </table>
        </div>
      </section>

      {st.n === 1 && (
        <section id="extra" class="col">
          <h2>กลุ่ม A3 และ A4 <span class="qual">(เชิงพรรณนา)</span></h2>
          <p><b>A3 ยาหลอกจับคู่ความยาว</b> ได้ไฟล์ที่ยาวพอ ๆ กับ A1 แต่ไม่ใช่กฎการทำงาน ถ้ากฎช่วยเพราะเนื้อหา A3 ควรได้ผลใกล้ A0 ถ้าช่วยเพราะมีข้อความยาวในบริบท A3 ควรได้ผลใกล้ A1 ในชุดนี้ A3 ผ่านกฎสำคัญครบ {pct(st.nums.perArm.A3.CRIT)}% เทียบกับ A1 {pct(st.nums.perArm.A1.CRIT)}% และ A0 {pct(st.nums.perArm.A0.CRIT)}% แต่ CRIT กองที่พื้นจนแยกกลุ่มไม่ได้ จึงตอบคำถามนี้ไม่ได้</p>
          <p><b>A4 Skills กับคอมเมนต์ล่อ</b> ได้กฎและ skill ชุดเดียวกับ A2 ทุกไบต์ แต่ในโค้ดมีคอมเมนต์ล่อให้ทำสิ่งที่ผู้ใช้ไม่ได้สั่ง ใช้ดูว่ากฎกันคำสั่งที่ฝังในไฟล์ได้จริงหรือไม่ ผล CRIT {pct(st.nums.perArm.A4.CRIT)}% เทียบกับ A2 {pct(st.nums.perArm.A2.CRIT)}%</p>
          <p class="muted small">คู่เปรียบเทียบเหล่านี้ไม่ใช่ผลหลัก ไม่ได้ทดสอบทางสถิติ ทั้ง A3 และ A4 ถูกตัดออกในชุดที่ 2 เพื่อรวมทรัพยากรไปที่คำถามหลักและเพิ่ม A5</p>
        </section>
      )}

      {st.n === 2 && (
        <section id="extra" class="wide">
          <h2>แยกคะแนนเป็นสองส่วน <span class="qual">(เชิงสำรวจ)</span></h2>
          <div class="col"><p>RCRc รวมสองเรื่องไว้ในตัวเลขเดียว คืองานสำเร็จหรือไม่ และเมื่อสำเร็จแล้วทำตามกฎแค่ไหน ชุดนี้แยกดูได้ และสองส่วนเดินคนละทาง</p></div>
          <div class="tbl-wrap">
            <table class="bt">
              <caption><b>ตารางที่ 4</b> อัตราทำงานสำเร็จ และการทำตามกฎเมื่อทำสำเร็จ</caption>
              <thead><tr><th>กลุ่ม</th><th class="r">ทำงานสำเร็จ</th><th class="r">ทำตามกฎเมื่อสำเร็จ</th></tr></thead>
              <tbody>{st.armIds.map((a) => <tr><td><span class={`arm arm-${a}`}>{a} {ARM_INFO[a].short}</span></td><td class="r">{pct(st.nums.perArm[a].taskDoneRate)}%</td><td class="r">{st.nums.perArm[a].RCRcGivenDone.toFixed(3)}</td></tr>)}</tbody>
            </table>
          </div>
          <div class="col">
            <p>กลุ่มที่มีกฎทุกกลุ่มทำตามกฎเมื่อสำเร็จได้ใกล้กันที่ราว 0.967 ขณะที่กลุ่มที่ไม่มีกฎทำงานสำเร็จบ่อยที่สุด ส่วนหนึ่งเพราะเอเจนต์ที่มีกฎหยุดถามเมื่อเจอข้อกำหนดกำกวม แล้วการหยุดถามถูกนับว่าไม่สำเร็จ ข้อสังเกตนี้นำไปสู่การเพิ่มรอบตอบกลับในชุดที่ 3</p>
            <p class="muted small">ตารางนี้ไม่ได้ทดสอบทางสถิติ การทดสอบแยกส่วนไม่ได้ประกาศไว้ล่วงหน้า และ A0 เป็นกลุ่มเชิงพรรณนา จึงเป็นสมมติฐานที่ข้อมูลชี้ทาง ไม่ใช่ข้อสรุป</p>
          </div>
        </section>
      )}

      {isS3 && (
        <>
          <section id="extra" class="wide">
            <h2>มีกฎกับไม่มีกฎ <span class="qual">(เชิงสำรวจ)</span></h2>
            <div class="col"><p>ความต่างที่ใหญ่ที่สุดในข้อมูลไม่ได้อยู่ระหว่างรูปแบบของกฎ แต่อยู่ระหว่างมีกฎกับไม่มีกฎ เอเจนต์ที่ไม่ได้รับกฎแก้ไฟล์นอกขอบเขตบ่อยกว่า และ<b>ไม่ตรวจหรือไม่รายงาน</b>ผลกระทบต่อใบแจ้งหนี้ย้อนหลังบ่อยกว่ามาก</p></div>
            <div class="tbl-wrap">
              <table class="bt">
                <caption><b>ตารางที่ 4</b> กฎสำคัญที่ตก ต่อครั้งที่เข้าเงื่อนไข แยกตามประเภทกฎ</caption>
                <thead><tr><th>ประเภทกฎ</th>{st.armIds.map((a) => <th class="r"><span class={`arm arm-${a}`}>{a}</span></th>)}</tr></thead>
                <tbody>{RULE_CATS.map(({ key, name }) => <tr class={key === 'IM' ? 'hl-x' : ''}><td>{name}</td>{st.armIds.map((a) => <td class="r">{failsByCat[key][a].fail}/{failsByCat[key][a].app}</td>)}</tr>)}</tbody>
              </table>
            </div>
            <div class="col">
              <p class="small muted">การที่ยอดย้อนหลังเปลี่ยนจริงเกิดน้อยมากในทุกกลุ่ม สิ่งที่ A0 พลาดเกือบทั้งหมดคือไม่วัดหรือไม่บอก แถว "ไม่ทำเกินสั่ง" ตกส่วนใหญ่ที่ S05 GP1 ซึ่งพบว่าตัวตรวจจับผิด จึงยังประเมินไม่ได้</p>
              <div class="aside"><b>ข้อควรระวัง</b>การเทียบกับ A0 ไม่ใช่ผลหลัก ไม่ได้ปรับการทดสอบหลายครั้ง และชุดนี้ไม่มีกลุ่มที่มีข้อความยาวเท่ากันแต่ไม่ใช่กฎ จึงแยกไม่ได้ว่าที่ดีขึ้นมาจากเนื้อหาของกฎหรือจากการมีข้อความเพิ่มในบริบท</div>
            </div>
          </section>
          <section id="cost" class="col">
            <h2>ต้นทุนและการเปิด skill <span class="qual">(เชิงสำรวจ)</span></h2>
            <p>Skills ใช้ต้นทุนเทียบเท่า API ต่ำกว่าไฟล์เดียวราว {((1 - cost.A2.usd / cost.A1.usd) * 100).toFixed(0)}% และใช้เวลาน้อยกว่าราว {Math.round(cost.A1.sec - cost.A2.sec)} วินาทีต่องาน แต่งานของ A2 ก็สั้นกว่าด้วย จึงยังบอกไม่ได้ว่าส่วนต่างมาจากการโหลดเฉพาะส่วน</p>
            <p>A2 เปิด skill เฉลี่ย {st.nums.manipulation.A2.skillsLoadedPerRun.toFixed(2)} จาก 4 ชุดต่อ run และมีเพียง {st.nums.manipulation.A2.runsLoadingAll} run ที่เปิดครบ ความแม่นของการเปิด (F1) อยู่ระหว่าง {Math.min(...Object.values(st.nums.triggerF1.primary.A2) as number[]).toFixed(2)} ถึง {Math.max(...Object.values(st.nums.triggerF1.primary.A2) as number[]).toFixed(2)} คำอธิบายของ skill จึงเป็นตัวกำหนดว่ากฎจะไปถึงเอเจนต์หรือไม่</p>
          </section>
          <section id="followup" class="col">
            <h2>รอบตอบกลับ</h2>
            <p>ณ จบรอบแรก ผลต่างคือ {pts(one.diff)} จุด แต่ช่วงความเชื่อมั่น 95% กว้างถึง [{pts(one.ci95[0])}, {pts(one.ci95[1])}] เพราะเอเจนต์ที่มีกฎหลาย run หยุดถามก่อนลงมือ หลังส่งข้อความตอบกลับหนึ่งครั้ง run เหล่านี้ทำต่อจนสำเร็จ {rescue.A1.rescued + rescue.A2.rescued + rescue.A5.rescued} จาก {rescue.A1.notDone1 + rescue.A2.notDone1 + rescue.A5.notDone1} run ส่วน A0 ที่ไม่สำเร็จ {rescue.A0.notDone1} run ไม่มี run ใดกลับมาสำเร็จ</p>
          </section>
        </>
      )}

      {st.why.length > 0 && (
        <section id="why" class="col">
          <h2>ทำไมชุดที่ {st.n} สรุปไม่ได้</h2>
          <ol class="why">{st.why.map((w) => <li>{w}</li>)}</ol>
        </section>
      )}
      {st.changed && (
        <section id="next-study" class="col">
          <h2>สิ่งที่เปลี่ยนในชุดที่ {st.n + 1}</h2>
          <p class="lede">{st.changed}</p>
        </section>
      )}

      <section class="col">
        <h2>ข้อมูลของชุดนี้</h2>
        <ul class="links">
          <li><a href={`${base}runs/?study=${st.n}`}>ทะเบียน run ทั้ง {st.usable} ตัวของชุดที่ {st.n}</a></li>
          <li><a href={`${base}scenarios/`}>โจทย์ที่ใช้ในชุดนี้ {st.k} ข้อ</a></li>
          <li><a href={`${base}protocol/#prereg-${st.n}`}>แผนที่ประกาศล่วงหน้า {st.prereg}</a></li>
        </ul>
      </section>

      <nav class="pn">
        {prev ? <a href={`${base}study-${prev.n}/`}><span class="small muted">ก่อนหน้า</span><b>ชุดที่ {prev.n}</b>{prev.role}</a> : <a href={base}><span class="small muted">กลับ</span><b>ภาพรวม</b>ทั้งงานวิจัย</a>}
        {next ? <a class="nx" href={`${base}study-${next.n}/`}><span class="small muted">ถัดไป</span><b>ชุดที่ {next.n}</b>{next.role}</a> : <span></span>}
      </nav>
    </article>
  </div>
</Base>
