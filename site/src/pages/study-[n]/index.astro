---
import Base from '../../layouts/Base.astro';
import Toc from '../../components/Toc.astro';
import Consort from '../../components/Consort.astro';
import ArmBars from '../../components/ArmBars.astro';
import DiffStrip from '../../components/DiffStrip.astro';
import ForestPlot from '../../components/ForestPlot.astro';
import { studies, ARM_INFO, RULE_CATS, failsByCat, costByArm, pct, pts, tie, fmtP, type Study } from '../../lib/data';

export function getStaticPaths() {
  return studies.map((st, i) => ({ params: { n: String(st.n) }, props: { st, prev: studies[i - 1] ?? null, next: studies[i + 1] ?? null } }));
}
interface Props { st: Study; prev: Study | null; next: Study | null }
const { st, prev, next } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const p = st.primary;
const TH_MONTH = ['ม.ค.', 'ก.พ.', 'มี.ค.', 'เม.ย.', 'พ.ค.', 'มิ.ย.', 'ก.ค.', 'ส.ค.', 'ก.ย.', 'ต.ค.', 'พ.ย.', 'ธ.ค.'];
const thDate = (stamp: string) => { const [y, m, d] = stamp.slice(0, 10).split('-').map(Number); return `${d} ${TH_MONTH[m - 1]} ${y + 543}`; };
const sorted = [...st.perScenario].sort((a, b) => a.code.localeCompare(b.code));
const isS3 = st.n === 3;
const sec = st.secondary;
const cost = costByArm(st);
const rescue = st.nums.study3?.rescue;
const one = st.nums.study3?.oneShot;
const ruled = st.armIds.filter((a) => a !== 'A0');
const margin = isS3 ? (p.decision.margin as number) : 0;
const f1 = isS3 ? (Object.values(st.nums.triggerF1.primary.A2) as number[]) : [];

const toc: [string, string][] = [
  ['result', 'ผล'],
  ...(isS3 ? [['seen', 'สิ่งที่เราเห็นเพิ่ม']] as [string, string][] : [['why', 'ทำไมรอบนี้สรุปไม่ได้']] as [string, string][]),
  ...(st.changed ? [['next-study', 'รอบต่อไปเปลี่ยนอะไร']] as [string, string][] : []),
  ['details', 'ตัวเลขเต็มสำหรับกรรมการ'],
];
let fig = 0;
const nf = () => ++fig;
let tab = 0;
const nt = () => ++tab;
---
<Base title={`การทดลองชุดที่ ${st.n} SkillBench`} current={`study-${st.n}/`}>
  <header class="title-block col">
    <p class="kicker">การทดลองชุดที่ {st.n} จาก {studies.length}</p>
    <h1>{st.role}</h1>
    <p class="lede">{st.summary}</p>
    <p class="meta"><span class={`verdict ${isS3 ? '' : 'nc'}`}>{st.verdict}</span> <span>โจทย์ {st.k} ข้อ ข้อละ {st.reps} รอบ รวม {st.usable} ครั้ง เก็บข้อมูลเสร็จ {thDate(st.stamp)}</span></p>
  </header>

  <div class="article-grid">
    <Toc items={toc} />
    <article>
      <section id="result" class="wide">
        <h2 class="h-first">ผล</h2>
        {isS3 ? (
          <>
            <div class="col">
              <p class="big">Skills ได้คะแนน {pct(p.rateA)}% ไฟล์เดียวได้ {pct(p.rateB)}% ต่างกัน {pts(p.diff)} จุด</p>
              <p>ก่อนเริ่ม เราตั้งเกณฑ์ไว้ว่าถ้าสองแบบต่างกันไม่เกิน ±{(margin * 100).toFixed(1)} จุด ซึ่งประมาณเท่ากับพลาดกฎสำคัญหนึ่งข้อต่องาน จะถือว่าเทียบเท่า ผลออกมาอยู่ในเกณฑ์ทั้งช่วง เราเลยสรุปว่า<span class="verdict">เทียบเท่า</span></p>
            </div>
            <ForestPlot n={nf()} />
            <div class="col">
              <p><b>อ่านให้ถูก</b> เทียบเท่าไม่ได้แปลว่าเหมือนกันเป๊ะ และเพราะไฟล์เดียวได้ {pct(p.rateB)}% อยู่แล้ว Skills จะนำได้มากสุดแค่ {((1 - p.rateB) * 100).toFixed(1)} จุด สิ่งที่เรามั่นใจได้จริง ๆ คือ <b>Skills ไม่ด้อยกว่าไฟล์เดียว</b></p>
              <p>เราลองนับใหม่อีกสองแบบ คือแก้ตัวตรวจที่เจอว่าผิด และตัดโจทย์ที่มีปัญหาออก ผลก็ยังเทียบเท่าเหมือนเดิม (แถว SA-1 และ SA-2 ในรูป)</p>
              <p>ส่วนคำถามว่า "การเปิดอ่านทีละชุด" มีผลไหม ต้องเทียบ Skills กับ Skills แบบอ่านทุกครั้ง แผนของเราให้ทดสอบข้อนี้ได้ก็ต่อเมื่อคำถามหลักพบความต่าง พอผลหลักออกมาเทียบเท่า ข้อนี้เลยไม่ได้ทดสอบ ตัวเลขที่เห็นคือ {pts(sec.rateA - sec.rateB)} จุด ใช้ดูเฉย ๆ ยังสรุปไม่ได้</p>
            </div>
          </>
        ) : (
          <div class="col">
            <p class="big">Skills ได้ {pct(p.rateA)}% ไฟล์เดียวได้ {pct(p.rateB)}% ต่างกัน {pts(p.diff)} จุด</p>
            <p>Skills ได้สูงกว่า แต่ข้อมูลยังน้อยเกินกว่าจะบอกได้ว่าเป็นของจริงหรือแค่บังเอิญ (p = {fmtP(p.p)}) เราเลย<b>สรุปไม่ได้</b> ซึ่งไม่ได้แปลว่าสองแบบเท่ากัน</p>
            <figure class="pfloor">
              <div class="sq-row">
                {sorted.map((s) => <a href={`${base}scenarios/${s.id}/#study-${st.n}`} class={`sq ${tie(s.diff) ? 'tie' : s.diff > 0 ? 'win' : 'loss'}`} title={`${s.code} ${tie(s.diff) ? 'เท่ากัน' : pts(s.diff) + ' จุด'}`}><span>{s.code}</span></a>)}
              </div>
              <p class="sq-key small"><i class="sq win"></i> Skills ได้มากกว่า <i class="sq loss"></i> ไฟล์เดียวได้มากกว่า <i class="sq tie"></i> ได้เท่ากัน</p>
              <figcaption><b>รูปที่ {nf()}</b> จาก {st.k} โจทย์ มี {p.ties} ข้อที่สองแบบได้เท่ากัน โจทย์พวกนี้ใช้ตัดสินไม่ได้ เหลือแค่ {st.informative} ข้อ{st.pFloor > 0.05 ? ` ต่อให้ Skills ชนะครบทุกข้อ ทางสถิติก็ยังสรุปไม่ได้อยู่ดี เพราะค่า p ต่ำสุดที่ทำได้คือ ${st.pFloor.toFixed(4)} แต่ต้องต่ำกว่า 0.05` : ''}</figcaption>
            </figure>
            {sec && (
              <p class="small muted">{st.n === 1 ? `อีกตัวเลขที่เราดู คือสัดส่วนกฎที่ทำตาม (RCR) Skills ได้สูงกว่า ${pts(sec.diff)} จุด` : `Skills แบบอ่านทุกครั้งต่างจาก Skills ${pts(sec.diff)} จุด`} แต่แผนให้ทดสอบข้อนี้ได้ก็ต่อเมื่อผลหลักผ่าน เลยไม่ได้ทดสอบ</p>
            )}
          </div>
        )}
      </section>

      {isS3 && (
        <section id="seen" class="col">
          <h2>สิ่งที่เราเห็นเพิ่ม</h2>
          <p class="small muted">ทั้งหมดในหัวข้อนี้เป็นสิ่งที่เราสังเกตเห็น ไม่ได้อยู่ในคำถามหลักที่ทดสอบตามแผน</p>
          <h3>มีกฎกับไม่มีกฎต่างกันมากกว่า</h3>
          <p>ความต่างที่ใหญ่ที่สุดไม่ได้อยู่ระหว่างสองแบบ แต่อยู่ระหว่างมีกฎกับไม่มีกฎ AI ที่ไม่มีกฎทำตามกฎสำคัญได้ครบแค่ {pct(st.nums.perArm.A0.CRIT)}% ของครั้ง แก้ไฟล์นอกงานบ่อยกว่า และไม่เช็กหรือไม่บอกผลกระทบต่อข้อมูลย้อนหลัง {failsByCat.IM.A0.fail} จาก {failsByCat.IM.A0.app} ครั้ง ส่วนกลุ่มที่มีกฎพลาดไม่เกิน {Math.max(...ruled.map((a) => failsByCat.IM[a].fail))} ครั้ง</p>
          <p>แต่เรายังแยกไม่ได้ว่าที่ดีขึ้นเป็นเพราะเนื้อหาของกฎ หรือแค่เพราะมีข้อความให้ AI อ่านมากขึ้น เพราะรอบนี้ไม่มีกลุ่มที่ได้ข้อความยาวเท่ากันแต่ไม่ใช่กฎ</p>
          <h3>Skills ถูกกว่านิดหน่อย</h3>
          <p>Skills ใช้เงินน้อยกว่าไฟล์เดียวเฉลี่ย ${(cost.A1.usd - cost.A2.usd).toFixed(3)} ต่องาน หรือราว {Math.round((1 - cost.A2.usd / cost.A1.usd) * 20) * 5}% และเร็วกว่าราว {Math.round((cost.A1.sec - cost.A2.sec) / 5) * 5} วินาที แต่งานของ Skills ก็สั้นกว่าด้วย เลยยังบอกไม่ได้ว่าถูกกว่าเพราะเปิดอ่านทีละชุดหรือเปล่า</p>
          <h3>คำอธิบายของ skill สำคัญมาก</h3>
          <p>AI เปิด skill เฉลี่ย {st.nums.manipulation.A2.skillsLoadedPerRun.toFixed(1)} จาก 4 ชุดต่องาน มีแค่ {st.nums.manipulation.A2.runsLoadingAll} ครั้งที่เปิดครบ บางชุดถูกเปิดเกินจำเป็น บางชุดไม่ถูกเปิดตอนที่ควรเปิด (ความแม่นอยู่ระหว่าง {Math.min(...f1).toFixed(2)} ถึง {Math.max(...f1).toFixed(2)} จากเต็ม 1) ถ้าเขียนคำอธิบายไม่ดี กฎก็ไปไม่ถึง AI</p>
          <h3>ทำไมเราส่งคำตอบให้ AI ที่หยุดถาม</h3>
          <p>AI ที่มีกฎหลายครั้งหยุดถามก่อนลงมือ ซึ่งเป็นเรื่องดี แต่ถ้านับแค่รอบแรก งานพวกนี้จะถูกนับว่าไม่เสร็จ เราเลยส่งข้อความเดิมทุกครั้งกลับไปให้ทำต่อหนึ่งครั้ง ปรากฏว่า {rescue.A1.rescued + rescue.A2.rescued + rescue.A5.rescued} จาก {rescue.A1.notDone1 + rescue.A2.notDone1 + rescue.A5.notDone1} ครั้งทำต่อจนเสร็จ ส่วน AI ที่ไม่มีกฎซึ่งทำไม่เสร็จ {rescue.A0.notDone1} ครั้ง ไม่มีครั้งไหนกลับมาเสร็จ ถ้านับแค่รอบแรก ผลต่างจะเป็น {pts(one.diff)} จุด แต่ช่วงที่ค่าจริงน่าจะอยู่กว้างมาก ตั้งแต่ {pts(one.ci95[0])} ถึง {pts(one.ci95[1])}</p>
        </section>
      )}

      {st.why.length > 0 && (
        <section id="why" class="col">
          <h2>ทำไมรอบนี้สรุปไม่ได้</h2>
          <ol class="why">{st.why.map((w) => <li>{w}</li>)}</ol>
        </section>
      )}
      {st.changed && (
        <section id="next-study" class="col">
          <h2>รอบต่อไปเปลี่ยนอะไร</h2>
          <p class="lede">{st.changed}</p>
        </section>
      )}

      <section id="details" class="wide">
        <details class="more-box">
          <summary><span class="sm-t">ตัวเลขเต็มสำหรับกรรมการ</span><span class="sm-s">การออกแบบ ตารางผล สถิติ ผลรายโจทย์ และผลรายกลุ่ม</span></summary>

          <h3>การออกแบบ</h3>
          <div class="tbl-wrap">
            <table class="bt">
              <caption><b>ตารางที่ {nt()}</b> กลุ่มทดลองในชุดที่ {st.n} <a href={`${base}arms/`}>ดูไฟล์กฎของทุกกลุ่ม</a></caption>
              <thead><tr><th>กลุ่ม</th><th>AI ได้อะไร</th><th>มีไว้ตอบอะไร</th></tr></thead>
              <tbody>
                {st.armIds.map((a) => (
                  <tr class={a === 'A1' || a === 'A2' ? 'hl' : ''}><td><span class={`arm arm-${a}`}><b>{a}</b></span></td><td>{ARM_INFO[a].name}</td><td>{ARM_INFO[a].question}</td></tr>
                ))}
              </tbody>
            </table>
          </div>
          <Consort st={st} n={nf()} />
          <p class="small muted">วิธีให้คะแนน: {st.metricName} {st.metricLabel} แผนที่ตั้งไว้ก่อนเริ่มอยู่ใน <a href={`${base}protocol/#prereg-${st.n}`}>{st.prereg}</a></p>

          <h3>ผลหลักแบบเต็ม</h3>
          <div class="tbl-wrap">
            <table class="bt">
              <caption><b>ตารางที่ {nt()}</b> ผลหลักตามแผน ทดสอบด้วย exact paired sign-flip โดยเทียบกันทีละโจทย์</caption>
              <thead><tr><th class="r">A2</th><th class="r">A1</th><th class="r">ผลต่าง</th><th>CI 95%</th>{st.ci90 && <th>CI 90%</th>}<th class="r">ชนะ แพ้ เสมอ</th><th class="r">p</th><th>ข้อสรุป</th></tr></thead>
              <tbody>
                <tr class={isS3 ? 'hl' : ''}>
                  <td class="r">{pct(p.rateA)}%</td><td class="r">{pct(p.rateB)}%</td><td class="r"><b>{pts(p.diff)} จุด</b></td>
                  <td class="nw">[{pts(st.ci95[0])}, {pts(st.ci95[1])}]</td>{st.ci90 && <td class="nw">[{pts(st.ci90[0])}, {pts(st.ci90[1])}]</td>}
                  <td class="r">{p.wins} / {p.losses} / {p.ties}</td><td class="r">{fmtP(p.p)}</td><td><b>{st.verdict}</b></td>
                </tr>
              </tbody>
            </table>
          </div>

          <h3>ผลรายโจทย์</h3>
          <DiffStrip st={st} n={nf()} />

          <h3>ผลรายกลุ่ม</h3>
          <ArmBars st={st} n={nf()} />
          <div class="tbl-wrap">
            <table class="bt">
              <caption><b>ตารางที่ {nt()}</b> ตัวชี้วัดรายกลุ่ม</caption>
              <thead><tr><th>กลุ่ม</th>{st.n > 1 && <th class="r">RCRc</th>}{st.n > 1 && <th class="r">ทำงานเสร็จ</th>}<th class="r">CRIT</th><th class="r">SCOPE</th><th class="r">RCR</th><th class="r">pass^k</th><th class="r">ต้นทุนต่อครั้ง</th></tr></thead>
              <tbody>
                {st.armIds.map((a) => { const m = st.nums.perArm[a]; return (
                  <tr><td><span class={`arm arm-${a}`}>{a} {ARM_INFO[a].short}</span></td>
                    {st.n > 1 && <td class="r">{pct(m.RCRc)}%</td>}{st.n > 1 && <td class="r">{pct(m.taskDoneRate)}%</td>}
                    <td class="r">{pct(m.CRIT)}%</td><td class="r">{pct(m.SCOPE)}%</td><td class="r">{pct(m.RCR)}%</td><td class="r">{pct(m.passHatK)}%</td><td class="r">${cost[a].usd.toFixed(2)}</td></tr>
                ); })}
              </tbody>
            </table>
          </div>
          <p class="small muted">CRIT คือสัดส่วนครั้งที่ทำตามกฎสำคัญครบทุกข้อ SCOPE คือสัดส่วนครั้งที่แก้เฉพาะไฟล์ในงาน RCR คือสัดส่วนกฎที่ทำตาม pass^k คือสัดส่วนโจทย์ที่ทำตามกฎสำคัญครบทุกรอบ <a href={`${base}method/`}>อ่านวิธีวัดทั้งหมด</a></p>

          {st.n === 1 && (
            <>
              <h3>กลุ่ม A3 และ A4</h3>
              <p><b>A3 ข้อความยาวเท่ากันแต่ไม่ใช่กฎ</b> ถ้ากฎช่วยเพราะเนื้อหา A3 ควรได้ผลใกล้กลุ่มไม่มีกฎ ถ้าช่วยแค่เพราะมีข้อความยาว ๆ A3 ควรได้ผลใกล้ไฟล์เดียว รอบนี้ A3 ทำตามกฎสำคัญครบ {pct(st.nums.perArm.A3.CRIT)}% ไฟล์เดียว {pct(st.nums.perArm.A1.CRIT)}% และไม่มีกฎ {pct(st.nums.perArm.A0.CRIT)}% แต่คะแนนแบบนี้ได้ศูนย์เป็นส่วนใหญ่ เลยแยกไม่ออก</p>
              <p><b>A4 Skills และคอมเมนต์ล่อ</b> ทำตามกฎสำคัญครบ {pct(st.nums.perArm.A4.CRIT)}% เทียบกับ Skills ปกติ {pct(st.nums.perArm.A2.CRIT)}%</p>
              <p class="small muted">สองกลุ่มนี้ไม่ใช่คำถามหลักและไม่ได้ทดสอบทางสถิติ รอบต่อไปเราตัดออกเพื่อเอาเวลาไปลงกับคำถามหลัก</p>
            </>
          )}

          {st.n === 2 && (
            <>
              <h3>ทำงานเสร็จไหม กับทำตามกฎแค่ไหน</h3>
              <p>คะแนนหลักรวมสองเรื่องไว้ในตัวเลขเดียว คืองานเสร็จไหม และถ้าเสร็จแล้วทำตามกฎแค่ไหน พอแยกดู สองเรื่องนี้ไปคนละทาง</p>
              <div class="tbl-wrap">
                <table class="bt">
                  <caption><b>ตารางที่ {nt()}</b> อัตราทำงานเสร็จ และการทำตามกฎเมื่องานเสร็จ</caption>
                  <thead><tr><th>กลุ่ม</th><th class="r">ทำงานเสร็จ</th><th class="r">ทำตามกฎเมื่องานเสร็จ</th></tr></thead>
                  <tbody>{st.armIds.map((a) => <tr><td><span class={`arm arm-${a}`}>{a} {ARM_INFO[a].short}</span></td><td class="r">{pct(st.nums.perArm[a].taskDoneRate)}%</td><td class="r">{st.nums.perArm[a].RCRcGivenDone.toFixed(3)}</td></tr>)}</tbody>
                </table>
              </div>
              <p>กลุ่มที่มีกฎทำตามกฎได้ใกล้กันหมดที่ราว {(ruled.reduce((s, a) => s + st.nums.perArm[a].RCRcGivenDone, 0) / ruled.length).toFixed(3)} เมื่องานเสร็จ แต่กลุ่มที่ไม่มีกฎกลับทำงานเสร็จบ่อยที่สุด ส่วนหนึ่งเพราะ AI ที่มีกฎหยุดถามเมื่อเจอข้อกำหนดไม่ชัด แล้วการหยุดถามถูกนับว่าไม่เสร็จ เรื่องนี้ทำให้รอบที่ 3 เราส่งคำตอบให้ AI ที่หยุดถามได้ทำต่อ</p>
              <p class="small muted">ตารางนี้ไม่ได้ทดสอบทางสถิติ และไม่ได้อยู่ในแผนที่ตั้งไว้ก่อน จึงเป็นข้อสังเกต ไม่ใช่ข้อสรุป</p>
            </>
          )}

          {isS3 && (
            <>
              <h3>กฎสำคัญที่พลาด แยกตามประเภท</h3>
              <div class="tbl-wrap">
                <table class="bt">
                  <caption><b>ตารางที่ {nt()}</b> จำนวนครั้งที่พลาด ต่อจำนวนครั้งที่กฎข้อนั้นมีโอกาสถูกละเมิด</caption>
                  <thead><tr><th>ประเภทกฎ</th>{st.armIds.map((a) => <th class="r"><span class={`arm arm-${a}`}>{a}</span></th>)}</tr></thead>
                  <tbody>{RULE_CATS.map(({ key, name }) => <tr class={key === 'IM' ? 'hl-x' : ''}><td>{name}</td>{st.armIds.map((a) => <td class="r">{failsByCat[key][a].fail}/{failsByCat[key][a].app}</td>)}</tr>)}</tbody>
                </table>
              </div>
              <p class="small muted">ข้อมูลย้อนหลังอย่างใบแจ้งหนี้เก่าเปลี่ยนจริงน้อยมากในทุกกลุ่ม สิ่งที่กลุ่มไม่มีกฎพลาดเกือบทั้งหมดคือไม่เช็กหรือไม่บอก แถว "ไม่ทำเกินสั่ง" พลาดส่วนใหญ่ที่ S05 GP1 ซึ่งเราเจอทีหลังว่าตัวตรวจข้อนี้ผิด แถวนี้จึงยังใช้ตัดสินไม่ได้ การเทียบกับกลุ่มไม่มีกฎไม่ได้อยู่ในคำถามหลัก และไม่ได้ปรับค่าสำหรับการทดสอบหลายครั้ง</p>
            </>
          )}
        </details>
      </section>

      <section class="col">
        <h2>ข้อมูลของรอบนี้</h2>
        <ul class="links">
          <li><a href={`${base}runs/?study=${st.n}`}>การทำงานทั้ง {st.usable} ครั้งของชุดที่ {st.n}</a></li>
          <li><a href={`${base}scenarios/`}>โจทย์ที่ใช้ {st.k} ข้อ</a></li>
          <li><a href={`${base}protocol/#prereg-${st.n}`}>แผนที่ตั้งไว้ก่อนเริ่ม {st.prereg}</a></li>
        </ul>
      </section>

      <nav class="pn">
        {prev ? <a href={`${base}study-${prev.n}/`}><span class="small muted">รอบก่อนหน้า</span><b>ชุดที่ {prev.n}</b>{prev.role}</a> : <a href={base}><span class="small muted">กลับ</span><b>หน้าแรก</b>ภาพรวมทั้งหมด</a>}
        {next ? <a class="nx" href={`${base}study-${next.n}/`}><span class="small muted">รอบถัดไป</span><b>ชุดที่ {next.n}</b>{next.role}</a> : <span></span>}
      </nav>
    </article>
  </div>
</Base>
