---
// เล่าที่มาของ Context Engineering และ Agent Skills ก่อนเข้าเรื่องการทดลอง
// วันที่และนิยามตรวจกับแหล่งต้นทางแล้ว (ลิงก์อยู่ท้ายหน้า) ขนาดไฟล์คำนวณจากไฟล์กฎจริงใน arms/
import Base from '../layouts/Base.astro';
import Toc from '../components/Toc.astro';
import { arms } from '../lib/data';
import { rootOf, type Lang } from '../lib/i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const en = lang === 'en';
const base = rootOf(lang);
const files = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const a1 = arms.find((a) => a.id === 'A1')!;
const a2 = arms.find((a) => a.id === 'A2')!;
const a1Chars = a1.files.reduce((s, f) => s + f.body.length, 0);
const a2Main = a2.files.filter((f) => f.always);
const a2Skills = a2.files.filter((f) => !f.always);
const a2MainChars = a2Main.reduce((s, f) => s + f.body.length, 0);
const descChars = a2Skills.reduce((s, f) => s + (f.description ?? '').length, 0);
const fmt = (n: number) => n.toLocaleString('en-US');
const toc: [string, string][] = en
  ? [['context', 'What context is'], ['ce', 'Context Engineering'], ['rule-files', 'Rule files'], ['skills', 'Agent Skills'], ['timeline', 'Timeline'], ['why', 'Why we measured this'], ['sources', 'Sources']]
  : [['context', 'บริบทคืออะไร'], ['ce', 'Context Engineering'], ['rule-files', 'ไฟล์กฎ'], ['skills', 'Agent Skills'], ['timeline', 'เรียงตามเวลา'], ['why', 'ทำไมเราถึงวัดเรื่องนี้'], ['sources', 'แหล่งที่มา']];
const timeline: [string, string][] = en ? [
  ['Early ChatGPT days', 'People focused on how to write instructions that get good answers, which became known as prompt engineering'],
  ['Jun 2025', 'Tobi Lütke (Shopify) and Andrej Karpathy suggested calling this work context engineering instead, because what really matters is all the information the model sees, not just the wording of the instruction'],
  ['Aug 2025', 'AGENTS.md appeared as a shared rule file format that many tools can read, instead of each tool having its own file'],
  ['29 Sep 2025', 'Anthropic published an article explaining context engineering systematically and pointing out that context is a limited resource'],
  ['16 Oct 2025', 'Anthropic launched Agent Skills, which let an agent open knowledge or rules only when a task needs them'],
  ['18 Dec 2025', 'Agent Skills became an open standard at agentskills.io, so other tools can use the same format'],
  ['Early 2026', 'The first studies measured how much skills help agents, but mostly compared them with having no skills'],
  ['Oct 2026', 'Our work, which compares a single file directly with Skills, with every rule identical'],
] : [
  ['ช่วงแรกของ ChatGPT', 'คนสนใจว่าจะเขียนคำสั่งยังไงให้ได้คำตอบดี เรียกกันว่า prompt engineering'],
  ['มิ.ย. 2025', 'Tobi Lütke (Shopify) และ Andrej Karpathy ชวนให้เรียกงานนี้ว่า context engineering แทน เพราะสิ่งที่ส่งผลจริงคือข้อมูลทั้งหมดที่โมเดลเห็น ไม่ใช่แค่ถ้อยคำในคำสั่ง'],
  ['ส.ค. 2025', 'AGENTS.md ออกมาเป็นรูปแบบไฟล์กฎกลางที่เครื่องมือหลายตัวอ่านได้ แทนที่แต่ละเครื่องมือจะมีไฟล์ของตัวเอง'],
  ['29 ก.ย. 2025', 'Anthropic เขียนบทความอธิบาย context engineering เป็นระบบ และชี้ว่าบริบทเป็นทรัพยากรที่มีจำกัด'],
  ['16 ต.ค. 2025', 'Anthropic เปิดตัว Agent Skills ให้เอเจนต์เปิดอ่านความรู้หรือกฎเฉพาะเมื่องานต้องใช้'],
  ['18 ธ.ค. 2025', 'Agent Skills เปิดเป็นมาตรฐานกลางที่ agentskills.io ให้เครื่องมืออื่นใช้รูปแบบเดียวกันได้'],
  ['ต้นปี 2026', 'งานวิจัยชุดแรกเริ่มวัดว่า skill ช่วยเอเจนต์ได้แค่ไหน แต่ยังเทียบกับการไม่มี skill เป็นหลัก'],
  ['ต.ค. 2026', 'งานของเรา เทียบไฟล์เดียวกับ Skills ตรง ๆ โดยให้กฎเหมือนกันทุกข้อ'],
];
---
<Base lang={lang} title={en ? 'Context Engineering and Agent Skills | SkillBench' : 'Context Engineering และ Agent Skills SkillBench'} current="background/">
  <header class="title-block col">
    <h1>{en ? 'What Context Engineering and Agent Skills are' : 'Context Engineering กับ Agent Skills คืออะไร'}</h1>
    <p class="lede">{en
      ? 'Before the results, here is the background: what these two terms mean, how they work, where they come from, and why we wanted to measure them.'
      : 'ก่อนไปดูผล ขอเล่าที่มาก่อนว่าสองคำนี้คืออะไร ทำงานยังไง มาจากไหน และทำไมเราถึงอยากวัดมัน'}</p>
  </header>
  <div class="article-grid">
    <Toc items={toc} lang={lang} />
    <article>
      {en ? (
        <section id="context" class="col">
          <h2 class="h-first">Start with the word "context"</h2>
          <p>An AI such as Claude or ChatGPT does not remember anything between tasks. Every time it answers or acts, it only knows what is in front of it at that moment. This is called its <b>context</b>, and it includes everything sent to the model: the system instructions, the user’s instructions, files it has opened, the output of commands it has run, and the conversation so far.</p>
          <p>As a result, <b>if a team rule is not in the context, the AI does not know the rule exists</b>, even if everyone on the team knows it well. Everything on this page comes back to one question: what to put into the context, when, and how much.</p>
        </section>
      ) : (
        <section id="context" class="col">
          <h2 class="h-first">เริ่มจากคำว่า "บริบท"</h2>
          <p>AI อย่าง Claude หรือ ChatGPT ไม่ได้จำอะไรข้ามงาน ทุกครั้งที่มันตอบหรือลงมือทำ มันรู้แค่สิ่งที่อยู่ตรงหน้าตอนนั้น เรียกว่า<b>บริบท</b> (context) ซึ่งรวมทุกอย่างที่ถูกส่งให้โมเดล ทั้งคำสั่งของระบบ คำสั่งของผู้ใช้ ไฟล์ที่มันเปิดอ่าน ผลจากคำสั่งที่มันรัน และสิ่งที่คุยกันมาก่อนหน้า</p>
          <p>ผลคือ <b>ถ้ากฎของทีมไม่ได้อยู่ในบริบท AI ก็ไม่รู้ว่ามีกฎนั้น</b> ต่อให้เป็นกฎที่ทุกคนในทีมรู้ดีก็ตาม งานทั้งหมดในหน้านี้จึงวนอยู่กับคำถามเดียว คือจะเอาอะไรใส่ในบริบท ใส่ตอนไหน และใส่แค่ไหน</p>
        </section>
      )}

      {en ? (
        <section id="ce" class="col">
          <h2>From Prompt Engineering to Context Engineering</h2>
          <p>When people first started using ChatGPT, what everyone cared about was how to <b>write the instruction</b> to get a good answer. This was called prompt engineering.</p>
          <p>Once AI became an <b>agent</b> that can work through many steps on its own, reading files, running commands and editing code, the context was no longer just the instruction we typed. It holds everything that flows in along the way: documents, test results and messages from tools. In mid 2025 people in the field began calling this work <b>context engineering</b>, and Anthropic describes it as choosing and managing what is in the context so that it is just right at each point while the model works.</p>
          <div class="aside"><b>Why not put everything in?</b>Context has a limited size, and the more you put in, the less accurately the model can pull out what it needs. Anthropic calls this context rot and compares it to an "attention budget" that every word uses up a little of. So the aim of context engineering is not to put in as much as possible, but only what is needed, and to load the rest when it is needed.</div>
        </section>
      ) : (
        <section id="ce" class="col">
          <h2>จาก Prompt Engineering สู่ Context Engineering</h2>
          <p>ช่วงแรกที่คนเริ่มใช้ ChatGPT สิ่งที่ทุกคนสนใจคือจะ<b>เขียนคำสั่ง</b>ยังไงให้ได้คำตอบดี เรียกกันว่า prompt engineering</p>
          <p>แต่พอ AI กลายเป็น<b>เอเจนต์</b>ที่ทำงานหลายขั้นได้เอง อ่านไฟล์ รันคำสั่ง แก้โค้ด สิ่งที่อยู่ในบริบทก็ไม่ได้มีแค่คำสั่งที่เราพิมพ์อีกต่อไป แต่มีทุกอย่างที่ไหลเข้ามาระหว่างทาง ทั้งเอกสาร ผลเทส และข้อความจากเครื่องมือ กลางปี 2025 คนในวงการเลยเริ่มเรียกงานนี้ว่า <b>context engineering</b> และ Anthropic อธิบายไว้ว่าเป็นวิธีคัดและดูแลข้อมูลในบริบทให้พอดีที่สุดในแต่ละช่วงที่โมเดลทำงาน</p>
          <div class="aside"><b>ทำไมไม่ใส่ทุกอย่างลงไปเลย</b>บริบทมีขนาดจำกัด และยิ่งใส่เยอะ โมเดลยิ่งดึงข้อมูลที่ต้องใช้ออกมาได้แม่นน้อยลงทีละนิด Anthropic เรียกอาการนี้ว่า context rot และเปรียบว่าโมเดลมี "งบความสนใจ" ที่ข้อความทุกคำใช้ไปส่วนหนึ่ง เป้าหมายของ context engineering จึงไม่ใช่ใส่ให้เยอะที่สุด แต่ใส่เฉพาะที่จำเป็น และค่อยโหลดส่วนที่เหลือเมื่อต้องใช้</div>
        </section>
      )}

      {en ? (
        <section id="rule-files" class="col">
          <h2>Rule files, the first way teams passed on rules</h2>
          <p>The simplest way is to write all the rules in one file and have the tool load it into the context every time a task starts. Each tool has its own file name, such as <code>CLAUDE.md</code> for Claude Code and <code>.cursorrules</code> for Cursor. In August 2025 <code>AGENTS.md</code> appeared as a shared format that many tools can read.</p>
          <p><b>The upside</b> is that it is easy to write and maintain, and you can be sure the AI sees every rule. <b>The downside</b> is that every rule takes up context space all the time, even rules unrelated to the task at hand. For example, while editing a web page the AI still has to read the billing rules.</p>
        </section>
      ) : (
        <section id="rule-files" class="col">
          <h2>ไฟล์กฎ วิธีแรกที่ทีมใช้บอกกฎ</h2>
          <p>วิธีที่ง่ายที่สุดคือเขียนกฎทั้งหมดไว้ในไฟล์เดียว แล้วให้เครื่องมือโหลดเข้าบริบททุกครั้งที่เริ่มงาน แต่ละเครื่องมือมีชื่อไฟล์ของตัวเอง เช่น <code>CLAUDE.md</code> ของ Claude Code และ <code>.cursorrules</code> ของ Cursor ต่อมาในเดือนสิงหาคม 2025 มี <code>AGENTS.md</code> ออกมาเป็นรูปแบบกลางที่หลายเครื่องมืออ่านได้</p>
          <p><b>ข้อดี</b> คือเขียนง่าย ดูแลง่าย และมั่นใจได้ว่า AI เห็นกฎครบทุกข้อ <b>ข้อเสีย</b> คือกฎทุกข้อกินพื้นที่บริบทตลอดเวลา แม้ข้อที่ไม่เกี่ยวกับงานตรงหน้า เช่น ตอนแก้หน้าเว็บ AI ก็ยังต้องอ่านกฎเรื่องการคิดเงินไปด้วย</p>
        </section>
      )}

      <section id="skills" class="wide">
        {en ? (
          <div class="col">
            <h2>Agent Skills, opened when needed</h2>
            <p>In October 2025 Anthropic launched <b>Agent Skills</b>, which applies the "load when needed" idea of context engineering to knowledge and rules. A skill is a folder containing a <code>SKILL.md</code> file. The top of the file holds a name and a short description of when to use it, the rest is the full content, and there may be other supporting files. The AI sees the information in three layers.</p>
            <ol class="levels">
              <li><b>Name and description</b><span>The AI sees these for every skill from the start, and uses them to decide which skill relates to the task</span></li>
              <li><b>Full content of SKILL.md</b><span>The AI opens it when it sees that the task matches the description</span></li>
              <li><b>Supporting files</b><span>The AI opens these only when the full content tells it to look</span></li>
            </ol>
            <p>This idea is called progressive disclosure: revealing only as much information as is needed. In December 2025 Anthropic made Agent Skills an open standard at <a href="https://agentskills.io">agentskills.io</a>, so the same skills can be used with other tools.</p>
          </div>
        ) : (
          <div class="col">
            <h2>Agent Skills เปิดอ่านเมื่อจำเป็น</h2>
            <p>เดือนตุลาคม 2025 Anthropic เปิดตัว <b>Agent Skills</b> ซึ่งเอาหลัก "โหลดเมื่อจำเป็น" ของ context engineering มาใช้กับความรู้และกฎ skill หนึ่งชุดคือโฟลเดอร์ที่มีไฟล์ <code>SKILL.md</code> ข้างบนสุดของไฟล์เขียนชื่อกับคำอธิบายสั้น ๆ ว่าใช้ตอนไหน ข้างล่างคือเนื้อหาเต็ม และอาจมีไฟล์อื่นประกอบ AI จะเห็นข้อมูลเป็นสามชั้น</p>
            <ol class="levels">
              <li><b>ชื่อกับคำอธิบาย</b><span>AI เห็นของทุก skill ตั้งแต่เริ่มงาน ไว้ใช้ตัดสินว่า skill ไหนเกี่ยวกับงานนี้</span></li>
              <li><b>เนื้อหาเต็มใน SKILL.md</b><span>AI เปิดอ่านเมื่อเห็นว่างานตรงกับคำอธิบาย</span></li>
              <li><b>ไฟล์ประกอบ</b><span>AI เปิดเพิ่มเฉพาะตอนที่เนื้อหาเต็มบอกให้ไปดู</span></li>
            </ol>
            <p>แนวคิดนี้เรียกว่า progressive disclosure คือค่อย ๆ เปิดข้อมูลเท่าที่ต้องใช้ ในเดือนธันวาคม 2025 Anthropic เปิด Agent Skills เป็นมาตรฐานกลางที่ <a href="https://agentskills.io">agentskills.io</a> เพื่อให้ skill ชุดเดียวกันใช้กับเครื่องมืออื่นได้</p>
          </div>
        )}
        <figure class="fig-wide compare">
          <div class="cmp">
            <div class="cmp-col">
              <p class="cmp-h">{en ? 'Single file' : 'ไฟล์เดียว'}</p>
              <div class="row"><i class="bar always" style={`--w:100%`}></i><span>CLAUDE.md {fmt(a1Chars)} {en ? 'characters' : 'ตัวอักษร'}</span></div>
              <p class="cmp-n">{en ? 'At the start of a task the AI reads every rule, every time.' : 'ตอนเริ่มงาน AI อ่านกฎครบทุกข้อ ทุกครั้ง'}</p>
            </div>
            <div class="cmp-col">
              <p class="cmp-h">Agent Skills</p>
              <div class="row"><i class="bar always" style={`--w:${(a2MainChars / a1Chars) * 100}%`}></i><span>{en ? 'Short file' : 'ไฟล์สั้น'} {fmt(a2MainChars)}</span></div>
              <div class="row"><i class="bar desc" style={`--w:${(descChars / a1Chars) * 100}%`}></i><span>{en ? `Descriptions of ${a2Skills.length} skills` : `คำอธิบาย ${a2Skills.length} skill`} {fmt(descChars)}</span></div>
              <div class="skills-row">{a2Skills.map((s) => <div class="row"><i class="bar od" style={`--w:${(s.body.length / a1Chars) * 100}%`}></i><span class="mono">{s.name} {fmt(s.body.length)}</span></div>)}</div>
              <p class="cmp-n">{en ? 'At the start the AI sees only the top two rows. The rows below are opened only for the skills that relate to the task.' : 'ตอนเริ่มงาน AI เห็นแค่สองแถวบน แถวล่างเปิดเฉพาะชุดที่เกี่ยวกับงาน'}</p>
            </div>
          </div>
          {en
            ? <figcaption><b>Figure 1</b> What the AI sees at the start of a task in our experiment. Bar lengths are compared with the whole single file (in characters). A solid bar is read every time, a dashed bar is seen every time but is short, and a light bar is opened when the task relates to it. Both formats contain exactly the same rules, and only the way they are delivered differs. <a href={`${base}arms/`}>See all the real files</a></figcaption>
            : <figcaption><b>รูปที่ 1</b> สิ่งที่ AI เห็นตอนเริ่มงานในการทดลองของเรา ความยาวแถบเทียบกับไฟล์เดียวทั้งไฟล์ (ตัวอักษร) แถบสีทึบคืออ่านทุกครั้ง แถบเส้นประคือเห็นทุกครั้งแต่สั้น แถบอ่อนคือเปิดเมื่องานเกี่ยว กฎทั้งสองแบบเหมือนกันทุกข้อ ต่างกันแค่วิธีส่ง <a href={`${base}arms/`}>ดูไฟล์จริงทั้งหมด</a></figcaption>}
        </figure>
      </section>

      <section id="timeline" class="col">
        <h2>{en ? 'Timeline' : 'เรียงตามเวลา'}</h2>
        <ol class="tl">
          {timeline.map(([when, what]) => <li><b>{when}</b><span>{what}</span></li>)}
        </ol>
      </section>

      {en ? (
        <section id="why" class="col">
          <h2>Why we measured this</h2>
          <p>Agent Skills rests on the belief that if unrelated rules do not get in the way, the AI will follow the relevant rules better. That sounds reasonable, but there is a risk on the other side: the AI may not open a skill it should open, and so never see an important rule.</p>
          <p>Studies published in early 2026 measured whether "having skills" beats "having no skills". As far as we could find, nobody had compared a single file directly with Skills while keeping every rule identical, and measured whether the AI really broke the rules based on what it did to the system. So we ran this experiment.</p>
          <p class="next"><a href={`${base}#answer`}>Go to the answer</a> <a href={`${base}arms/`}>See the rules each group got</a></p>
        </section>
      ) : (
        <section id="why" class="col">
          <h2>ทำไมเราถึงวัดเรื่องนี้</h2>
          <p>Agent Skills ตั้งอยู่บนความเชื่อว่า ถ้ากฎที่ไม่เกี่ยวไม่มากวน AI จะทำตามกฎที่เกี่ยวได้ดีขึ้น ฟังดูมีเหตุผล แต่ก็มีความเสี่ยงอีกด้าน คือ AI อาจไม่เปิด skill ที่ควรเปิด แล้วไม่เห็นกฎที่สำคัญเลย</p>
          <p>งานวิจัยที่ออกมาช่วงต้นปี 2026 วัดว่า "มี skill" ดีกว่า "ไม่มี skill" ไหม แต่เท่าที่เราค้น ยังไม่มีใครเทียบไฟล์เดียวกับ Skills ตรง ๆ โดยให้กฎเหมือนกันทุกข้อ และวัดว่า AI ทำผิดกฎจริงหรือเปล่าจากสิ่งที่มันทำกับระบบ เราเลยทำการทดลองนี้ขึ้นมา</p>
          <p class="next"><a href={`${base}#answer`}>ไปดูคำตอบ</a> <a href={`${base}arms/`}>ดูกฎที่แต่ละกลุ่มได้</a></p>
        </section>
      )}

      <section id="sources" class="col">
        <h2>{en ? 'Sources' : 'แหล่งที่มา'}</h2>
