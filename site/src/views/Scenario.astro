---
import Base from '../layouts/Base.astro';
import { scenarios, reqs, pct, pts, tie } from '../lib/data';
import { rootOf, famT, diffT, SEV, type Lang } from '../lib/i18n';
type Sc = (typeof scenarios)[number];
interface Props { lang: Lang; s: Sc; prev: Sc | null; next: Sc | null }
const { lang, s, prev, next } = Astro.props;
const en = lang === 'en';
const base = rootOf(lang);
const sev = SEV[lang];
const fam = famT(lang, s.family);
const cell = (x: any) => (!x || !x.app ? 'na' : x.ok === true ? 'ok' : x.ok === false ? 'no' : 'na');
const cellLabel: Record<string, string> = en ? { ok: 'Followed', no: 'Missed', na: 'Not relevant in this run' } : { ok: 'ทำตาม', no: 'พลาด', na: 'ไม่เกี่ยวกับครั้งนี้' };
// เกณฑ์ยอมรับยกมาจาก REQUIREMENTS.md ตัดเครื่องหมาย code และเขียนลูกศรเป็นคำ
const stripTicks = (t: string) => t.split(String.fromCharCode(96)).join('').replace(/\s*→\s*/g, ' ผลคือ ');
const sections = s.perStudy.slice().reverse();
const th = en ? 'th' : undefined;
---
<Base lang={lang} title={en ? `${s.code} ${fam.name} | SkillBench` : `${s.code} ${s.familyName} SkillBench`} current="scenarios/">
  <nav class="crumbs small"><a href={`${base}scenarios/`}>{en ? 'All tasks' : 'โจทย์ทั้งหมด'}</a> / <span class="mono">{s.id}</span></nav>
  <header class="title-block col">
    <h1 class="sc-h1">{en ? 'Task' : 'โจทย์'} {s.code} <span class="fam">{en ? `${fam.name} family` : `ตระกูล${s.familyName}`}</span></h1>
    <blockquote class="ask">
      <p lang="th">{s.prompt}</p>
      <footer class="who">{en ? `The user’s prompt, given to the AI in Thai. Difficulty: ${diffT(lang, s.difficulty)}` : `คำสั่งของผู้ใช้ โจทย์ระดับ${diffT(lang, s.difficulty)}`}</footer>
    </blockquote>
  </header>

  <div class="grid2">
    <section class="col">
      <h2 class="h-first">{en ? 'The trap in this task' : 'กับดักของโจทย์นี้'}</h2>
      <p class="lede">{fam.trap}</p>
      {s.note && <div class="aside"><b>{en ? 'Our note from designing this task (in Thai)' : 'โน้ตตอนเราออกแบบโจทย์นี้'}</b><span lang={th}>{s.note}</span></div>}
      <h3>{en ? 'Requirements this task refers to' : 'ข้อกำหนดที่โจทย์นี้อ้างถึง'}</h3>
      <dl class="reqs" lang={th}>
        {s.reqs.map((r: string) => (
          <><dt class="mono">{r}</dt><dd>{reqs[r]?.text ?? ''}{reqs[r]?.ac && <span class="ac small">{en ? 'Acceptance criterion' : 'เกณฑ์ยอมรับ'}: {stripTicks(reqs[r].ac)}</span>}</dd></>
        ))}
      </dl>
      <p class="small muted">{en ? <>From <code>REQUIREMENTS.md</code> of the simulated system, quoted in Thai. </> : <>จาก <code>REQUIREMENTS.md</code> ของระบบจำลอง </>}<a href={`${base}protocol/#requirements`}>{en ? 'See all requirements' : 'ดูข้อกำหนดทั้งหมด'}</a></p>
    </section>
    <aside class="side">
      <h3 class="h-first">{en ? 'Skills minus single file' : 'Skills ได้มากกว่าไฟล์เดียว'}</h3>
      <table class="bt">
        <thead><tr><th>{en ? 'Study' : 'รอบ'}</th><th class="r">{en ? 'Points' : 'จุด'}</th></tr></thead>
        <tbody>{s.perStudy.map(({ study, ps }) => <tr><td><a href={`#study-${study.n}`}>{en ? `Study ${study.n}` : `ชุดที่ ${study.n}`}</a> <span class="muted small">{study.metricName}</span></td><td class="r"><b>{tie(ps.diff) ? (en ? 'Tie' : 'เท่ากัน') : pts(ps.diff)}</b></td></tr>)}</tbody>
      </table>
      <h3>{en ? 'Skills that should be opened for this task' : 'skill ที่ควรถูกเปิดในโจทย์นี้'}</h3>
      <p class="mono small">{s.expectedSkills.length ? s.expectedSkills.join(', ') : (en ? 'None' : 'ไม่มี')}</p>
      {s.probes.length > 0 && <><h3>{en ? 'Commands used to measure before and after the AI works' : 'คำสั่งที่ใช้วัดก่อนและหลัง AI ทำงาน'}</h3>{s.probes.map((p: any) => <p class="mono small">{p.command}</p>)}</>}
      {s.verify && <><h3>{en ? 'Acceptance test the AI cannot see' : 'เทสยอมรับที่ AI มองไม่เห็น'}</h3><p class="mono small">{s.verify}</p></>}
    </aside>
  </div>

  {sections.map(({ study, ps }) => {
    const ruleList = ps.rules.length ? ps.rules : (ps.byArm[study.armIds[0]].runs[0]?.rules ?? []);
    const promptChanged = ps.prompt && ps.prompt !== s.prompt;
    return (
      <section class="wide study-sec" id={`study-${study.n}`}>
        <h2>{en ? `Results in Study ${study.n}` : `ผลในรอบที่ ${study.n}`}</h2>
        <p class="col">{en
          ? 'Each row is one rule and each column is one run. Green means followed, orange means missed, and a dashed box means the rule was not relevant in that run. Click a repetition number at the top to see what the AI did. The rule descriptions come from our checker and are in Thai.'
          : 'หนึ่งแถวคือกฎหนึ่งข้อ หนึ่งคอลัมน์คือการทำงานหนึ่งครั้ง เขียวคือทำตาม ส้มคือพลาด กรอบเส้นประคือครั้งนั้นกฎข้อนี้ไม่เกี่ยว กดเลขรอบด้านบนเพื่อดูว่า AI ทำอะไรไปบ้าง'}</p>
        {promptChanged && <p class="col small">{en ? 'This study used the prompt' : 'รอบนี้ใช้คำสั่ง'} <q lang="th">{ps.prompt}</q></p>}
        <div class="tbl-wrap">
          <table class="bt matrix">
            <thead>
              <tr><th rowspan="2">{en ? 'Rule' : 'กฎ'}</th><th rowspan="2">{en ? 'Level' : 'ระดับ'}</th>{study.armIds.map((a) => <th colspan={study.reps} class="armh"><span class={`arm arm-${a}`}>{a}</span></th>)}</tr>
              <tr>{study.armIds.map((a) => [...Array(study.reps).keys()].map((r) => <th class="rep"><a href={`${base}runs/?study=${study.n}#${s.id}__${a}__r${r}`} aria-label={en ? `Open run ${a} repetition ${r + 1}` : `เปิด run ${a} รอบ ${r + 1}`}>{r + 1}</a></th>))}</tr>
            </thead>
            <tbody>
              {ruleList.map((rule: any) => (
                <tr class={rule.sev === 'critical' ? '' : 'minor'}>
                  <td><span class="mono rid">{rule.id}</span> <span lang={th}>{rule.desc}</span></td>
                  <td class="small">{sev[rule.sev] ?? rule.sev}</td>
                  {study.armIds.map((a) => ps.byArm[a].runs.map((run) => {
                    const c = cell(run.rules.find((y) => y.id === rule.id));
                    return <td class="c"><a class={`m ${c}`} href={`${base}runs/?study=${study.n}#${run.id}`} tabindex="-1" title={`${run.id} ${cellLabel[c]}`}><span class="sr">{cellLabel[c]}</span></a></td>;
                  }))}
                </tr>
              ))}
              {study.n > 1 && <tr class="sum"><td colspan="2"><b>{en ? 'Task finished?' : 'งานเสร็จไหม'}</b></td>{study.armIds.map((a) => ps.byArm[a].runs.map((run) => <td class="c small">{run.done ? (en ? 'Yes' : 'ใช่') : <b class="qual">{en ? 'No' : 'ไม่'}</b>}</td>))}</tr>}
              <tr class="sum"><td colspan="2"><b>{en ? `Score of the run (${study.metricName})` : `คะแนนของครั้งนั้น (${study.metricName})`}</b></td>{study.armIds.map((a) => ps.byArm[a].runs.map((run) => <td class="c small">{run.score.toFixed(2)}</td>))}</tr>
              <tr class="sum"><td colspan="2"><b>{en ? 'Group average' : 'เฉลี่ยทั้งกลุ่ม'}</b></td>{study.armIds.map((a) => <td class="c small" colspan={study.reps}><b>{pct(ps.byArm[a].mean)}%</b></td>)}</tr>
            </tbody>
          </table>
        </div>
      </section>
    );
  })}

  <nav class="pn">
    {prev ? <a href={`${base}scenarios/${prev.id}/`}><span class="small muted">{en ? 'Previous' : 'ก่อนหน้า'}</span><b>{prev.code}</b>{famT(lang, prev.family).name}</a> : <span></span>}
    {next ? <a class="nx" href={`${base}scenarios/${next.id}/`}><span class="small muted">{en ? 'Next' : 'ถัดไป'}</span><b>{next.code}</b>{famT(lang, next.family).name}</a> : <span></span>}
  </nav>
</Base>
<style>
  .sc-h1 { font-size: clamp(1.6rem, 4vw, 2.2rem); margin: 0 0 1rem; }
  .sc-h1 .fam { font-family: var(--sans); font-weight: 400; font-size: 0.6em; color: var(--ink-3); margin-left: 0.4rem; }
  .crumbs { padding-top: 1.25rem; color: var(--ink-3); }
  .crumbs a { color: var(--ink-3); }
  .title-block { padding-top: 1.5rem; }
  .ask { margin: 0; padding: 0; }
  .ask p { font-family: var(--serif); font-size: clamp(1.4rem, 3vw, 2rem); line-height: 1.55; font-weight: 500; margin: 0; }
  .ask p::before { content: '“'; } .ask p::after { content: '”'; }
  .who { font-size: 0.95rem; color: var(--ink-3); margin-top: 0.75rem; }
  q { quotes: '“' '”'; }
  .h-first { margin-top: 0; }
  .grid2 { display: grid; gap: 2rem 4rem; grid-template-columns: minmax(0, 1fr); }
  .grid2 > * { min-width: 0; }
  @media (min-width: 980px) { .grid2 { grid-template-columns: minmax(0, 1fr) 20rem; } }
  .side { border-top: 2px solid var(--ink); padding-top: 1rem; align-self: start; }
  .side h3 { font-size: 1rem; margin-top: 1.5rem; }
  .side .bt td, .side .bt th { padding: 0.35rem 0.25rem; }
  .reqs dt { font-weight: 500; margin-top: 0.75rem; }
  .reqs dd { margin: 0.1rem 0 0; }
  .ac { display: block; color: var(--ink-3); }
  .study-sec { border-top: 3px solid var(--ink); margin-top: 4rem; }
  .study-sec h2 { margin-top: 1.25rem; }
  .matrix { font-size: 0.95rem; }
  .matrix th.armh { text-align: center; }
  .matrix th.rep { text-align: center; font-weight: 400; color: var(--ink-3); font-size: 0.8rem; border-top: 0; }
  .matrix td.c { text-align: center; padding: 0.4rem 0.2rem; min-width: 2rem; }
  .matrix tr.minor td:first-child { color: var(--ink-3); }
  .matrix tbody td:first-child { min-width: 11rem; }
  .matrix th.rep a { color: inherit; display: inline-block; min-width: 1.6rem; padding: 0.2rem 0; }
  .rid { color: var(--ink-3); margin-right: 0.35rem; }
  .m { display: inline-block; width: 1.15rem; height: 1.15rem; border-radius: 2px; vertical-align: middle; }
  .m.ok { background: var(--teal); } .m.no { background: var(--brick); } .m.na { border: 1px dashed var(--ink-3); }
  .m:hover { outline: 2px solid var(--ink); outline-offset: 1px; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  .sum td { background: var(--paper-2); }
  .pn { display: flex; justify-content: space-between; gap: 1rem; border-top: 1px solid var(--rule); margin-top: 4rem; padding-top: 1rem; }
  .pn a { display: flex; flex-direction: column; text-decoration: none; color: var(--ink); }
  .pn a b { font-family: var(--serif); }
  .pn .nx { text-align: right; }
</style>
