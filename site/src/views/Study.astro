  .pfloor { margin: 2rem 0; }
  .sq-row { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .sq { width: 3.2rem; height: 3.2rem; display: grid; place-items: center; text-decoration: none; font-size: 0.8rem; color: #fff; border-radius: 2px; }
  .sq.win { background: var(--a2); } .sq.loss { background: var(--a1); }
  .sq.tie { background: transparent; border: 1.5px dashed var(--ink-3); color: var(--ink-3); }
  .sq-key { display: flex; align-items: center; gap: 0.4rem 0.6rem; flex-wrap: wrap; color: var(--ink-2); margin-top: 0.75rem; }
  .sq-key .sq { width: 1rem; height: 1rem; display: inline-block; }
